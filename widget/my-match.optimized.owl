      let hProf = hPr == "haut" && hTe == "controle" ? "profil dominant : elle étouffe l'adversaire tout en le faisant reculer." : hPr == "haut" && hTe == "subit" ? "pressing stérile : beaucoup d'énergie pour peu de contrôle." : hPr == "haut" ? "pressing haut avec un territoire moyen : utile mais irrégulier." : hPr == "bas" && hTe == "controle" ? "contrôle sans pressing : elle attend puis conserve." : hPr == "bas" && hTe == "subit" ? "bloc attentiste : elle laisse le ballon et compte sur ses transitions." : hPr == "bas" ? "bloc médian : peu de risques et peu d'initiative." : hTe == "controle" ? "profil équilibré : elle choisit ses moments pour presser." : hTe == "subit" ? "pression sans territoire : elle court après le ballon." : "profil neutre, sans excès."
      let aProf = aPr == "haut" && aTe == "controle" ? "profil dominant : elle étouffe l'adversaire tout en le faisant reculer." : aPr == "haut" && aTe == "subit" ? "pressing stérile : beaucoup d'énergie pour peu de contrôle." : aPr == "haut" ? "pressing haut avec un territoire moyen : utile mais irrégulier." : aPr == "bas" && aTe == "controle" ? "contrôle sans pressing : elle attend puis conserve." : aPr == "bas" && aTe == "subit" ? "bloc attentiste : elle laisse le ballon et compte sur ses transitions." : aPr == "bas" ? "bloc médian : peu de risques et peu d'initiative." : aTe == "controle" ? "profil équilibré : elle choisit ses moments pour presser." : aTe == "subit" ? "pression sans territoire : elle court après le ballon." : "profil neutre, sans excès."
      let hEvo = abs((fdhA).style.ppda5 - (fdhA).style.ppda) >= 2 || abs((fdhA).style.share5 - (fdhA).style.share) >= 5 ? " Sur les 5 derniers, " + ((fdhA).style.ppda5 < (fdhA).style.ppda ? "elle presse plus haut" : (fdhA).style.ppda5 > (fdhA).style.ppda ? "elle presse plus bas" : "son pressing est stable") + " et " + ((fdhA).style.share5 > (fdhA).style.share ? "a gagné du territoire" : (fdhA).style.share5 < (fdhA).style.share ? "a perdu du territoire" : "garde le même territoire") + "." : ""
      let aEvo = abs((fdaA).style.ppda5 - (fdaA).style.ppda) >= 2 || abs((fdaA).style.share5 - (fdaA).style.share) >= 5 ? " Sur les 5 derniers, " + ((fdaA).style.ppda5 < (fdaA).style.ppda ? "elle presse plus haut" : (fdaA).style.ppda5 > (fdaA).style.ppda ? "elle presse plus bas" : "son pressing est stable") + " et " + ((fdaA).style.share5 > (fdaA).style.share ? "a gagné du territoire" : (fdaA).style.share5 < (fdaA).style.share ? "a perdu du territoire" : "garde le même territoire") + "." : ""
      let hStyleTxt = (fdhA).name + " presse " + (hPr == "haut" ? "haut" : hPr == "bas" ? "bas" : "à mi-hauteur") + " et " + (hTe == "controle" ? "garde le territoire" : hTe == "subit" ? "subit le territoire" : "a un territoire équilibré") + " : " + hProf + hEvo
      let aStyleTxt = (fdaA).name + " presse " + (aPr == "haut" ? "haut" : aPr == "bas" ? "bas" : "à mi-hauteur") + " et " + (aTe == "controle" ? "garde le territoire" : aTe == "subit" ? "subit le territoire" : "a un territoire équilibré") + " : " + aProf + aEvo
      let hStyleFacts = "PPDA " + replace(fixed((fdhA).style.ppda5, 1), ".", ",") + " · territoire " + replace(fixed((fdhA).style.share5, 0), ".", ",") + " %."
      let aStyleFacts = "PPDA " + replace(fixed((fdaA).style.ppda5, 1), ".", ",") + " · territoire " + replace(fixed((fdaA).style.share5, 0), ".", ",") + " %."
      let styleKey = hPr == "haut" && aTe == "subit" ? "Le pressing haut de " + (fdhA).name + " tombe sur une équipe qui subit déjà le territoire : s'il reste discipliné, il peut étouffer la relance de " + (fdaA).name + ". C'est une clé du match." : aPr == "haut" && hTe == "subit" ? "Le pressing haut de " + (fdaA).name + " tombe sur une équipe qui subit déjà le territoire : s'il reste discipliné, il peut étouffer la relance de " + (fdhA).name + ". C'est une clé du match." : hTe == "controle" && aPr == "bas" ? (fdaA).name + " laisse le ballon : " + (fdhA).name + " devra être patient et convertir sa possession. La clé est sa capacité à jouer un bloc bas." : aTe == "controle" && hPr == "bas" ? (fdhA).name + " laisse le ballon : " + (fdaA).name + " devra être patient et convertir sa possession. La clé est sa capacité à jouer un bloc bas." : hPr == "haut" && aTe == "controle" ? "Duel pressing contre contrôle : la sortie de balle de " + (fdaA).name + " est la clé. Si elle passe le premier rideau, " + (fdhA).name + " s'expose." : aPr == "haut" && hTe == "controle" ? "Duel pressing contre contrôle : la sortie de balle de " + (fdhA).name + " est la clé. Si elle passe le premier rideau, " + (fdaA).name + " s'expose." : hPr == "haut" && aPr == "haut" ? "Deux équipes qui pressent haut : le match se jouera sur les transitions et la qualité du premier contrôle." : hPr == "bas" && aPr == "bas" ? "Deux blocs bas : match fermé, les coups de pied arrêtés et la première erreur peuvent décider." : ""
      Row { gap: 8; align: center
        Row { gap: 5; align: center; weight: 1
          if (hLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (hLogo); size: 22; fit: contain; label: (fdhA).name } }
          else { Box { size: 10; radius: 5; background: (pmHColor) } }
          Text { text: (fdhA).name; style: small; bold: true; color: (pmHColor); weight: 1; maxLines: 1 }
        }
        Row { gap: 5; align: center; weight: 1
          Text { text: (fdaA).name; style: small; bold: true; color: (pmAColor); weight: 1; align: end; maxLines: 1 }
          if (aLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (aLogo); size: 22; fit: contain; label: (fdaA).name } }
          else { Box { size: 10; radius: 5; background: (pmAColor) } }
        }
      }
      Canvas {
        fill: width
        height: 340
        let padL = 42
        let padR = 12
        let padT = 28
        let padB = 40
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        rect(padL, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCGood, 0.06))
        rect(padL + cw / 2, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCCyan, 0.045))
        rect(padL, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCBad, 0.06))
        rect(padL + cw / 2, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCAmber, 0.04))
        for v in [5, 10, 15, 20, 25] {
          line(padL + (clamp(v, 5, 28) - 5) / 23 * cw, padT, padL + (clamp(v, 5, 28) - 5) / 23 * cw, padT + ch, stroke: alpha(muted, 0.20), width: 1)
          text("${v}", padL + (clamp(v, 5, 28) - 5) / 23 * cw, padT + ch + 14, size: 10, align: center, color: muted)
        }
        for v in [30, 45, 60, 75] {
          line(padL, padT + (85 - clamp(v, 20, 85)) / 65 * ch, padL + cw, padT + (85 - clamp(v, 20, 85)) / 65 * ch, stroke: alpha(muted, 0.20), width: 1)
          text("${v}%", padL - 6, padT + (85 - clamp(v, 20, 85)) / 65 * ch, size: 10, align: end, color: muted)
        }
        text("PRESSING + TERRITOIRE", padL + 8, padT + 16, size: 8, align: start, bold: true, color: pmCGood)
        text("CONTRÔLE", padL + cw - 8, padT + 16, size: 8, align: end, bold: true, color: pmCCyan)
        text("PRESSING STÉRILE", padL + 8, padT + ch - 6, size: 8, align: start, bold: true, color: pmCBad)
        text("BLOC BAS", padL + cw - 8, padT + ch - 6, size: 8, align: end, bold: true, color: pmCAmber)
        let hs = [(fdhA), (fdaA)]
        let cs = [(pmHColor), (pmAColor)]
        let ls = [(hLogo), (aLogo)]
        for i in range(2) {
          let an = hs[i]
          let col = cs[i]
          let lg = ls[i] ?? ""
          let st = an.style
          let sx = padL + (clamp(st.ppda, 5, 28) - 5) / 23 * cw
          let sy = padT + (85 - clamp(st.share, 20, 85)) / 65 * ch
          let lx = padL + (clamp(st.ppda5, 5, 28) - 5) / 23 * cw
          let ly = padT + (85 - clamp(st.share5, 20, 85)) / 65 * ch
          for k in range(8) {
            if k % 2 == 0 {
              line(sx + (lx - sx) * k / 8, sy + (ly - sy) * k / 8, sx + (lx - sx) * (k + 1) / 8, sy + (ly - sy) * (k + 1) / 8, stroke: alpha(col, 0.55), width: 1.4)
            }
          }
          circle(sx, sy, 5, stroke: col, width: 1.5)
          circle(lx, ly, 26, fill: alpha(col, 0.10))
          circle(lx, ly, 18, fill: alpha(background, 0.92))
          if lg != "" { image("~/.cache/espn-logos/banner/" + lg, lx - 12, ly - 12, 24, 24) }
          else { circle(lx, ly, 14, fill: alpha(col, 0.9)) text(an.abbr, lx, ly, size: 9, align: center, bold: true, color: foreground) }
          circle(lx, ly, 18, stroke: col, width: 2)
          text(an.abbr, lx, ly - 25, size: 11, align: center, bold: true, color: col)
          text("5 derniers", lx, ly + 28, size: 9, align: center, color: col)
          text(an.style.ppda5 <= 12 ? "presse haut" : an.style.ppda5 >= 17 ? "bloc bas" : "pressing moyen", lx, min(ly + 40, padT + ch - 12), size: 8, align: center, color: col)
          text(an.style.share5 >= 55 ? "contrôle" : an.style.share5 <= 45 ? "subit" : "équilibré", lx, min(ly + 50, padT + ch - 2), size: 8, align: center, color: col)
        }
        text("← PPDA bas = pressing fort", padL + cw / 2, height - 5, size: 10, align: center, bold: true, color: pmCAmber)
        text("↑ territoire (deep completions)", padL, padT - 10, size: 9, align: start, bold: true, color: pmCGood)
      }
      Text { text: "● 5 derniers · ○ saison"; style: label; color: muted; align: center; maxLines: 1 }
      Reading { pmVerdict: hStyleTxt; facts: hStyleFacts; c: (pmHColor); conf: "moyenne (plan de jeu)" }
      Reading { pmVerdict: aStyleTxt; facts: aStyleFacts; c: (pmAColor); conf: "moyenne (plan de jeu)" }
      KeyRead { key: styleKey; c: cTeal }
    }
  }

              }
              AmSectionTitle { t: "Table méritée · points vs attendus"; c: pmCAmber; sub: "les résultats réels comparés à ce que le jeu produit" }
              
  Column { gap: 4; padding: 10; radius: 14; background: linear(0, 0, 1, 1, [alpha((pmHColor), 0.14), alpha(background, 0.35), alpha((pmAColor), 0.14)]); border: 1; borderColor: alpha(foreground, 0.06)
    if (fdhA).deserved == null || (fdaA).deserved == null {
      Text { text: "Données de points attendus indisponibles pour ce match."; style: label; color: muted; maxLines: 2 }
    } else {
      let hGap = (fdhA).deserved.ppm - (fdhA).deserved.xppm
      let aGap = (fdaA).deserved.ppm - (fdaA).deserved.xppm
      let hGap5 = ((fdhA).deserved.ppm5 ?? 0) - ((fdhA).deserved.xppm5 ?? 0)
      let aGap5 = ((fdaA).deserved.ppm5 ?? 0) - ((fdaA).deserved.xppm5 ?? 0)
      let hTrend = hGap5 - hGap
      let aTrend = aGap5 - aGap
      let hVerdict = hGap >= 0.15 && hTrend > 0.1 ? (fdhA).name + " surperforme et l'écart se creuse : la réussite s'installe, mais elle repose sur un réalisme au-dessus de la durée." : hGap >= 0.15 && hTrend < -0.1 ? (fdhA).name + " surperforme, mais l'avance fond : les résultats reviennent vers le jeu." : hGap >= 0.15 ? (fdhA).name + " surperforme légèrement : les résultats dépassent le jeu, sans que l'écart soit encore inquiétant." : hGap <= -0.15 && hTrend > 0.1 ? (fdhA).name + " sous-performe mais revient : la correction est en cours, les résultats rattrapent le jeu." : hGap <= -0.15 && hTrend < -0.1 ? (fdhA).name + " sous-performe et l'écart se creuse : le jeu ne paie pas, et la tendance n'annonce pas de correction." : hGap <= -0.15 ? (fdhA).name + " sous-performe légèrement : les résultats sont en dessous du jeu produit." : (fdhA).name + " est fidèle à son attendu : les résultats suivent la performance."
      let aVerdict = aGap >= 0.15 && aTrend > 0.1 ? (fdaA).name + " surperforme et l'écart se creuse : la réussite s'installe, mais elle repose sur un réalisme au-dessus de la durée." : aGap >= 0.15 && aTrend < -0.1 ? (fdaA).name + " surperforme, mais l'avance fond : les résultats reviennent vers le jeu." : aGap >= 0.15 ? (fdaA).name + " surperforme légèrement : les résultats dépassent le jeu, sans que l'écart soit encore inquiétant." : aGap <= -0.15 && aTrend > 0.1 ? (fdaA).name + " sous-performe mais revient : la correction est en cours, les résultats rattrapent le jeu." : aGap <= -0.15 && aTrend < -0.1 ? (fdaA).name + " sous-performe et l'écart se creuse : le jeu ne paie pas, et la tendance n'annonce pas de correction." : aGap <= -0.15 ? (fdaA).name + " sous-performe légèrement : les résultats sont en dessous du jeu produit." : (fdaA).name + " est fidèle à son attendu : les résultats suivent la performance."
      let hFacts = "Saison " + (hGap > 0 ? "+" : "") + replace(fixed(hGap, 2), ".", ",") + " pt/match vs attendu · 5 derniers " + (hGap5 > 0 ? "+" : "") + replace(fixed(hGap5, 2), ".", ",") + "."
      let aFacts = "Saison " + (aGap > 0 ? "+" : "") + replace(fixed(aGap, 2), ".", ",") + " pt/match vs attendu · 5 derniers " + (aGap5 > 0 ? "+" : "") + replace(fixed(aGap5, 2), ".", ",") + "."
      let deskKey = hGap >= 0.15 && aGap <= -0.15 ? (fdhA).name + " vit sur son avance au score, " + (fdaA).name + " mérite mieux : si la réussite s'inverse, " + (fdaA).name + " est la clé du match." : aGap >= 0.15 && hGap <= -0.15 ? (fdaA).name + " vit sur son avance au score, " + (fdhA).name + " mérite mieux : si la réussite s'inverse, " + (fdhA).name + " est la clé du match." : hGap >= 0.15 && aGap >= 0.15 ? "Les deux équipes vivent au-dessus de leur jeu : la première qui retombe perd l'avantage. Le réalisme sera décisif." : hGap <= -0.15 && aGap <= -0.15 ? "Les deux équipes méritent mieux que leurs résultats : le match peut basculer sur la première qui concrétise." : hTrend > 0.15 && aTrend < -0.15 ? "La réussite de " + (fdhA).name + " monte quand celle de " + (fdaA).name + " baisse : la dynamique de réalisme est une clé du match." : aTrend > 0.15 && hTrend < -0.15 ? "La réussite de " + (fdaA).name + " monte quand celle de " + (fdhA).name + " baisse : la dynamique de réalisme est une clé du match." : ""
      Row { gap: 8; align: center
        Row { gap: 5; align: center; weight: 1
          if (hLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (hLogo); size: 22; fit: contain; label: (fdhA).name } }
          else { Box { size: 10; radius: 5; background: (pmHColor) } }
          Text { text: (fdhA).name; style: small; bold: true; color: (pmHColor); weight: 1; maxLines: 1 }
        }
        Row { gap: 5; align: center; weight: 1
          Text { text: (fdaA).name; style: small; bold: true; color: (pmAColor); weight: 1; align: end; maxLines: 1 }
          if (aLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (aLogo); size: 22; fit: contain; label: (fdaA).name } }
          else { Box { size: 10; radius: 5; background: (pmAColor) } }
        }
      }
      Canvas {
        fill: width
        height: 320
        let padL = 42
        let padR = 12
        let padT = 28
        let padB = 40
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        path([[padL, padT], [padL + cw, padT], [padL, padT + ch]], closed: true, fill: alpha(pmCGood, 0.08))
        path([[padL, padT + ch], [padL + cw, padT + ch], [padL + cw, padT]], closed: true, fill: alpha(pmCBad, 0.08))
        for v in [0, 1, 2, 3] {
          line(padL + clamp(v, 0, 3) / 3 * cw, padT, padL + clamp(v, 0, 3) / 3 * cw, padT + ch, stroke: alpha(muted, 0.20), width: 1)
          text("${v}", padL + clamp(v, 0, 3) / 3 * cw, padT + ch + 14, size: 10, align: center, color: muted)
          line(padL, padT + (3 - clamp(v, 0, 3)) / 3 * ch, padL + cw, padT + (3 - clamp(v, 0, 3)) / 3 * ch, stroke: alpha(muted, 0.20), width: 1)
          text("${v}", padL - 6, padT + (3 - clamp(v, 0, 3)) / 3 * ch, size: 10, align: end, color: muted)
        }
        line(padL, padT + ch, padL + cw, padT, stroke: alpha(pmCCyan, 0.55), width: 1.6)
        text("résultats = performance", padL + cw - 4, padT + 14, size: 9, align: end, bold: true, color: alpha(pmCCyan, 0.85))
        text("AU-DESSUS = RÉSULTATS > JEU", padL + 6, padT + 14, size: 8, align: start, bold: true, color: pmCGood)
        text("EN DESSOUS = RÉSULTATS < JEU", padL + 6, padT + ch - 6, size: 8, align: start, bold: true, color: pmCBad)
        let hs = [(fdhA), (fdaA)]
        let cs = [(pmHColor), (pmAColor)]
        let ls = [(hLogo), (aLogo)]
        for i in range(2) {
          let an = hs[i]
          let col = cs[i]
          let lg = ls[i] ?? ""
          let d = an.deserved
          let gap = d.ppm - d.xppm
          let sx = padL + clamp(d.xppm, 0, 3) / 3 * cw
          let sy = padT + (3 - clamp(d.ppm, 0, 3)) / 3 * ch
          let lx = padL + clamp(d.xppm5, 0, 3) / 3 * cw
          let ly = padT + (3 - clamp(d.ppm5, 0, 3)) / 3 * ch
          for k in range(8) {
            if k % 2 == 0 {
              line(sx + (lx - sx) * k / 8, sy + (ly - sy) * k / 8, sx + (lx - sx) * (k + 1) / 8, sy + (ly - sy) * (k + 1) / 8, stroke: alpha(col, 0.55), width: 1.4)
            }
          }
          circle(sx, sy, 26, fill: alpha(col, 0.10))
          circle(sx, sy, 18, fill: alpha(background, 0.92))
          if lg != "" { image("~/.cache/espn-logos/banner/" + lg, sx - 12, sy - 12, 24, 24) }
          else { circle(sx, sy, 14, fill: alpha(col, 0.9)) text(an.abbr, sx, sy, size: 9, align: center, bold: true, color: foreground) }
          circle(sx, sy, 18, stroke: col, width: 2)
          text(an.abbr + " " + (gap > 0 ? "+" : "") + replace(fixed(gap, 2), ".", ","), sx, sy - 27, size: 10, align: center, bold: true, color: gap >= 0 ? pmCGood : pmCBad)
          circle(lx, ly, 6, stroke: col, width: 1.6)
        }
        text("xPts / match →  performance attendue", padL + cw / 2, height - 5, size: 10, align: center, bold: true, color: pmCCyan)
        text("↑ points / match", padL, padT - 10, size: 9, align: start, bold: true, color: pmCGood)
      }
      Text { text: "● saison (logo) · ○ 5 derniers · diagonale = résultats = performance"; style: label; color: muted; align: center; maxLines: 2 }
      Reading { pmVerdict: hVerdict; facts: hFacts; c: (pmHColor); conf: "moyenne (saison + 5 matchs)" }
      Reading { pmVerdict: aVerdict; facts: aFacts; c: (pmAColor); conf: "moyenne (saison + 5 matchs)" }
      KeyRead { key: deskKey; c: pmCAmber }
    }
  }

            }
          }
          if anView == "chances" {
            Column { gap: 10
              AmSectionTitle { t: "Profil de chances"; c: pmCViolet; sub: "volume × qualité × finition · combien de tirs, de quelle qualité, avec quelle réussite" }
              
  Column { gap: 4; padding: 10; radius: 14; background: linear(0, 0, 1, 1, [alpha((pmHColor), 0.14), alpha(background, 0.35), alpha((pmAColor), 0.14)]); border: 1; borderColor: alpha(foreground, 0.06)
    if (fdhA).shots == null || (fdaA).shots == null {
      Text { text: "Données de tirs indisponibles pour ce match."; style: label; color: muted; maxLines: 2 }
    } else {
      let hVol = (fdhA).shots >= 12 ? "haut" : (fdhA).shots <= 9 ? "bas" : "moyen"
      let hQual = (fdhA).xps >= 0.11 ? "haute" : (fdhA).xps <= 0.09 ? "faible" : "moyenne"
      let hFin = (fdhA).fin >= 1.5 ? "clinical" : (fdhA).fin <= -1.5 ? "wasteful" : "neutre"
      let aVol = (fdaA).shots >= 12 ? "haut" : (fdaA).shots <= 9 ? "bas" : "moyen"
      let aQual = (fdaA).xps >= 0.11 ? "haute" : (fdaA).xps <= 0.09 ? "faible" : "moyenne"
      let aFin = (fdaA).fin >= 1.5 ? "clinical" : (fdaA).fin <= -1.5 ? "wasteful" : "neutre"
      let hProf = hVol == "haut" && hQual == "haute" ? "beaucoup d'occasions et de bonnes occasions." : hVol == "haut" && hQual == "moyenne" ? "elle crée souvent, sans toujours se mettre en position idéale." : hVol == "haut" && hQual == "faible" ? "volume stérile, peu d'occasions franches." : hVol == "moyen" && hQual == "haute" ? "efficace, elle a besoin de peu pour se créer une occasion nette." : hVol == "moyen" && hQual == "moyenne" ? "profil moyen sur le volume et la qualité." : hVol == "moyen" && hQual == "faible" ? "volume correct mais tirs de faible qualité : elle gâche son volume." : hVol == "bas" && hQual == "haute" ? "profil chirurgical, dépendant de la finition." : hVol == "bas" && hQual == "moyenne" ? "l'attaque manque de volume." : "attaque en panne, les occasions franches sont rares."
      let aProf = aVol == "haut" && aQual == "haute" ? "beaucoup d'occasions et de bonnes occasions." : aVol == "haut" && aQual == "moyenne" ? "elle crée souvent, sans toujours se mettre en position idéale." : aVol == "haut" && aQual == "faible" ? "volume stérile, peu d'occasions franches." : aVol == "moyen" && aQual == "haute" ? "efficace, elle a besoin de peu pour se créer une occasion nette." : aVol == "moyen" && aQual == "moyenne" ? "profil moyen sur le volume et la qualité." : aVol == "moyen" && aQual == "faible" ? "volume correct mais tirs de faible qualité : elle gâche son volume." : aVol == "bas" && aQual == "haute" ? "profil chirurgical, dépendant de la finition." : aVol == "bas" && aQual == "moyenne" ? "l'attaque manque de volume." : "attaque en panne, les occasions franches sont rares."
      let hFinTxt = hFin == "clinical" ? " La finition est au-dessus de l'attendu : l'efficacité amplifie le profil." : hFin == "wasteful" ? " La finition est en dessous : le volume ou la qualité ne sont pas convertis." : " La finition est neutre : le profil est cohérent avec les occasions créées."
      let aFinTxt = aFin == "clinical" ? " La finition est au-dessus de l'attendu : l'efficacité amplifie le profil." : aFin == "wasteful" ? " La finition est en dessous : le volume ou la qualité ne sont pas convertis." : " La finition est neutre : le profil est cohérent avec les occasions créées."
      let hFin5 = (fdhA).fin5 ?? 0
      let aFin5 = (fdaA).fin5 ?? 0
      let hSh5 = (fdhA).shots5 ?? (fdhA).shots
      let aSh5 = (fdaA).shots5 ?? (fdaA).shots
      let hXp5 = (fdhA).xps5 ?? (fdhA).xps
      let aXp5 = (fdaA).xps5 ?? (fdaA).xps
      let hVol5 = hSh5 >= 12 ? "haut" : hSh5 <= 9 ? "bas" : "moyen"
      let aVol5 = aSh5 >= 12 ? "haut" : aSh5 <= 9 ? "bas" : "moyen"
      let hQual5 = hXp5 >= 0.11 ? "haute" : hXp5 <= 0.09 ? "faible" : "moyenne"
      let aQual5 = aXp5 >= 0.11 ? "haute" : aXp5 <= 0.09 ? "faible" : "moyenne"
      let hProf5 = hVol5 == "haut" && hQual5 == "haute" ? "beaucoup d'occasions et de bonnes occasions." : hVol5 == "haut" && hQual5 == "moyenne" ? "elle crée souvent, sans toujours se mettre en position idéale." : hVol5 == "haut" && hQual5 == "faible" ? "volume stérile, peu d'occasions franches." : hVol5 == "moyen" && hQual5 == "haute" ? "efficace, elle a besoin de peu pour se créer une occasion nette." : hVol5 == "moyen" && hQual5 == "moyenne" ? "profil moyen sur le volume et la qualité." : hVol5 == "moyen" && hQual5 == "faible" ? "volume correct mais tirs de faible qualité : elle gâche son volume." : hVol5 == "bas" && hQual5 == "haute" ? "profil chirurgical, dépendant de la finition." : hVol5 == "bas" && hQual5 == "moyenne" ? "l'attaque manque de volume." : "attaque en panne, les occasions franches sont rares."
      let aProf5 = aVol5 == "haut" && aQual5 == "haute" ? "beaucoup d'occasions et de bonnes occasions." : aVol5 == "haut" && aQual5 == "moyenne" ? "elle crée souvent, sans toujours se mettre en position idéale." : aVol5 == "haut" && aQual5 == "faible" ? "volume stérile, peu d'occasions franches." : aVol5 == "moyen" && aQual5 == "haute" ? "efficace, elle a besoin de peu pour se créer une occasion nette." : aVol5 == "moyen" && aQual5 == "moyenne" ? "profil moyen sur le volume et la qualité." : aVol5 == "moyen" && aQual5 == "faible" ? "volume correct mais tirs de faible qualité : elle gâche son volume." : aVol5 == "bas" && aQual5 == "haute" ? "profil chirurgical, dépendant de la finition." : aVol5 == "bas" && aQual5 == "moyenne" ? "l'attaque manque de volume." : "attaque en panne, les occasions franches sont rares."
      let hFin5c = hFin5 >= 1 ? "clinical" : hFin5 <= -1 ? "wasteful" : "neutre"
      let aFin5c = aFin5 >= 1 ? "clinical" : aFin5 <= -1 ? "wasteful" : "neutre"
      let hFin5Lbl = hFin5 >= 0.5 ? "positive" : hFin5 <= -0.5 ? "négative" : "neutre"
      let aFin5Lbl = aFin5 >= 0.5 ? "positive" : aFin5 <= -0.5 ? "négative" : "neutre"
      let hVolMove = hSh5 - (fdhA).shots >= 1.5 ? "monte" : hSh5 - (fdhA).shots <= -1.5 ? "baisse" : "reste stable"
      let aVolMove = aSh5 - (fdaA).shots >= 1.5 ? "monte" : aSh5 - (fdaA).shots <= -1.5 ? "baisse" : "reste stable"
      let hQualMove = hXp5 - (fdhA).xps >= 0.011 ? "monte" : hXp5 - (fdhA).xps <= -0.011 ? "baisse" : "reste stable"
      let aQualMove = aXp5 - (fdaA).xps >= 0.011 ? "monte" : aXp5 - (fdaA).xps <= -0.011 ? "baisse" : "reste stable"
      let hSame = hVol == hVol5 && hQual == hQual5
      let aSame = aVol == aVol5 && aQual == aQual5
      let hNoMove = abs(hSh5 - (fdhA).shots) < 1.5 && abs(hXp5 - (fdhA).xps) <= 0.011
      let aNoMove = abs(aSh5 - (fdaA).shots) < 1.5 && abs(aXp5 - (fdaA).xps) <= 0.011
      let hRecentTxt = hNoMove ? " Les 5 derniers confirment ce profil (" + replace(fixed(hSh5, 1), ".", ",") + " tirs/match, " + replace(fixed(hXp5, 3), ".", ",") + " xG/tir), finition " + hFin5Lbl + " (" + (hFin5 > 0 ? "+" : "") + replace(fixed(hFin5, 2), ".", ",") + " buts vs xG)." : hSame ? " Sur les 5 derniers, le profil se déplace : volume " + hVolMove + " (" + replace(fixed(hSh5, 1), ".", ",") + " tirs/match) et qualité " + hQualMove + " (" + replace(fixed(hXp5, 3), ".", ",") + " xG/tir) ; finition " + hFin5Lbl + " (" + (hFin5 > 0 ? "+" : "") + replace(fixed(hFin5, 2), ".", ",") + " buts vs xG)." : " Sur les 5 derniers, le profil change : " + hProf5 + " (" + replace(fixed(hSh5, 1), ".", ",") + " tirs/match, " + replace(fixed(hXp5, 3), ".", ",") + " xG/tir) ; finition " + hFin5Lbl + " (" + (hFin5 > 0 ? "+" : "") + replace(fixed(hFin5, 2), ".", ",") + " buts vs xG)."
      let aRecentTxt = aNoMove ? " Les 5 derniers confirment ce profil (" + replace(fixed(aSh5, 1), ".", ",") + " tirs/match, " + replace(fixed(aXp5, 3), ".", ",") + " xG/tir), finition " + aFin5Lbl + " (" + (aFin5 > 0 ? "+" : "") + replace(fixed(aFin5, 2), ".", ",") + " buts vs xG)." : aSame ? " Sur les 5 derniers, le profil se déplace : volume " + aVolMove + " (" + replace(fixed(aSh5, 1), ".", ",") + " tirs/match) et qualité " + aQualMove + " (" + replace(fixed(aXp5, 3), ".", ",") + " xG/tir) ; finition " + aFin5Lbl + " (" + (aFin5 > 0 ? "+" : "") + replace(fixed(aFin5, 2), ".", ",") + " buts vs xG)." : " Sur les 5 derniers, le profil change : " + aProf5 + " (" + replace(fixed(aSh5, 1), ".", ",") + " tirs/match, " + replace(fixed(aXp5, 3), ".", ",") + " xG/tir) ; finition " + aFin5Lbl + " (" + (aFin5 > 0 ? "+" : "") + replace(fixed(aFin5, 2), ".", ",") + " buts vs xG)."
      let hChanceTxt = (fdhA).name + " : " + hProf + hFinTxt + hRecentTxt
      let aChanceTxt = (fdaA).name + " : " + aProf + aFinTxt + aRecentTxt
      let hChanceFacts = "Saison : " + replace(fixed((fdhA).shots, 1), ".", ",") + " tirs/match · " + replace(fixed((fdhA).xps, 3), ".", ",") + " xG/tir · " + ((fdhA).fin > 0 ? "+" : "") + replace(fixed((fdhA).fin, 2), ".", ",") + " vs xG — 5 derniers : " + replace(fixed(hSh5, 1), ".", ",") + " tirs/match · " + replace(fixed(hXp5, 3), ".", ",") + " xG/tir · " + (hFin5 > 0 ? "+" : "") + replace(fixed(hFin5, 2), ".", ",") + " vs xG."
      let aChanceFacts = "Saison : " + replace(fixed((fdaA).shots, 1), ".", ",") + " tirs/match · " + replace(fixed((fdaA).xps, 3), ".", ",") + " xG/tir · " + ((fdaA).fin > 0 ? "+" : "") + replace(fixed((fdaA).fin, 2), ".", ",") + " vs xG — 5 derniers : " + replace(fixed(aSh5, 1), ".", ",") + " tirs/match · " + replace(fixed(aXp5, 3), ".", ",") + " xG/tir · " + (aFin5 > 0 ? "+" : "") + replace(fixed(aFin5, 2), ".", ",") + " vs xG."
      let chanceKey = hFin5c == "clinical" && aFin5c == "wasteful" ? "La finition récente de " + (fdhA).name + " (" + (hFin5 > 0 ? "+" : "") + replace(fixed(hFin5, 2), ".", ",") + " buts vs xG sur 5 matchs) contraste avec celle de " + (fdaA).name + " (" + (aFin5 > 0 ? "+" : "") + replace(fixed(aFin5, 2), ".", ",") + ") : si elle tient, c'est la clé." : aFin5c == "clinical" && hFin5c == "wasteful" ? "La finition récente de " + (fdaA).name + " (" + (aFin5 > 0 ? "+" : "") + replace(fixed(aFin5, 2), ".", ",") + " buts vs xG sur 5 matchs) contraste avec celle de " + (fdhA).name + " (" + (hFin5 > 0 ? "+" : "") + replace(fixed(hFin5, 2), ".", ",") + ") : si elle tient, c'est la clé." : hFin5c == "clinical" && hFin == "wasteful" ? "Le regain de finition de " + (fdhA).name + " sur les 5 derniers (" + (hFin5 > 0 ? "+" : "") + replace(fixed(hFin5, 2), ".", ",") + " buts vs xG) corrige une saison en dessous (" + ((fdhA).fin > 0 ? "+" : "") + replace(fixed((fdhA).fin, 2), ".", ",") + ") : s'il tient, c'est la clé." : aFin5c == "clinical" && aFin == "wasteful" ? "Le regain de finition de " + (fdaA).name + " sur les 5 derniers (" + (aFin5 > 0 ? "+" : "") + replace(fixed(aFin5, 2), ".", ",") + " buts vs xG) corrige une saison en dessous (" + ((fdaA).fin > 0 ? "+" : "") + replace(fixed((fdaA).fin, 2), ".", ",") + ") : s'il tient, c'est la clé." : hFin == "clinical" && aFin == "wasteful" ? "L'efficacité de " + (fdhA).name + " contre le gaspillage de " + (fdaA).name + " peut faire la différence : à volume comparable, " + (fdhA).name + " convertit ce que " + (fdaA).name + " laisse passer." : aFin == "clinical" && hFin == "wasteful" ? "L'efficacité de " + (fdaA).name + " contre le gaspillage de " + (fdhA).name + " peut faire la différence : à volume comparable, " + (fdaA).name + " convertit ce que " + (fdhA).name + " laisse passer." : hVol == "haut" && aVol == "bas" ? (fdhA).name + " devrait avoir le volume et les occasions ; " + (fdaA).name + " devra être chirurgical sur ses rares chances. La clé est l'efficacité de " + (fdaA).name + "." : aVol == "haut" && hVol == "bas" ? (fdaA).name + " devrait avoir le volume et les occasions ; " + (fdhA).name + " devra être chirurgical sur ses rares chances. La clé est l'efficacité de " + (fdhA).name + "." : hFin == "wasteful" && aFin == "wasteful" ? "Les deux équipes gaspillent : le match peut se jouer sur un détail, une occasion convertie ou un gardien décisif." : hQual == "haute" && aQual == "faible" ? "La qualité des occasions de " + (fdhA).name + " contraste avec la faiblesse des tirs de " + (fdaA).name + " : si " + (fdhA).name + " convertit, l'écart se creuse." : aQual == "haute" && hQual == "faible" ? "La qualité des occasions de " + (fdaA).name + " contraste avec la faiblesse des tirs de " + (fdhA).name + " : si " + (fdaA).name + " convertit, l'écart se creuse." : ""
      Row { gap: 8; align: center
        Row { gap: 5; align: center; weight: 1
          if (hLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (hLogo); size: 22; fit: contain; label: (fdhA).name } }
          else { Box { size: 10; radius: 5; background: (pmHColor) } }
          Text { text: (fdhA).name; style: small; bold: true; color: (pmHColor); weight: 1; maxLines: 1 }
        }
        Row { gap: 5; align: center; weight: 1
          Text { text: (fdaA).name; style: small; bold: true; color: (pmAColor); weight: 1; align: end; maxLines: 1 }
          if (aLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (aLogo); size: 22; fit: contain; label: (fdaA).name } }
          else { Box { size: 10; radius: 5; background: (pmAColor) } }
        }
      }
      Canvas {
        fill: width
        height: 300
        let padL = 42
        let padR = 12
        let padT = 26
        let padB = 36
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        rect(padL, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCGood, 0.055))
        rect(padL + cw / 2, padT, cw / 2, ch / 2, radius: 2, fill: alpha(cTeal, 0.055))
        rect(padL, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCBad, 0.055))
        rect(padL + cw / 2, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCAmber, 0.04))
        for v in [8, 12, 16, 20, 24] {
          line(padL + (clamp(v, 6, 24) - 6) / 18 * cw, padT, padL + (clamp(v, 6, 24) - 6) / 18 * cw, padT + ch, stroke: alpha(muted, 0.20), width: 1)
          text("${v}", padL + (clamp(v, 6, 24) - 6) / 18 * cw, padT + ch + 14, size: 10, align: center, color: muted)
        }
        for v in [0.06, 0.09, 0.12, 0.15, 0.18] {
          line(padL, padT + (0.18 - clamp(v, 0.05, 0.18)) / 0.13 * ch, padL + cw, padT + (0.18 - clamp(v, 0.05, 0.18)) / 0.13 * ch, stroke: alpha(muted, 0.20), width: 1)
          text(replace(fixed(v, 2), ".", ","), padL - 6, padT + (0.18 - clamp(v, 0.05, 0.18)) / 0.13 * ch, size: 10, align: end, color: muted)
        }
        text("PEU DE VOLUME · HAUTE QUALITÉ", padL + 8, padT + 14, size: 8, align: start, bold: true, color: pmCGood)
        text("BEAUCOUP · HAUTE QUALITÉ", padL + cw - 8, padT + 14, size: 8, align: end, bold: true, color: cTeal)
        text("PEU · FAIBLE QUALITÉ", padL + 8, padT + ch - 6, size: 8, align: start, bold: true, color: pmCBad)
        text("BEAUCOUP · FAIBLE QUALITÉ", padL + cw - 8, padT + ch - 6, size: 8, align: end, bold: true, color: pmCAmber)
        let hs = [(fdhA), (fdaA)]
        let cs = [(pmHColor), (pmAColor)]
        for i in range(2) {
          let an = hs[i]
          let col = cs[i]
          let sx = padL + (clamp(an.shots, 6, 24) - 6) / 18 * cw
          let sy = padT + (0.18 - clamp(an.xps, 0.05, 0.18)) / 0.13 * ch
          let lx = padL + (clamp(an.shots5, 6, 24) - 6) / 18 * cw
          let ly = padT + (0.18 - clamp(an.xps5, 0.05, 0.18)) / 0.13 * ch
          for k in range(8) {
            if k % 2 == 0 {
              line(sx + (lx - sx) * k / 8, sy + (ly - sy) * k / 8, sx + (lx - sx) * (k + 1) / 8, sy + (ly - sy) * (k + 1) / 8, stroke: alpha(col, 0.55), width: 1.4)
            }
          }
          let r = 9 + min(abs(an.fin), 5) * 1.4
          let lg = i == 0 ? (hLogo) : (aLogo)
          circle(sx, sy, r + 9, fill: alpha(an.fin >= 0 ? pmCGood : pmCBad, 0.10))
          circle(sx, sy, r, fill: alpha(background, 0.92), stroke: an.fin >= 0 ? pmCGood : pmCBad, width: 2.4)
          if lg != "" { image("~/.cache/espn-logos/banner/" + lg, sx - 8, sy - 8, 16, 16) }
          else { circle(sx, sy, r - 3, fill: alpha(col, 0.85)) }
          circle(lx, ly, 5, stroke: col, width: 1.5)
          text(an.abbr, sx, sy - r - 8, size: 10, align: center, bold: true, color: col)
          text("5 derniers", lx + (lx > sx ? 10 : -10), ly + 4, size: 9, align: lx > sx ? "start" : "end", color: col)
          text((an.fin > 0 ? "+" : "") + replace(fixed(an.fin, 2), ".", ","), sx + (lx > sx ? -12 : 12), sy + 4, size: 10, align: lx > sx ? "end" : "start", bold: true, color: an.fin >= 0 ? pmCGood : pmCBad)
        }
        text("Tirs par match →", padL + cw / 2, height - 5, size: 10, align: center, bold: true, color: pmCCyan)
        text("↑ qualité (xG/tir)", padL, padT - 10, size: 9, align: start, bold: true, color: pmCAmber)
      }
      Text { text: "Gros point = saison · cercle = 5 derniers · taille = |buts − xG| · contour vert/rouge = finition"; style: label; color: muted; align: center; maxLines: 2 }
      Reading { pmVerdict: hChanceTxt; facts: hChanceFacts; c: (pmHColor); conf: "moyenne (saison + 5 derniers)" }
      Reading { pmVerdict: aChanceTxt; facts: aChanceFacts; c: (pmAColor); conf: "moyenne (saison + 5 derniers)" }
      KeyRead { key: chanceKey; c: pmCViolet }
    }
  }

              if count(get((fa.players ?? {}), fdhAbbr, [])) > 0 || count(get((fa.players ?? {}), fdaAbbr, [])) > 0 {
                Section { c: pmCPink; t: "Créateurs"; sub: "qui construit, qui finit · position des joueurs clés" }
                
  Column { gap: 4; padding: 10; radius: 14; background: linear(0, 0, 1, 1, [alpha((pmHColor), 0.14), alpha(background, 0.35), alpha((pmAColor), 0.14)]); border: 1; borderColor: alpha(foreground, 0.06)
    if count((get((fa.players ?? {}), fdhAbbr, []))) == 0 && count((get((fa.players ?? {}), fdaAbbr, []))) == 0 {
      Text { text: "Données joueurs indisponibles (source Understat)."; style: label; color: muted; maxLines: 2 }
    } else {
      let hp = count((get((fa.players ?? {}), fdhAbbr, []))) > 0 ? first((get((fa.players ?? {}), fdhAbbr, []))) : null
      let ap = count((get((fa.players ?? {}), fdaAbbr, []))) > 0 ? first((get((fa.players ?? {}), fdaAbbr, []))) : null
      let hGini = (get((fa.playersMeta ?? {}), fdhAbbr, null)) == null ? 0 : ((get((fa.playersMeta ?? {}), fdhAbbr, null)).gini ?? 0)
      let aGini = (get((fa.playersMeta ?? {}), fdaAbbr, null)) == null ? 0 : ((get((fa.playersMeta ?? {}), fdaAbbr, null)).gini ?? 0)
      let hDep = hGini >= 0.45 ? "forte" : hGini >= 0.30 ? "modérée" : "partagée"
      let aDep = aGini >= 0.45 ? "forte" : aGini >= 0.30 ? "modérée" : "partagée"
      let hRole = hp == null ? "" : ((hp.xgb ?? 0) >= 0.35 && (hp.xgc ?? 0) >= 0.65 ? "tout-terrain : construit et finit" : (hp.xgb ?? 0) >= 0.35 ? "créateur profond : construit loin du but" : (hp.xgc ?? 0) >= 0.65 ? "finisseur : vit dans la surface et finit les actions" : "rôle mixte, sans domination nette")
      let aRole = ap == null ? "" : ((ap.xgb ?? 0) >= 0.35 && (ap.xgc ?? 0) >= 0.65 ? "tout-terrain : construit et finit" : (ap.xgb ?? 0) >= 0.35 ? "créateur profond : construit loin du but" : (ap.xgc ?? 0) >= 0.65 ? "finisseur : vit dans la surface et finit les actions" : "rôle mixte, sans domination nette")
      let hDepTxt = hDep == "forte" ? " Couper " + (hp.n ?? "") + ", c'est couper une grande partie du jeu : c'est une cible évidente." : hDep == "modérée" ? " La dépendance reste contenue, mais " + (hp.n ?? "") + " est le fil principal à surveiller." : " La création est répartie : il n'y a pas un joueur unique à couper."
      let aDepTxt = aDep == "forte" ? " Couper " + (ap.n ?? "") + ", c'est couper une grande partie du jeu : c'est une cible évidente." : aDep == "modérée" ? " La dépendance reste contenue, mais " + (ap.n ?? "") + " est le fil principal à surveiller." : " La création est répartie : il n'y a pas un joueur unique à couper."
      let hCreatorTxt = hp == null ? (fdhA).name + " : aucun créateur identifié dans les données." : (fdhA).name + " s'appuie sur " + hp.n + " (dépendance " + hDep + ") : " + hRole + "." + hDepTxt
      let aCreatorTxt = ap == null ? (fdaA).name + " : aucun créateur identifié dans les données." : (fdaA).name + " s'appuie sur " + ap.n + " (dépendance " + aDep + ") : " + aRole + "." + aDepTxt
      let hCreatorFacts = hp == null ? "" : (hp.n + " · " + replace(fixed(hp.xgb ?? 0, 2), ".", ",") + " xGB · " + replace(fixed(hp.xgc ?? 0, 2), ".", ",") + " xGC/90 · " + replace(fixed(hGini, 2), ".", ",") + " de dépendance.")
      let aCreatorFacts = ap == null ? "" : (ap.n + " · " + replace(fixed(ap.xgb ?? 0, 2), ".", ",") + " xGB · " + replace(fixed(ap.xgc ?? 0, 2), ".", ",") + " xGC/90 · " + replace(fixed(aGini, 2), ".", ",") + " de dépendance.")
      let creatorKey = hp == null || ap == null ? "" : hDep == "forte" && aDep == "forte" ? "Les deux équipes dépendent fortement de leur maître à jouer : le duel des milieux et la capacité à isoler " + hp.n + " ou " + ap.n + " seront décisifs." : hDep == "forte" ? (fdaA).name + " peut cibler " + hp.n + " : si elle l'isole, " + (fdhA).name + " perd son fil créatif. C'est une clé du match, à croiser avec le pressing de " + (fdaA).name + "." : aDep == "forte" ? (fdhA).name + " peut cibler " + ap.n + " : si elle l'isole, " + (fdaA).name + " perd son fil créatif. C'est une clé du match, à croiser avec le pressing de " + (fdhA).name + "." : contains(hRole, "profond") && contains(aRole, "finisseur") ? "Opposition de construction et de finition : si " + hp.n + " trouve " + ap.n + ", " + (fdaA).name + " peut toucher. La clé est la capacité de " + (fdhA).name + " à couper cette liaison." : contains(aRole, "profond") && contains(hRole, "finisseur") ? "Opposition de construction et de finition : si " + ap.n + " trouve " + hp.n + ", " + (fdhA).name + " peut toucher. La clé est la capacité de " + (fdaA).name + " à couper cette liaison." : ""
      Row { gap: 8; align: center
        Row { gap: 5; align: center; weight: 1
          if (hLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (hLogo); size: 22; fit: contain; label: (fdhA).name } }
          else { Box { size: 10; radius: 5; background: (pmHColor) } }
          Text { text: (fdhA).name; style: small; bold: true; color: (pmHColor); weight: 1; maxLines: 1 }
        }
        Row { gap: 5; align: center; weight: 1
          Text { text: (fdaA).name; style: small; bold: true; color: (pmAColor); weight: 1; align: end; maxLines: 1 }
          if (aLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (aLogo); size: 22; fit: contain; label: (fdaA).name } }
          else { Box { size: 10; radius: 5; background: (pmAColor) } }
        }
      }
      Canvas {
        fill: width
        height: 320
        let padL = 42
        let padR = 12
        let padT = 26
        let padB = 36
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        rect(padL, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCCyan, 0.05))
        rect(padL + cw / 2, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCGood, 0.055))
        rect(padL, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCBad, 0.05))
        rect(padL + cw / 2, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCAmber, 0.05))
        for v in [0, 0.15, 0.30, 0.45, 0.60] {
          line(padL + clamp(v, 0, 0.6) / 0.6 * cw, padT, padL + clamp(v, 0, 0.6) / 0.6 * cw, padT + ch, stroke: alpha(muted, 0.20), width: 1)
          text(replace(fixed(v, 2), ".", ","), padL + clamp(v, 0, 0.6) / 0.6 * cw, padT + ch + 14, size: 10, align: center, color: muted)
        }
        for v in [0, 0.3, 0.6, 0.9, 1.2] {
          line(padL, padT + (1.2 - clamp(v, 0, 1.2)) / 1.2 * ch, padL + cw, padT + (1.2 - clamp(v, 0, 1.2)) / 1.2 * ch, stroke: alpha(muted, 0.20), width: 1)
          text(replace(fixed(v, 1), ".", ","), padL - 6, padT + (1.2 - clamp(v, 0, 1.2)) / 1.2 * ch, size: 10, align: end, color: muted)
        }
        text("CRÉE LOIN DU BUT", padL + 8, padT + 14, size: 8, align: start, bold: true, color: pmCCyan)
        text("TOUT-TERRAIN", padL + cw - 8, padT + 14, size: 8, align: end, bold: true, color: pmCGood)
        text("PEU IMPLIQUÉ", padL + 8, padT + ch - 6, size: 8, align: start, bold: true, color: pmCBad)
        text("FINIT LES ACTIONS", padL + cw - 8, padT + ch - 6, size: 8, align: end, bold: true, color: pmCAmber)
        for p in (get((fa.players ?? {}), fdhAbbr, [])) {
          let px = padL + clamp(p.xgb, 0, 0.6) / 0.6 * cw
          let py = padT + (1.2 - clamp(p.xgc, 0, 1.2)) / 1.2 * ch
          let pr = 3.5 + min(p.mins / 180, 5.5)
          circle(px, py, pr + 4, fill: alpha((pmHColor), 0.10))
          circle(px, py, pr, fill: alpha((pmHColor), 0.60), stroke: (pmHColor), width: 1)
        }
        for p in (get((fa.players ?? {}), fdaAbbr, [])) {
          let px = padL + clamp(p.xgb, 0, 0.6) / 0.6 * cw
          let py = padT + (1.2 - clamp(p.xgc, 0, 1.2)) / 1.2 * ch
          let pr = 3.5 + min(p.mins / 180, 5.5)
          circle(px, py, pr + 4, fill: alpha((pmAColor), 0.10))
          circle(px, py, pr, fill: alpha((pmAColor), 0.60), stroke: (pmAColor), width: 1)
        }
        let topH = (get((fa.players ?? {}), fdhAbbr, [])).take(3)
        let topA = (get((fa.players ?? {}), fdaAbbr, [])).take(3)
        for i in range(count(topH)) {
          let p = topH[i]
          let xx = padL + clamp(p.xgb, 0, 0.6) / 0.6 * cw
          let yy = padT + (1.2 - clamp(p.xgc, 0, 1.2)) / 1.2 * ch
          if i == 0 { text(sub(p.n, 0, 16), xx + 9, yy + 4, size: 10, align: start, bold: true, color: (pmHColor)) }
          else if i == 1 { text(sub(p.n, 0, 16), xx - 9, yy + 4, size: 10, align: end, bold: true, color: (pmHColor)) }
          else { text(sub(p.n, 0, 16), xx + 9, yy - 7, size: 10, align: start, bold: true, color: (pmHColor)) }
        }
        for i in range(count(topA)) {
          let p = topA[i]
          let xx = padL + clamp(p.xgb, 0, 0.6) / 0.6 * cw
          let yy = padT + (1.2 - clamp(p.xgc, 0, 1.2)) / 1.2 * ch
          if i == 0 { text(sub(p.n, 0, 16), xx + 9, yy + 4, size: 10, align: start, bold: true, color: (pmAColor)) }
          else if i == 1 { text(sub(p.n, 0, 16), xx - 9, yy + 4, size: 10, align: end, bold: true, color: (pmAColor)) }
          else { text(sub(p.n, 0, 16), xx + 9, yy - 7, size: 10, align: start, bold: true, color: (pmAColor)) }
        }
        text("Construction →", padL + cw / 2, height - 5, size: 10, align: center, bold: true, color: pmCCyan)
        text("↑ implication offensive", padL, padT - 10, size: 9, align: start, bold: true, color: pmCGood)
      }
      Text { text: "Bulle = minutes · couleur = équipe · x = construction, y = implication offensive"; style: label; color: muted; align: center; maxLines: 2 }
      Reading { pmVerdict: hCreatorTxt; facts: hCreatorFacts; c: (pmHColor); conf: (hp == null ? "faible" : (hp.mins ?? 0) >= 900 ? "élevée" : "faible (minutes)") }
      Reading { pmVerdict: aCreatorTxt; facts: aCreatorFacts; c: (pmAColor); conf: (ap == null ? "faible" : (ap.mins ?? 0) >= 900 ? "élevée" : "faible (minutes)") }
      KeyRead { key: creatorKey; c: pmCCyan }
    }
  }

              } else {
                Text { text: "Données joueurs indisponibles (Understat) : le graphique reviendra à la prochaine synchro."; style: label; color: muted; maxLines: 2 }
              }
            }
          }
          if anView == "plus" {
            Column { gap: 10
              AmSectionTitle { t: "Plan de jeu et clés"; c: pmCPink; sub: "créateurs, cartes de matchs et leviers" }
              AmSectionTitle { t: "Constellation de matchs"; c: pmCCyan; sub: "une carte par équipe · chaque point est un match : xG créé à droite, xGA concédé en haut" }
              MatchMap { an: fdhA; color: pmHColor }
              MatchMap { an: fdaA; color: pmAColor }
              let hCp = fdhA.xg5 >= 1.6 && fdhA.xga5 <= 1.2 ? "domination" : fdhA.xg5 >= 1.6 && fdhA.xga5 >= 1.6 ? "ouvert" : fdhA.xg5 < 1.2 && fdhA.xga5 >= 1.5 ? "subi" : fdhA.xg5 < 1.3 && fdhA.xga5 < 1.3 ? "bloc-bas" : "equilibre"
              let aCp = fdaA.xg5 >= 1.6 && fdaA.xga5 <= 1.2 ? "domination" : fdaA.xg5 >= 1.6 && fdaA.xga5 >= 1.6 ? "ouvert" : fdaA.xg5 < 1.2 && fdaA.xga5 >= 1.5 ? "subi" : fdaA.xg5 < 1.3 && fdaA.xga5 < 1.3 ? "bloc-bas" : "equilibre"
              let constKey = hCp == "domination" && aCp == "subi" ? "La domination de " + hName + " face à une équipe qui subit est la clé : si elle convertit sa maîtrise, " + aName + " ne tiendra pas." : aCp == "domination" && hCp == "subi" ? "La domination de " + aName + " face à une équipe qui subit est la clé : si elle convertit sa maîtrise, " + hName + " ne tiendra pas." : hCp == "domination" && aCp == "bloc-bas" ? hName + " va avoir le ballon, " + aName + " défend bas : la clé est la patience, les coups de pied arrêtés et l'ouverture du bloc." : aCp == "domination" && hCp == "bloc-bas" ? aName + " va avoir le ballon, " + hName + " défend bas : la clé est la patience, les coups de pied arrêtés et l'ouverture du bloc." : hCp == "ouvert" && aCp == "bloc-bas" ? "Les espaces de " + hName + " peuvent offrir à " + aName + " les transitions gagnantes : la discipline de " + hName + " est la clé." : aCp == "ouvert" && hCp == "bloc-bas" ? "Les espaces de " + aName + " peuvent offrir à " + hName + " les transitions gagnantes : la discipline de " + aName + " est la clé." : aCp == "subi" && hCp != "subi" ? aName + " subit et gagne rarement quand elle ne domine pas : si " + hName + " impose son rythme sans s'exposer, c'est une clé du match." : hCp == "subi" && aCp != "subi" ? hName + " subit et gagne rarement quand elle ne domine pas : si " + aName + " impose son rythme sans s'exposer, c'est une clé du match." : hCp == "ouvert" && aCp == "ouvert" ? "Deux équipes de match ouvert : le dernier qui défend gagne. La clé est la capacité à fermer le jeu après avoir marqué." : hCp == "bloc-bas" && aCp == "bloc-bas" ? "Deux blocs bas : le jeu se jouera sur coups de pied arrêtés et sur la première erreur." : ""
              AmSectionTitle { t: "Aller plus loin"; c: pmCViolet; sub: "radar de percentiles et carte de toutes les attaques du championnat" }
              
  Column { gap: 4; padding: 10; radius: 14; background: linear(0, 0, 1, 1, [alpha((pmHColor), 0.14), alpha(background, 0.35), alpha((pmAColor), 0.14)]); border: 1; borderColor: alpha(foreground, 0.06)
    Row { gap: 8; align: center
      Row { gap: 5; align: center; weight: 1
        if (hLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (hLogo); size: 22; fit: contain; label: (fdhA).name } }
        else { Box { size: 10; radius: 5; background: (pmHColor) } }
        Text { text: (fdhA).name; style: small; bold: true; color: (pmHColor); weight: 1; maxLines: 1 }
      }
      Row { gap: 5; align: center; weight: 1
        Text { text: (fdaA).name; style: small; bold: true; color: (pmAColor); weight: 1; align: end; maxLines: 1 }
        if (aLogo) != "" { Image { src: "~/.cache/espn-logos/banner/" + (aLogo); size: 22; fit: contain; label: (fdaA).name } }
        else { Box { size: 10; radius: 5; background: (pmAColor) } }
      }
    }
    Canvas {
      fill: width
      height: 330
      let labels = ["Att", "Déf", "Vol", "Préc", "Fin", "xPts"]
      let hv = [(fdhA).axes.att, (fdhA).axes.def, (fdhA).axes.vol, (fdhA).axes.acc, (fdhA).axes.fin, (fdhA).axes.xpts]
      let av = [(fdaA).axes.att, (fdaA).axes.def, (fdaA).axes.vol, (fdaA).axes.acc, (fdaA).axes.fin, (fdaA).axes.xpts]
      let n = count(labels)
      let cx = width / 2
      let cy = height / 2 + 5
      let r = min(width, height) / 2 - 46
      let hp = hv.map((v, k) => [cx + cos(rad(-90 + k * 360 / n)) * r * clamp(v, 0, 100) / 100, cy + sin(rad(-90 + k * 360 / n)) * r * clamp(v, 0, 100) / 100])
      let ap = av.map((v, k) => [cx + cos(rad(-90 + k * 360 / n)) * r * clamp(v, 0, 100) / 100, cy + sin(rad(-90 + k * 360 / n)) * r * clamp(v, 0, 100) / 100])
      for l in [0.25, 0.5, 0.75, 1] {
        let gp = range(n).map(k => [cx + cos(rad(-90 + k * 360 / n)) * r * l, cy + sin(rad(-90 + k * 360 / n)) * r * l])
        path(gp, closed: true, stroke: alpha(muted, l == 1 ? 0.30 : 0.20), width: 1)
      }
      text("100 = meilleur percentile", 8, 12, size: 9, align: start, bold: true, color: pmCLime)
      for k in range(n) {
        let a = rad(-90 + k * 360 / n)
        line(cx, cy, cx + cos(a) * r, cy + sin(a) * r, stroke: alpha(muted, 0.24), width: 1)
        text(labels[k], cx + cos(a) * (r + 20), cy + sin(a) * (r + 20), size: 10, align: center, bold: true, color: mix(foreground, pmCCyan, 0.35))
        text(round(hv[k]) + " · " + round(av[k]), cx + cos(a) * (r + 34), cy + sin(a) * (r + 34), size: 8, align: center, color: muted)
      }
      circle(cx, cy, 2, fill: alpha(foreground, 0.35))
      path(hp, closed: true, stroke: alpha((pmHColor), 0.14), width: 8)
      path(ap, closed: true, stroke: alpha((pmAColor), 0.14), width: 8)
      path(hp, closed: true, fill: alpha((pmHColor), 0.18), stroke: (pmHColor), width: 2.6)
      path(ap, closed: true, fill: alpha((pmAColor), 0.18), stroke: (pmAColor), width: 2.6)
      for i in range(n) { circle(hp[i][0], hp[i][1], 3.2, fill: (pmHColor), stroke: alpha(background, 0.8), width: 1) }
      for i in range(n) { circle(ap[i][0], ap[i][1], 3.2, fill: (pmAColor), stroke: alpha(background, 0.8), width: 1) }
    }
    let hAx = [{k: "Attaque", v: (fdhA).axes.att}, {k: "Défense", v: (fdhA).axes.def}, {k: "Volume", v: (fdhA).axes.vol}, {k: "Précision", v: (fdhA).axes.acc}, {k: "Finition", v: (fdhA).axes.fin}, {k: "xPts", v: (fdhA).axes.xpts}]
    let aAx = [{k: "Attaque", v: (fdaA).axes.att}, {k: "Défense", v: (fdaA).axes.def}, {k: "Volume", v: (fdaA).axes.vol}, {k: "Précision", v: (fdaA).axes.acc}, {k: "Finition", v: (fdaA).axes.fin}, {k: "xPts", v: (fdaA).axes.xpts}]
    let hSorted = sortBy(hAx, x => -x.v)
    let aSorted = sortBy(aAx, x => -x.v)
    let hWeak = sortBy(hAx, x => x.v)
    let aWeak = sortBy(aAx, x => x.v)
    let hAvg = avg(hAx.map(x => x.v))
    let aAvg = avg(aAx.map(x => x.v))
    let hRadarTxt = (fdhA).name + " : points forts " + hSorted[0].k + " (" + round(hSorted[0].v) + ") et " + hSorted[1].k + " (" + round(hSorted[1].v) + ") ; points faibles " + hWeak[0].k + " (" + round(hWeak[0].v) + ") et " + hWeak[1].k + " (" + round(hWeak[1].v) + "). " + (hAvg >= 65 ? "Profil globalement au-dessus du championnat." : hAvg <= 40 ? "Profil globalement en difficulté." : "Profil moyen.")
    let aRadarTxt = (fdaA).name + " : points forts " + aSorted[0].k + " (" + round(aSorted[0].v) + ") et " + aSorted[1].k + " (" + round(aSorted[1].v) + ") ; points faibles " + aWeak[0].k + " (" + round(aWeak[0].v) + ") et " + aWeak[1].k + " (" + round(aWeak[1].v) + "). " + (aAvg >= 65 ? "Profil globalement au-dessus du championnat." : aAvg <= 40 ? "Profil globalement en difficulté." : "Profil moyen.")
    let hRadarFacts = "Moyenne " + round(hAvg) + " · axe fort " + hSorted[0].k + " " + round(hSorted[0].v) + " · axe faible " + hWeak[0].k + " " + round(hWeak[0].v) + "."
    let aRadarFacts = "Moyenne " + round(aAvg) + " · axe fort " + aSorted[0].k + " " + round(aSorted[0].v) + " · axe faible " + aWeak[0].k + " " + round(aWeak[0].v) + "."
    let dAtt = (fdhA).axes.att - (fdaA).axes.def
    let dFin = (fdhA).axes.fin - (fdaA).axes.def
    let dVol = (fdhA).axes.vol - (fdaA).axes.def
    let dDef = (fdhA).axes.def - (fdaA).axes.att
    let dPts = (fdhA).axes.xpts - (fdaA).axes.xpts
    let dAttA = (fdaA).axes.att - (fdhA).axes.def
    let dFinA = (fdaA).axes.fin - (fdhA).axes.def
    let dVolA = (fdaA).axes.vol - (fdhA).axes.def
    let dDefA = (fdaA).axes.def - (fdhA).axes.att
    let dPtsA = (fdaA).axes.xpts - (fdhA).axes.xpts
    let bH = max(max(dAtt, dFin), max(max(dVol, dDef), dPts))
    let bA = max(max(dAttA, dFinA), max(max(dVolA, dDefA), dPtsA))
    let hLabel = bH == dAtt ? "attaque contre défense" : bH == dFin ? "finition contre défense" : bH == dVol ? "volume contre défense" : bH == dDef ? "défense contre attaque" : "xPts"
    let aLabel = bA == dAttA ? "attaque contre défense" : bA == dFinA ? "finition contre défense" : bA == dVolA ? "volume contre défense" : bA == dDefA ? "défense contre attaque" : "xPts"
    let hVal = bH == dAtt ? (fdhA).axes.att : bH == dFin ? (fdhA).axes.fin : bH == dVol ? (fdhA).axes.vol : bH == dDef ? (fdhA).axes.def : (fdhA).axes.xpts
    let hOpp = bH == dAtt || bH == dFin || bH == dVol ? (fdaA).axes.def : bH == dDef ? (fdaA).axes.att : (fdaA).axes.xpts
    let aVal = bA == dAttA ? (fdaA).axes.att : bA == dFinA ? (fdaA).axes.fin : bA == dVolA ? (fdaA).axes.vol : bA == dDefA ? (fdaA).axes.def : (fdaA).axes.xpts
    let aOpp = bA == dAttA || bA == dFinA || bA == dVolA ? (fdhA).axes.def : bA == dDefA ? (fdhA).axes.att : (fdhA).axes.xpts
    let radarKey = bH >= 15 && bH >= bA ? (fdhA).name + " a un avantage net en " + hLabel + " (" + round(hVal) + "e percentile contre " + round(hOpp) + "e) : c'est une clé du match si elle alimente ce secteur." : bA >= 15 ? (fdaA).name + " a un avantage net en " + aLabel + " (" + round(aVal) + "e percentile contre " + round(aOpp) + "e) : c'est une clé du match si elle alimente ce secteur." : hAvg - aAvg >= 10 ? (fdhA).name + " domine globalement le radar (" + round(hAvg) + " contre " + round(aAvg) + ") : la clé est de ne pas laisser " + (fdaA).name + " compenser par un secteur isolé." : aAvg - hAvg >= 10 ? (fdaA).name + " domine globalement le radar (" + round(aAvg) + " contre " + round(hAvg) + ") : la clé est de ne pas laisser " + (fdhA).name + " compenser par un secteur isolé." : ""
    Reading { pmVerdict: hRadarTxt; facts: hRadarFacts; c: (pmHColor); conf: "moyenne (percentiles)" }
    Reading { pmVerdict: aRadarTxt; facts: aRadarFacts; c: (pmAColor); conf: "moyenne (percentiles)" }
    Text { text: "Att attaque · Déf défense · Vol volume · Préc précision · Fin finition · xPts points attendus"; style: label; color: muted; align: center; maxLines: 2 }
  }

              
  let xgU = ((fdxh.proxy ?? false) || (fdxa.proxy ?? false)) ? "buts" : "xG"
  let xgAU = xgU == "buts" ? "buts encaissés" : "xGA"
  Column { gap: 4; padding: 10; radius: 14; background: linear(0, 0, 1, 1, [alpha((pmHColor), 0.14), alpha(background, 0.35), alpha((pmAColor), 0.14)]); border: 1; borderColor: alpha(foreground, 0.06)
    Row { gap: 8; align: center
      Text { text: xgU + " pour →"; style: label; color: muted; maxLines: 1 }
      Text { text: (pmHAbbr); style: small; bold: true; color: (pmHColor); weight: 1; align: end; maxLines: 1 }
      Text { text: (pmAAbbr); style: small; bold: true; color: (pmAColor); maxLines: 1 }
    }
    Canvas {
      fill: width
      height: 310
      let padL = 32
      let padR = 12
      let padT = 28
      let padB = 38
      let cw = max(width - padL - padR, 20)
      let ch = max(height - padT - padB, 20)
      rect(padL, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCBad, 0.055))
      rect(padL + cw / 2, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCAmber, 0.045))
      rect(padL, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCCyan, 0.04))
      rect(padL + cw / 2, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCGood, 0.06))
      for j in range(4) {
        let xx = padL + cw * j / 3
        let yy = padT + ch * j / 3
        line(xx, padT, xx, padT + ch, stroke: alpha(muted, 0.20), width: 1)
        line(padL, yy, padL + cw, yy, stroke: alpha(muted, 0.20), width: 1)
      }
      line(padL + cw / 2, padT, padL + cw / 2, padT + ch, stroke: alpha(muted, 0.34), width: 1)
      line(padL, padT + ch / 2, padL + cw, padT + ch / 2, stroke: alpha(muted, 0.34), width: 1)
      text("FRAGILE", padL + 6, padT + 13, size: 8, align: start, bold: true, color: pmCBad)
      text("OUVERT", padL + cw - 6, padT + 13, size: 8, align: end, bold: true, color: pmCAmber)
      text("PRUDENT", padL + 6, padT + ch - 5, size: 8, align: start, bold: true, color: pmCCyan)
      text("SOLIDE", padL + cw - 6, padT + ch - 5, size: 8, align: end, bold: true, color: pmCGood)
      for p in (fa.scatter ?? []) { circle(padL + p.x / ((fa.meta ?? {}).xgMax ?? 3.6) * cw, padT + (((fa.meta ?? {}).xgaMax ?? 3.2) - p.y) / ((fa.meta ?? {}).xgaMax ?? 3.2) * ch, 2.2, fill: alpha(muted, 0.35)) }
      let hp = first((fa.scatter ?? []).filter(p => p.a == (pmHAbbr)))
      let ap = first((fa.scatter ?? []).filter(p => p.a == (pmAAbbr)))
      if hp != null {
        let hx = padL + hp.x / ((fa.meta ?? {}).xgMax ?? 3.6) * cw
        let hy = padT + (((fa.meta ?? {}).xgaMax ?? 3.2) - hp.y) / ((fa.meta ?? {}).xgaMax ?? 3.2) * ch
        circle(hx, hy, 24, fill: alpha((pmHColor), 0.12))
        circle(hx, hy, 15, fill: alpha(background, 0.92))
        if (hLogo) != "" { image("~/.cache/espn-logos/soccer/" + (hLogo), hx - 12, hy - 12, 24, 24) }
        else { circle(hx, hy, 11, fill: (pmHColor)) }
        circle(hx, hy, 15, stroke: (pmHColor), width: 2)
        text((pmHAbbr), hx, hy - 22, size: 11, align: center, bold: true, color: (pmHColor))
      }
      if ap != null {
        let ax = padL + ap.x / ((fa.meta ?? {}).xgMax ?? 3.6) * cw
        let ay = padT + (((fa.meta ?? {}).xgaMax ?? 3.2) - ap.y) / ((fa.meta ?? {}).xgaMax ?? 3.2) * ch
        circle(ax, ay, 24, fill: alpha((pmAColor), 0.12))
        circle(ax, ay, 15, fill: alpha(background, 0.92))
        if (aLogo) != "" { image("~/.cache/espn-logos/soccer/" + (aLogo), ax - 12, ay - 12, 24, 24) }
        else { circle(ax, ay, 11, fill: (pmAColor)) }
        circle(ax, ay, 15, stroke: (pmAColor), width: 2)
        text((pmAAbbr), ax, ay - 22, size: 11, align: center, bold: true, color: (pmAColor))
      }
      text("↑ xGA concédé = défense fragile", padL, padT - 10, size: 9, align: start, bold: true, color: pmCAmber)
      text("xG créé / match →", padL + cw, height - 5, size: 10, align: end, bold: true, color: pmCCyan)
      text("Attaque faible", padL, padT + ch + 14, size: 9, align: start, color: muted)
      text("Attaque forte", padL + cw, padT + ch + 14, size: 9, align: end, color: muted)
    }
    let hp2 = first((fa.scatter ?? []).filter(p => p.a == (pmHAbbr)))
    let ap2 = first((fa.scatter ?? []).filter(p => p.a == (pmAAbbr)))
    let hAtk = hp2 == null ? "" : (hp2.x >= ((fa.meta ?? {}).xgMax ?? 3.6) / 2 ? "forte" : "faible")
    let hDef = hp2 == null ? "" : (hp2.y <= ((fa.meta ?? {}).xgaMax ?? 3.2) / 2 ? "solide" : "fragile")
    let aAtk = ap2 == null ? "" : (ap2.x >= ((fa.meta ?? {}).xgMax ?? 3.6) / 2 ? "forte" : "faible")
    let aDef = ap2 == null ? "" : (ap2.y <= ((fa.meta ?? {}).xgaMax ?? 3.2) / 2 ? "solide" : "fragile")
    let hQ = hAtk == "forte" && hDef == "solide" ? "solide" : hAtk == "forte" ? "ouvert" : hDef == "solide" ? "prudent" : "fragile"
    let aQ = aAtk == "forte" && aDef == "solide" ? "solide" : aAtk == "forte" ? "ouvert" : aDef == "solide" ? "prudent" : "fragile"
    let hAtkTxt = hAtk == "forte" ? "elle crée beaucoup" : "elle crée peu"
    let aAtkTxt = aAtk == "forte" ? "elle crée beaucoup" : "elle crée peu"
    let hDefTxt = hDef == "solide" ? "concède peu" : "concède beaucoup"
    let aDefTxt = aDef == "solide" ? "concède peu" : "concède beaucoup"
    let hAtkQ = hQ == "solide" ? "elle est solide : elle crée beaucoup et concède peu. C'est le quadrant le plus complet." : hQ == "ouvert" ? "elle est ouverte : elle crée beaucoup mais concède beaucoup. Spectaculaire, exposée." : hQ == "prudent" ? "elle est prudente : elle crée peu mais concède peu. Elle ferme le match plus qu'elle ne le gagne." : "elle est fragile : elle crée peu et concède beaucoup. Le double problème est offensif et défensif."
    let aAtkQ = aQ == "solide" ? "elle est solide : elle crée beaucoup et concède peu. C'est le quadrant le plus complet." : aQ == "ouvert" ? "elle est ouverte : elle crée beaucoup mais concède beaucoup. Spectaculaire, exposée." : aQ == "prudent" ? "elle est prudente : elle crée peu mais concède peu. Elle ferme le match plus qu'elle ne le gagne." : "elle est fragile : elle crée peu et concède beaucoup. Le double problème est offensif et défensif."
    let hAtkTxt2 = hp2 == null ? (pmHAbbr) + " : données indisponibles." : (pmHAbbr) + " : " + hAtkTxt + " (" + replace(fixed(hp2.x, 2), ".", ",") + " " + xgU + ") et " + hDefTxt + " (" + replace(fixed(hp2.y, 2), ".", ",") + "). " + hAtkQ
    let aAtkTxt2 = ap2 == null ? (pmAAbbr) + " : données indisponibles." : (pmAAbbr) + " : " + aAtkTxt + " (" + replace(fixed(ap2.x, 2), ".", ",") + " " + xgU + ") et " + aDefTxt + " (" + replace(fixed(ap2.y, 2), ".", ",") + "). " + aAtkQ
    let hAtkFacts = hp2 == null ? "" : (replace(fixed(hp2.x, 2), ".", ",") + " " + xgU + " créés · " + replace(fixed(hp2.y, 2), ".", ",") + " " + xgAU + " · attaque " + hAtk + " · défense " + hDef + ".")
    let aAtkFacts = ap2 == null ? "" : (replace(fixed(ap2.x, 2), ".", ",") + " " + xgU + " créés · " + replace(fixed(ap2.y, 2), ".", ",") + " " + xgAU + " · attaque " + aAtk + " · défense " + aDef + ".")
    let atkKey = hp2 == null || ap2 == null ? "" : hQ == "solide" && aQ == "fragile" ? (pmHAbbr) + " est solide des deux côtés, " + (pmAAbbr) + " fragile des deux côtés : si " + (pmHAbbr) + " impose son rythme, l'écart peut se creuser. La clé est sa patience." : aQ == "solide" && hQ == "fragile" ? (pmAAbbr) + " est solide des deux côtés, " + (pmHAbbr) + " fragile des deux côtés : si " + (pmAAbbr) + " impose son rythme, l'écart peut se creuser. La clé est sa patience." : hQ == "ouvert" && aQ == "prudent" ? (pmHAbbr) + " ouvre le jeu, " + (pmAAbbr) + " ferme : la clé est la capacité de " + (pmHAbbr) + " à ne pas s'exposer sur ses temps forts." : aQ == "ouvert" && hQ == "prudent" ? (pmAAbbr) + " ouvre le jeu, " + (pmHAbbr) + " ferme : la clé est la capacité de " + (pmAAbbr) + " à ne pas s'exposer sur ses temps forts." : hQ == "solide" && aQ == "ouvert" ? (pmHAbbr) + " défend mieux que " + (pmAAbbr) + " n'attaque : si " + (pmHAbbr) + " marque en premier, " + (pmAAbbr) + " devra s'ouvrir et s'exposera." : aQ == "solide" && hQ == "ouvert" ? (pmAAbbr) + " défend mieux que " + (pmHAbbr) + " n'attaque : si " + (pmAAbbr) + " marque en premier, " + (pmHAbbr) + " devra s'ouvrir et s'exposera." : hQ == "ouvert" && aQ == "ouvert" ? "Deux équipes ouvertes : match de buts attendu, le dernier qui défend gagne." : hQ == "prudent" && aQ == "prudent" ? "Deux équipes prudentes : peu d'occasions attendues, premier but décisif." : ""
    Reading { pmVerdict: hAtkTxt2; facts: hAtkFacts; c: (pmHColor); conf: "moyenne (championnat)" }
    Reading { pmVerdict: aAtkTxt2; facts: aAtkFacts; c: (pmAColor); conf: "moyenne (championnat)" }
    Text { text: "Chaque point gris = une équipe du championnat · les logos sont les deux équipes du match"; style: label; color: muted; align: center; maxLines: 2 }
  }

              Text { text: "Radar et carte : percentiles et repères sur les 5 derniers matchs."; style: label; color: muted; align: center; maxLines: 2 }
              let atkGapH = (fdhA.xg5 ?? 0) - (fdaA.xga5 ?? 0)
              let atkGapA = (fdaA.xg5 ?? 0) - (fdhA.xga5 ?? 0)
              let radGapH = (fdhA.axes.att ?? 0) - (fdaA.axes.def ?? 0)
              let radGapA = (fdaA.axes.att ?? 0) - (fdhA.axes.def ?? 0)
              let hMetaS = get((fa.playersMeta ?? {}), fdhAbbr, null)
              let aMetaS = get((fa.playersMeta ?? {}), fdaAbbr, null)
              let hDesk = (fdhA.deserved.ppm ?? 0) - (fdhA.deserved.xppm ?? 0)
              let aDesk = (fdaA.deserved.ppm ?? 0) - (fdaA.deserved.xppm ?? 0)
              let synthKeys = [constKey, atkGapH >= 0.35 && atkGapH >= atkGapA ? hName + " crée " + replace(fixed(fdhA.xg5 ?? 0, 2), ".", ",") + " xG quand " + aName + " concède " + replace(fixed(fdaA.xga5 ?? 0, 2), ".", ",") + " : le croisement attaque/défense le plus net, à exploiter." : atkGapA >= 0.35 ? aName + " crée " + replace(fixed(fdaA.xg5 ?? 0, 2), ".", ",") + " xG quand " + hName + " concède " + replace(fixed(fdhA.xga5 ?? 0, 2), ".", ",") + " : le croisement attaque/défense le plus net, à exploiter." : "", radGapH >= 15 && radGapH >= radGapA ? "L'attaque de " + hName + " (" + round(radGapH) + " percentiles d'avance) tombe sur la défense de " + aName + " : clé si " + hName + " alimente ce secteur." : radGapA >= 15 ? "L'attaque de " + aName + " (" + round(radGapA) + " percentiles d'avance) tombe sur la défense de " + hName + " : clé si " + aName + " alimente ce secteur." : "", fdhA.style != null && aMetaS != null && (aMetaS.gini ?? 0) >= 0.45 && fdhA.style.ppda5 <= 12 ? aName + " dépend fortement de son créateur et " + hName + " presse haut : l'isoler est une clé." : fdaA.style != null && hMetaS != null && (hMetaS.gini ?? 0) >= 0.45 && fdaA.style.ppda5 <= 12 ? hName + " dépend fortement de son créateur et " + aName + " presse haut : l'isoler est une clé." : "", hDesk >= 0.15 && aDesk <= -0.15 ? hName + " vit au-dessus de son jeu, " + aName + " mérite mieux : si la réussite s'inverse, " + aName + " est la clé." : aDesk >= 0.15 && hDesk <= -0.15 ? aName + " vit au-dessus de son jeu, " + hName + " mérite mieux : si la réussite s'inverse, " + hName + " est la clé." : "", (fdhA.trendXgd ?? 0) > 0.2 && (fdaA.trendXgd ?? 0) < -0.2 ? hName + " monte quand " + aName + " décroche : la dynamique est une clé." : (fdaA.trendXgd ?? 0) > 0.2 && (fdhA.trendXgd ?? 0) < -0.2 ? aName + " monte quand " + hName + " décroche : la dynamique est une clé." : ""]
              for k in synthKeys.filter(x => x != "").take(3) key k {
                KeyRead { key: k; c: pmCPink; t: "SYNTHÈSE · CLÉS CROISÉES" }
              }

            }
          }
        }
      }
    }
    Chapter { id: "infos"; n: "4"; t: "Infos pratiques"; sub: "cotes, compositions, actualités et déplacement"; c: yellow }
    if indexOf(openChapters, "infos") >= 0 {
      Column { gap: 10
        AmSectionTitle { t: "Cotes"; c: pmCAmber; sub: "probabilités estimées après retrait de la marge · aucune mise" }
        if odds == null { Text { text: "Pas de cotes."; style: small; color: muted } }
        else {
          if pmNoVig != null {
            PmStack { hv: pmNoVig.h; dv: pmNoVig.d; av: pmNoVig.a; hc: pmHColor; ac: pmAColor }
            Row { gap: 8; align: center
              Text { text: pmHAbbr + " " + pmNoVig.h + "%"; style: label; bold: true; color: pmHText; maxLines: 1 }
              Text { text: "N " + pmNoVig.d + "%"; style: label; color: pmCWarn; weight: 1; align: center; maxLines: 1 }
              Text { text: pmAAbbr + " " + pmNoVig.a + "%"; style: label; bold: true; color: pmAText; maxLines: 1 }
            }
          }
          Row { gap: 6
            Column { weight: 1; padding: 8; radius: 8; background: linear(0, 0, 1, 0, [alpha(pmHColor, 0.22), alpha(pmHColor, 0.05)]); border: 1; borderColor: alpha(pmHColor, 0.26) Text { text: "1 · " + hName; style: label; color: pmHText; minLines: 2; maxLines: 2 } Text { text: odds.h == null ? "—" : replace(fixed(odds.h, 2), ".", ","); style: title; color: foreground; maxLines: 1 } }
            Column { weight: 1; padding: 8; radius: 8; background: alpha(pmCWarn, 0.10); border: 1; borderColor: alpha(pmCWarn, 0.20) Text { text: "N · nul"; style: label; color: pmCWarn; maxLines: 1 } Text { text: odds.d == null ? "—" : replace(fixed(odds.d, 2), ".", ","); style: title; color: foreground; maxLines: 1 } }
            Column { weight: 1; padding: 8; radius: 8; background: linear(0, 0, 1, 0, [alpha(pmAColor, 0.22), alpha(pmAColor, 0.05)]); border: 1; borderColor: alpha(pmAColor, 0.26) Text { text: "2 · " + aName; style: label; color: pmAText; minLines: 2; maxLines: 2 } Text { text: odds.a == null ? "—" : replace(fixed(odds.a, 2), ".", ","); style: title; color: foreground; maxLines: 1 } }
          }
          if odds.tot != null { Text { text: "Total buts · " + replace(fixed(odds.tot, 1), ".", ",") + " · plus " + (odds.tov == null ? "—" : replace(fixed(odds.tov, 2), ".", ",")) + " / moins " + (odds.tuv == null ? "—" : replace(fixed(odds.tuv, 2), ".", ",")); style: small; color: muted; maxLines: 1 } }
          if pmMoveTxt != "" { Text { text: pmMoveTxt; style: label; color: muted; maxLines: 1 } }
          if odds.sph != null { Text { text: "Handicap · " + replace(fixed(odds.sph, 1), ".", ",") + " / " + (odds.spa == null ? "—" : replace(fixed(odds.spa, 1), ".", ",")); style: small; color: muted; maxLines: 1 } }
          Text { text: "Cotes indicatives, aucune mise."; style: label; color: muted; maxLines: 1 }
        }
        AmSectionTitle { t: "Compositions"; c: pmCSky; sub: "" }
        if count(lineups) == 0 { Text { text: "Compos non publiées — attends ~1 h avant le coup d'envoi."; style: small; color: muted; maxLines: 2 } }
        else { for l in lineups key l.t { Text { text: l.t + " " + (l.f ?? "") + " · " + join((l.p ?? []).map(p => p.n), " · "); style: label; color: muted; maxLines: 3 } } }
        if count(leaders) > 0 { AmSectionTitle { t: "Leaders"; c: pmCPink; sub: "" } for g in leaders key g.t + g.n { Text { text: g.t + " · " + join((g.l ?? []).filter(x => (x.n ?? "") != "" && (x.v ?? "") != "").map(x => x.n + " " + x.v), " · "); style: label; color: muted; maxLines: 2 } } }
        if count(injuries) > 0 { AmSectionTitle { t: "Blessures / suspendus"; c: pmCBad; sub: "" } for x in injuries key x.t + x.n { Text { text: x.t + " · " + (x.n ?? "") + (x.s == null ? "" : " · " + x.s); style: label; color: muted; maxLines: 1 } } }
        AmSectionTitle { t: "Actus"; c: pmCPink; sub: "" }
        if count(news) == 0 { Text { text: "Aucune actu liée à ce match."; style: small; color: muted } }
        else { for n in news key n.h { Text { text: n.h; style: label; color: accent; maxLines: 2 } Text { text: n.d; style: small; color: muted; maxLines: 2 } } }
        AmSectionTitle { t: "Voyage"; c: cTeal; sub: "" }
        if info.venue != null { Text { text: info.venue + (info.city == null ? "" : " · " + info.city); style: small; color: muted; maxLines: 2 } }
        if info.referee != null { Text { text: "Arbitre · " + info.referee; style: small; color: muted; maxLines: 1 } }
        Text { text: "Coup d'envoi · " + fmtTime(hero.at, "EEE d/MM HH:mm"); style: small; color: muted; maxLines: 1 }
      }
    }
  }
}
}else{
Row{gap:8;align:center;fill:width
Text{text:"●  "+(liveBadge!=""?liveBadge:statusTxt);style:label;color:spinning?"#22c55e":lastOk==false?"#ef4444":(liveBadge!=""?foreground:soft);weight:1;height:38;align:center;padding:[0,10];radius:12;background:alpha(foreground,0.035);border:1;borderColor:alpha(foreground,0.07);maxLines:1;onTap:refresh()}
Text{text:"labo ▸";style:label;bold:true;color:uiPop;height:38;align:center;padding:[0,13];radius:12;background:linear(0,0,1,1,[alpha(uiPop,0.20),alpha(uiPop,0.05)]);border:1;borderColor:alpha(uiPop,0.34);maxLines:1;onTap:{settingsOpen=false;labOpen=true;screen()}}
Text{text:"⚙";fontSize:17;color:accent;width:38;height:38;align:center;radius:12;background:alpha(foreground,0.05);border:1;borderColor:alpha(foreground,0.12);maxLines:1;onTap:{labOpen=false;settingsOpen=true;screen()}}
}
MainList{weight:1;chrome:false}
}
}
}

}


















