let previewHeroHomeForm=heroMatch==null?"":join(previewHeroFormPool.filter(g=>g.state=="post"&&(g.home.abbr??"")==(heroMatch.home.abbr??"")).sortBy(g=>-g.at).take(5).map(g=>g.home.winner?"V":g.away.winner?"D":"N")," ")
let previewHeroAwayForm=heroMatch==null?"":join(previewHeroFormPool.filter(g=>g.state=="post"&&(g.away.abbr??"")==(heroMatch.away.abbr??"")).sortBy(g=>-g.at).take(5).map(g=>g.away.winner?"V":g.home.winner?"D":"N")," ")
let previewHeroHomePoints=sum(previewHeroFormPool.filter(g=>g.state=="post"&&(g.home.abbr??"")==(heroMatch==null?"":(heroMatch.home.abbr??""))).sortBy(g=>-g.at).take(5).map(g=>g.home.winner?3:g.away.winner?0:1))
let previewHeroAwayPoints=sum(previewHeroFormPool.filter(g=>g.state=="post"&&(g.away.abbr??"")==(heroMatch==null?"":(heroMatch.away.abbr??""))).sortBy(g=>-g.at).take(5).map(g=>g.away.winner?3:g.home.winner?0:1))
let histLg=curLg==null?[]:(get(histMap,curLg,[])??[])
let jr=histLg.filter(g=>(g.round??0)>0).sortBy(g=>g.round)
let maxJ=count(jr)>0?last(jr).round:null
let minJ=count(jr)>0?first(jr).round:null
let jrPast=histLg.filter(g=>(g.round??0)>0&&g.state!='pre').sortBy(g=>g.round)
let maxPlayed=count(jrPast)>0?last(jrPast).round:maxJ
let curJ=curLg==null||maxJ==null?null:(selJ<0?maxPlayed:clamp(selJ,minJ??1,maxJ))
let jMatches=curJ==null?[]:histLg.filter(g=>g.round==curJ).sortBy(g=>g.at)
let jFuture=curJ!=null&&maxPlayed!=null&&curJ>maxPlayed
let euroHist=(get(histMap,euroLg,[])??[]).filter(g=>(g.round??0)>0).sortBy(g=>g.round)
let euroMaxJ=count(euroHist)>0?last(euroHist).round:null
let euroMinJ=count(euroHist)>0?first(euroHist).round:null
let euroPast=euroHist.filter(g=>g.state!='pre')
let euroMaxPlayed=count(euroPast)>0?last(euroPast).round:euroMaxJ
let euroCurJ=euroMaxJ==null?null:(selJ<0?euroMaxPlayed:clamp(selJ,euroMinJ??1,euroMaxJ))
let euroJMatches=euroCurJ==null?[]:(get(histMap,euroLg,[])??[]).filter(g=>g.round==euroCurJ).sortBy(g=>g.at)
let euroUpJ=euroCurJ==null||euroMaxJ==null?null:clamp(euroCurJ+1,euroMinJ??1,euroMaxJ)
let euroUpMatches=euroUpJ==null?[]:(get(histMap,euroLg,[])??[]).filter(g=>g.round==euroUpJ).sortBy(g=>g.at)
let euroResMatches=euroCurJ==null?[]:(get(histMap,euroLg,[])??[]).filter(g=>g.round==euroCurJ&&g.state!='pre').sortBy(g=>g.at)
let euroHero=(nextNew.filter(g=>g.league==euroLg).sortBy(g=>g.at).take(1)??[]).first
let topHero=(topNext.take(1)??[]).first
let topUpJ=curJ==null||maxJ==null?null:clamp(curJ+1,minJ??1,maxJ)
let topUpMatches=topUpJ==null?[]:histLg.filter(g=>g.round==topUpJ).sortBy(g=>g.at)
let topResMatches=curJ==null?[]:histLg.filter(g=>g.round==curJ&&g.state!='pre').sortBy(g=>g.at)
let rivLabel=(team=="ALL"?join(myTeams.map(t=>t.short)," · "):(selTeam.short??team))+S.rivSuffix
let topLabel=topLg=="ALL"?"ENG · ESP · GER · ITA · FRA":(topTabs.find(t=>t.id==topLg).short??topLg)
let sprPath="~/.cache/espn-logos/sprite.png"
let sprOk=spr!=null&&(spr.cell??0)>0&&(spr.w??0)>0
component Rule(){
Spacer{height:1;fill:width;background:alpha(muted,0.25)}
}
component Crest(logo=null,art=null,px=16,name="",big=false){
Box{
size:px
radius:px>20?6:4
background:rgb(0,0,0,0)
clip:true
let si=big?-1:(logo==null||lowData?-1:(sprOk?get(spr.idx??{},logo,-1):-1))
if art{
Canvas{
size:px
image(art,0,0,px,px)
}
}else if si>=0{
Canvas{
size:px
let sc=px/spr.cell
let cc=si%spr.cols
let rr=floor(si/spr.cols)
clip(0,0,px,px){image(sprPath,0-cc*px,0-rr*px,spr.w*sc,spr.h*sc)}
}
}else if logo&&!lowData{
Canvas{
size:px
image(big?"~/.cache/espn-logos/banner/${logo}":"~/.cache/espn-logos/soccer/${logo}",0,0,px,px)
}
}else if logo||lowData||name!=""{
Text{text:name==""?"":sub(name,0,2);fontSize:max(px/3,8);align:center;color:soft;maxLines:1}
}else{
Box{size:px;radius:4;background:alpha(muted,0.18)}
}
}
}




component FormChip(l,px=15){
Canvas{
width:px;height:px-1
rect(0,0,px,px-1,radius:px>12?3:2,fill:l==cW?alpha("#22c55e",0.16):l==cL?alpha("#ef4444",0.16):alpha(muted,0.24))
text(l,px/2,(px-1)/2,size:px>12?9:7,align:center,bold:true,color:l==cW?"#22c55e":l==cL?"#ef4444":soft)
}
}
component GameRow(g,compact=false){
let hm=g.home??{}
let aw=g.away??{}
let hc=teamColors?(colors==null?muted:(get(colors,hm.logo??"",null)==null?muted:get(get(colors,hm.logo??"",{}),"c",muted))):pop
let ac=teamColors?(colors==null?muted:(get(colors,aw.logo??"",null)==null?muted:get(get(colors,aw.logo??"",{}),"c",muted))):pop
let hcText=mix(hc,foreground,0.35)
let acText=mix(ac,foreground,0.35)
let isLive=g.state=='in'
let final=g.state=='post'
let rd=get(rounds,g.id,"")
let anchor=get(anchors,g.league,null)
let aDay=anchor==null?0:floor(anchor.at/86400)
let aW=(aDay+3)%7
let aSat=aW>=4?aDay+(5-aW):aDay-(aW+2)
let fDay=floor(g.at/86400)
let fW=(fDay+3)%7
let fSat=fW>=4?fDay+(5-fW):fDay-(fW+2)
let est=rd==""&&g.state=='pre'&&(g.league=='fra.1'||g.league=='fra.2')&&anchor!=null&&(anchor.jn??0)>0?"${JP}${anchor.jn + floor((fSat + 5) / 7) - floor((aSat + 5) / 7)}":""
let rdt=rd!=""?rd:(g.round??0)>0?"${JP}${g.round}":est
let eurPos=indexOf(eurIds,g.id)+1
let eurJ=g.league=='uefa.europa'&&eurPos>0&&eurPos<=8?"${JP}${eurPos}":""
let euroH=(g.league=='uefa.champions'||g.league=='uefa.europa'||g.league=='uefa.europa.conf')?(get(histMap,g.league,[])??[]).find(h=>h.id==g.id):null
let euroR=euroH==null?0:(euroH.round??0)
let euroJ=euroR>0?"${JP}${euroR}":""
let stg=g.stage??""
let stgL=stg=='knockout-round-playoffs'?S.stgPO:stg=='round-of-16'?S.stg16:stg=='quarterfinals'?S.stgQF:stg=='semifinals'?S.stgSF:stg=='final'?S.stgF:""
let stgK=stgL!=""&&stg!="league-phase"?stgL:""
let rdt2=stgK!=""?stgK:euroJ!=""?euroJ:rdt!=""?rdt:eurJ!=""?eurJ:stgL
let hmOurs=favAbbrs.any(a=>a==hm.abbr)
let awOurs=favAbbrs.any(a=>a==aw.abbr)
let scored=(hm.score??null)!=null&&(aw.score??null)!=null
let res=final&&(hmOurs!=awOurs)&&scored?(hmOurs?(hm.winner?cW:aw.winner?cL:cN):(aw.winner?cW:hm.winner?cL:cN)):""
let hide=spoiler&&(g.state=="in"||g.state=="post")&&!revealed.any(x=>x==g.id)
let slot=fz
let cpc=fz*8/13
let mwid=(compact?116:124)+2*slot
let dayRel=fmtTime(g.at,"yyyy-MM-dd")==fmtTime(now,"yyyy-MM-dd")?S.dayToday:fmtTime(g.at,"yyyy-MM-dd")==fmtTime(now+86400,"yyyy-MM-dd")?S.dayTomorrow:""
let dstr=dayRel!=""?dayRel+" "+fmtTime(g.at,"HH:mm"):fmtTime(g.at,compact?"EEE d/MM":"EEE d MMM",null,lang)
let gdet=lower(g.detail??"")
let special=contains(gdet,"postpon")?S.postponed:contains(gdet,"cancel")?S.cancelled:contains(gdet,"susp")?S.suspended:""
let extraTag=contains(gdet,"aet")?"AET":(contains(gdet,"pen")?"PEN":"")
let dtw=len(dstr??"")*5.2+1
Box{fill:width;padding:[4,6];radius:8;background:linear(0,0,1,1,[alpha(hc,0.22),alpha(background,0.35),alpha(ac,0.22)]);border:1;borderColor:alpha(mix(hc,ac,0.5),0.18);onTap:{labOpen=false;run("printf '%s' "+sh(toJson(g))+" > ~/.cache/prematch-match.json");if g.state=='post'{run("printf '%s' "+sh(toJson(g))+" > ~/.cache/apres-match-request.json");sel=g.id;detailMode="post";openChapters=["post-match"]}else{handoff=g;detailMode="pre"};screen()}
Row{
gap:2
align:center
Column{
width:22;gap:0
Text{text:g.tag;fontSize:11;color:soft;maxLines:1}
}
Crest{logo:hm.logo;px:16;name:hm.name??hm.abbr}
Text{text:hmOurs?(myTeams.find(t=>t.abbr==hm.abbr).short??hm.abbr):wide?hm.name:hm.abbr;fontSize:fz;weight:1;maxLines:1;bold:hmOurs;color:teamColors?hcText:(hmOurs?pop:final&&!hide&&aw.winner?soft:foreground)}
if g.state=='pre'&&!compact{
Column{
width:mwid;gap:0;align:center
Text{text:(dayRel==""?"":dayRel+" · ")+(dayRel==""?fmtTime(g.at,"EEE d MMM HH:mm",null,lang):fmtTime(g.at,"HH:mm"));fontSize:fz;align:center;color:foreground;maxLines:1}
Text{text:special!=""?special:"("+S.inPrep+fmtDuration(max(g.at-now,0))+")";style:label;align:center;color:soft;maxLines:1}
}
}else if g.state=='pre'{
Text{text:special!=""?special:(dayRel==""?fmtTime(g.at,"EEE d/MM HH:mm",null,lang):dayRel+" · "+fmtTime(g.at,"HH:mm"));fontSize:fz;width:mwid;align:center;color:soft;maxLines:1}
}else if final{
Row{
width:mwid;gap:1;align:center;justify:center
Box{width:slot;height:slot-1
if hmOurs&&res!=""&&!hide{
FormChip{l:res;px:fz}
}
}
Text{text:hide?"–":(hm.score??"?");fontSize:fz;font:mono;width:len((hm.score??"?")+"")*cpc;bold:!hide&&hm.winner;color:foreground;onTap:{if spoiler&&hide{revealed=(revealed+[g.id]).take(30)}else{labOpen=false;run("printf '%s' "+sh(toJson(g))+" > ~/.cache/prematch-match.json");run("printf '%s' "+sh(toJson(g))+" > ~/.cache/apres-match-request.json");sel=g.id;detailMode="post";openChapters=["post-match"];screen()}}}
Text{text:dstr;style:label;width:dtw;align:center;color:soft;maxLines:1}
Text{text:hide?"–":(aw.score??"?");fontSize:fz;font:mono;width:len((aw.score??"?")+"")*cpc;bold:!hide&&aw.winner;color:foreground;onTap:{if spoiler&&hide{revealed=(revealed+[g.id]).take(30)}else{labOpen=false;run("printf '%s' "+sh(toJson(g))+" > ~/.cache/prematch-match.json");run("printf '%s' "+sh(toJson(g))+" > ~/.cache/apres-match-request.json");sel=g.id;detailMode="post";openChapters=["post-match"];screen()}}}
Box{width:slot;height:slot-1
if awOurs&&res!=""&&!hide{
FormChip{l:res;px:fz}
}
}
}
}else{
Row{
width:mwid;gap:2;align:center;justify:center
Text{text:hide?"–":(hm.score??"?");fontSize:fz;font:mono;width:max(18,len((hm.score??"?")+"")*cpc);align:end;bold:!hide&&hmOurs&&isLive;color:hide?soft:isLive?"#22c55e":foreground;onTap:{revealed=(revealed+[g.id]).take(30)}}
Box{width:6;height:6;radius:3;background:isLive?"#22c55e":rgb(0,0,0,0)}
Text{text:isLive?S.liveWord+" "+g.detail:g.detail;style:label;width:max(38,fz*3);align:center;color:isLive?"#22c55e":soft;maxLines:1}
Box{width:6}
Text{text:hide?"–":(aw.score??"?");fontSize:fz;font:mono;width:max(18,len((aw.score??"?")+"")*cpc);align:start;bold:!hide&&awOurs&&isLive;color:hide?soft:isLive?"#22c55e":foreground;onTap:{revealed=(revealed+[g.id]).take(30)}}
}
}
Text{text:awOurs?(myTeams.find(t=>t.abbr==aw.abbr).short??aw.abbr):wide?aw.name:aw.abbr;fontSize:fz;weight:1;maxLines:1;align:end;bold:awOurs;color:teamColors?acText:(awOurs?pop:final&&!hide&&hm.winner?soft:foreground)}
Crest{logo:aw.logo;px:16;name:aw.name??aw.abbr}
Text{text:extraTag==""?rdt2:extraTag+" · "+rdt2;fontSize:11;color:soft;width:max(30,fz*2);align:end;maxLines:1}
}
}
}
component LiveGame(g,compact=false){
let lv=liveList.find(h=>h.id==g.id)??g
GameRow{g:lv;compact:compact}
}
component FormStrip(t,px=15){
let ms=all.filter(g=>g.state=="post"&&(t.kind??"c")==(g.league=="uefa.nations"||g.league=="fifa.worldq.uefa"||g.league=="fifa.friendly"?"n":"c")&&(count(g.tids??[])>0?((t.tid??"")!=""?(g.tids??[]).any(s=>s==t.tid):false):(g.squads??[]).any(s=>s==t.abbr))).sortBy(g=>-g.at).take(5).reverse()
Row{
width:5*px+8
gap:2
align:center
for g in ms key g.id{
let oh=(g.home.abbr??"")==t.abbr
let r=oh?(g.home.winner?cW:g.away.winner?cL:cN):(g.away.winner?cW:g.home.winner?cL:cN)
FormChip{l:r;px:px}
}
}
}
component BannerForm(t,lg,px=11){
let nat=lg=="uefa.nations"||lg=="fifa.worldq.uefa"||lg=="fifa.friendly"
let al=all.filter(g=>g.state=="post"&&((g.league=="uefa.nations"||g.league=="fifa.worldq.uefa"||g.league=="fifa.friendly")==nat)&&((g.home.abbr??"")==t.abbr||(g.away.abbr??"")==t.abbr)).map(g=>{id:g.id,at:g.at,home:g.home.abbr,away:g.away.abbr,hw:g.home.winner,aw:g.away.winner})
let hl=(get(histMap,lg,[])??[]).filter(g=>g.state=="post"&&((g.home.abbr??"")==t.abbr||(g.away.abbr??"")==t.abbr)).map(g=>{id:g.id,at:g.at,home:g.home.abbr,away:g.away.abbr,hw:g.home.winner,aw:g.away.winner})
let ms=flatten([al,hl.filter(g=>!al.any(a=>a.id==g.id))]).sortBy(g=>-g.at).take(5).reverse()
Column{
width:px
gap:2
align:center
for g in ms key g.id{
let oh=g.home==t.abbr
let r=oh?(g.hw?cW:g.aw?cL:cN):(g.aw?cW:g.hw?cL:cN)
FormChip{l:r;px:px}
}
}
}
component BannerLogo(logo=null,px=56,name="",color=uiPop){
Box{
size:px
fill:false
clip:true
background:rgb(0,0,0,0)
if !lowData&&logo!=null&&logo!=""{
 Canvas{
 size:px
 image("~/.cache/espn-logos/banner/${logo}",0,0,px,px)
 }
}else{
Text{text:name==""?"":sub(name,0,2);fontSize:max(px/4,9);align:center;color:soft;maxLines:1}
}
}
}
component BannerOdd(l,v,tone=soft){
Box{
weight:1
padding:[5,3]
radius:8*corners
background:linear(0,0,1,1,[alpha(tone,0.24),alpha(tone,0.06)])
border:1
borderColor:alpha(tone,0.22)
Row{
gap:4
align:center
justify:center
Text{text:l;width:12;style:label;color:tone;maxLines:1}
Text{text:v==null?"—":"${fixed(v, 2)}";fontSize:fz;font:mono;bold:true;color:tone;maxLines:1}
}
}
}
component MatchBanner(m=heroMatch,w=72,h=96){
let isHero=m!=null&&heroMatch!=null&&m.id==heroMatch.id
let lg=m==null?"":(m.league??"")
let ht=m==null||m.home==null||m.away==null?null:first(myTablesAll.filter(u=>u.league==lg&&(u.teams??[]).any(tm=>tm.abbr==m.home.abbr)&&(u.teams??[]).any(tm=>tm.abbr==m.away.abbr)))
let hRow=ht==null||m==null||m.home==null?null:first((ht.teams??[]).filter(tm=>tm.abbr==m.home.abbr))
let aRow=ht==null||m==null||m.away==null?null:first((ht.teams??[]).filter(tm=>tm.abbr==m.away.abbr))
let hRank=hRow==null?null:hRow.rank
let aRank=aRow==null?null:aRow.rank
let mAt=m==null?0:(isHero?heroAt:(m.at??0))
let mH=m==null||m.home==null?"":(myTeams.find(t=>t.abbr==m.home.abbr).short??(wide?(m.home.name??m.home.abbr):m.home.abbr))
let mA=m==null||m.away==null?"":(myTeams.find(t=>t.abbr==m.away.abbr).short??(wide?(m.away.name??m.away.abbr):m.away.abbr))
let mHLogo=m==null||m.home==null?"":(m.home.logo??"")
let mALogo=m==null||m.away==null?"":(m.away.logo??"")
let mOdds=m==null?null:(isHero?((oddsNow??{}).id==m.id?oddsNow.odds:((heroOdds??{}).id==m.id?heroOdds.odds:m.odds)):m.odds)
let oh=mOdds==null?null:mOdds.h
let odr=mOdds==null?null:mOdds.d
let oa=mOdds==null?null:mOdds.a
let oddsOn=showOdds&&m!=null&&m.state=="pre"&&oh!=null&&odr!=null&&oa!=null
let midW=wide?fz*14:fz*13
let hOurs=m!=null&&m.home!=null&&(myTeams??[]).any(t=>t.abbr==m.home.abbr)
let aOurs=m!=null&&m.away!=null&&(myTeams??[]).any(t=>t.abbr==m.away.abbr)
let mHc=teamColors&&m!=null&&m.home!=null?(colors==null?uiPop:(get(colors,m.home.logo??"",null)==null?uiPop:get(get(colors,m.home.logo??"",{}),"c",uiPop))):uiPop
let mAc=teamColors&&m!=null&&m.away!=null?(colors==null?uiPop:(get(colors,m.away.logo??"",null)==null?uiPop:get(get(colors,m.away.logo??"",{}),"c",uiPop))):uiPop
let winC="#22c55e"
let drawC="#f59e0b"
let lossC="#ef4444"
let hTone=hOurs?winC:aOurs?lossC:soft
let dTone=hOurs||aOurs?drawC:soft
let aTone=aOurs?winC:hOurs?lossC:soft
let mTime=m==null?"":m.state=="in"?(m.detail??""):fmtTime(mAt,"HH:mm")
let mTag=m==null||m.tag==null||m.tag==""?"":m.tag
let mDay=m==null||m.state=="in"?"":fmtTime(mAt,"d MMM",null,lang)
let mTagLine=mDay==""?mTag:(mTag==""?mDay:mTag+" · "+mDay)
let mDown=m==null?"":m.state=="in"?S.liveNowB:mAt-now<0?S.liveNowB:mAt-now<60?S.startingNow:S.kickoffIn+fmtDuration(mAt-now)
if m!=null{
Box{fill:width;padding:[12,10];radius:14*corners;border:1;borderColor:alpha(mix(mHc,mAc,0.5),0.45);background:linear(0,0,1,1,[alpha(mHc,0.42),alpha(background,0.30),alpha(mAc,0.42)]);onTap:{labOpen=false;run("printf '%s' "+sh(toJson(m))+" > ~/.cache/prematch-match.json");if m.state=='post'{run("printf '%s' "+sh(toJson(m))+" > ~/.cache/apres-match-request.json");sel=m.id;detailMode="post";openChapters=["post-match"]}else{handoff=m;detailMode="pre"};screen()}
Row{gap:8;align:center;fill:width
if showForm{BannerForm{t:m.home;lg:lg}}
Column{weight:1;gap:1;align:center
BannerLogo{logo:mHLogo;px:56;name:mH;color:mHc}
Text{text:mH;bold:true;fontSize:fz;align:center;maxLines:1;color:mix(mHc,foreground,0.35)}
Text{text:hRank==null?"":"#${hRank}";style:label;color:soft;align:center;maxLines:1}
}
Column{width:midW;gap:1;align:center
Text{text:mTime;style:title;align:center;maxLines:1}
Text{text:mTagLine;style:label;color:soft;align:center;maxLines:1}
Text{text:mDown;style:label;color:m.state=="in"?"#22c55e":accent;align:center;maxLines:1}
if oddsOn{
 Row{
 width:midW
 padding:[3,2]
 gap:2
 align:center
 BannerOdd{l:"1";v:oh;tone:hTone}
BannerOdd{l:"N";v:odr;tone:dTone}
BannerOdd{l:"2";v:oa;tone:aTone}
}
}
if isHero&&heroH2H!=""{
Text{text:heroH2H;style:label;color:soft;align:center;maxLines:1}
}
if isHero&&heroH2HLast!=""{
Text{text:heroH2HLast;style:label;color:soft;align:center;maxLines:1}
}
if isHero&&noVigTxt!=""{Text{text:noVigTxt;style:label;color:soft;align:center;maxLines:1}}
}
Column{weight:1;gap:1;align:center
BannerLogo{logo:mALogo;px:56;name:mA;color:mAc}
Text{text:mA;bold:true;fontSize:fz;align:center;maxLines:1;color:mix(mAc,foreground,0.35)}
Text{text:aRank==null?"":"#${aRank}";style:label;color:soft;align:center;maxLines:1}
}
if showForm{BannerForm{t:m.away;lg:lg}}
}
}
}
}
component MatchBanners(w=72,h=96){
Column{gap:8
for m in heroWindow key m.id{MatchBanner{m:m;w:w;h:h}}
}
}
component MainList(chrome=true){
Column{
scroll:true
fill:width
background:linear(0,0,0,1,[alpha(uiPop,0.12),alpha(background,0.0),alpha(uiPop,0.08)])
Row{
gap:4
align:center
for m in modeTabs key m.id{
Box{weight:1;padding:[7,4];radius:16;align:center;background:view==m.id?linear(0,0,1,1,[alpha(uiPop,0.30),alpha(uiPop,0.10)]):alpha(foreground,0.04);border:1;borderColor:view==m.id?alpha(uiPop,0.5):alpha(foreground,0.08);onTap:{view=m.id;selJ=-1}
Text{text:m.short;style:label;bold:view==m.id;color:view==m.id?foreground:soft;align:center;maxLines:1}
}
}
}
if chrome{
Row{gap:8;align:center;fill:width
Text{text:"⤢  plein écran";style:label;bold:true;color:accent;weight:1;height:38;align:center;padding:[0,10];radius:12;background:linear(0,0,1,1,[alpha(accent,0.24),alpha(accent,0.07)]);border:1;borderColor:alpha(accent,0.40);maxLines:1;onTap:{labOpen=false;settingsOpen=false;detailMode="";screen()}}
Text{text:"labo ▸";style:label;bold:true;color:uiPop;height:38;align:center;padding:[0,14];radius:12;background:linear(0,0,1,1,[alpha(uiPop,0.20),alpha(uiPop,0.05)]);border:1;borderColor:alpha(uiPop,0.34);maxLines:1;onTap:{settingsOpen=false;labOpen=true;screen()}}
Text{text:"⚙";fontSize:17;color:accent;width:38;height:38;align:center;radius:12;background:alpha(foreground,0.05);border:1;borderColor:alpha(foreground,0.12);maxLines:1;onTap:{labOpen=false;settingsOpen=true;screen()}}
}
}
if liveBadge!=""{
Text{text:liveBadge;style:label;color:count(liveF)>0?"#22c55e":soft;align:center;maxLines:1}
}
if filterOn{
Text{text:S.filter+" : "+filterLabel+" ✕";style:label;color:pop;align:center;maxLines:1;onTap:{todayOnly=false;daySel=""}}
}
if compactMode||matchdayMode{
Text{text:(compactMode?S.compact:S.matchday)+" ✕";style:label;color:pop;align:center;maxLines:1;onTap:{compactMode=false;matchdayMode=false}}
}
if matchdayMode&&matchday{
Text{text:"⚽ "+S.matchday+(heroMatch==null?"":" · "+heroDown);style:label;color:pop;align:center;maxLines:1}
}
Rule{}
if healthTxt!=""&&!setupNeeded{
Text{text:healthShort;padding:4;style:label;color:"#ef4444";align:center;maxLines:1;onTap:{detailMode="";screen()}}
}
if view=="TOP5"{
Row{
gap:4
align:center
for lg in topTabs key lg.id{
Text{text:lg.short;weight:1;align:center;style:label;maxLines:1;color:topLg==lg.id?pop:soft;bold:topLg==lg.id;onTap:{topLg=topLg==lg.id?"ALL":lg.id;selJ=-1}}
}
}
}else if view=="EUROPE"{
Row{
gap:4
align:center
for lg in euroTabs key lg.id{
Text{text:lg.short;weight:1;align:center;style:label;maxLines:1;color:euroLg==lg.id?pop:soft;bold:euroLg==lg.id;onTap:{euroLg=lg.id;selJ=-1}}
}
}
}else{
Row{
gap:4
align:center
for t in myTeams key t.key{
let tCol=teamColors?(colors==null?muted:(get(colors,t.logo??"",null)==null?muted:get(get(colors,t.logo??"",{}),"c",muted))):pop
Box{
weight:1;align:center;padding:6;border:1;radius:12
borderColor:team==t.abbr?tCol:alpha(tCol,0.22)
background:linear(0,0,1,1,[alpha(tCol,team==t.abbr?0.38:0.18),alpha(background,0.28),alpha(tCol,team==t.abbr?0.20:0.08)])
onTap:{team=team==t.abbr?"ALL":t.abbr;selJ=-1}
Column{
gap:3
align:center
Crest{logo:t.logo;px:26;name:t.name??t.short??t.abbr}
if showForm{FormStrip{t:t;px:count(myTeams)>3?11:15}}
}
}
}
}
}
Rule{}
if count(myTeams)==0{
Button{text:S.chooseTeams;fill:width;color:pop;onTap:{showTeams=true;screen()}}
Rule{}
}
if view=="MINE"{
MatchBanners{w:wide?88:48;h:wide?88:64}
Column{
if games==null{
Text{text:S.loading;style:small;color:soft}
}else if gamesErr{
Text{text:S.sourceErr+" "+(games.code??"");style:small;color:"#ef4444";align:center}
}else if total==0&&(extraErr||seasonAllErr){
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if total==0&&filterOn{
Text{text:S.noMatchDay+" · "+S.clearFilter;style:small;color:pop;align:center;maxLines:2;onTap:{todayOnly=false;daySel=""}}
}else if total==0{
Text{text:S.noMatchTeam;style:small;color:soft}
}else{
if count(pastTake)>0{
Box{fill:width;padding:[5,4];radius:8;background:linear(0,0,1,1,[alpha(uiPop,0.12),alpha(uiPop,0.02)]);border:1;borderColor:alpha(uiPop,0.12);onTap:{detailMode="";screen()}
Text{text:S.recent+(count(pastA)>count(pastTake)?" +"+(count(pastA)-count(pastTake)):"");style:label;color:uiPop;align:center;maxLines:1}
}
for g in pastTake key g.id{LiveGame{g:g;compact:true}}
Rule{}
}
if count(upShow)>0{
Box{fill:width;padding:[5,4];radius:8;background:linear(0,0,1,1,[alpha(uiPop,0.12),alpha(uiPop,0.02)]);border:1;borderColor:alpha(uiPop,0.12);onTap:{detailMode="";screen()}
Text{text:(count(liveF)>0?S.upLive:S.upcoming)+(count(upShow)>count(upTile)?" +"+(count(upShow)-count(upTile)):"");style:label;color:uiPop;align:center;maxLines:1}
}
for g in upTile key g.id{LiveGame{g:g;compact:true}}
}
}
}
}else if view=="RIV"{
Column{
Text{text:rivLabel+liveWarn;style:label;color:soft;align:center;maxLines:1}
if extra==null&&nextup==null{
Text{text:S.loading;style:small;color:soft}
}else if extraErr&&nextErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(rivalsTile)==0&&(extraErr||nextErr){
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(rivalsTile)==0{
Text{text:S.noRecent;style:small;color:soft}
}else{
for g in rivalsTile key g.id{LiveGame{g:g;compact:true}}
}
}
}else if view=="EUROPE"{
Column{
Text{text:euroLabel+liveWarn;style:label;color:soft;align:center;maxLines:1}
if extra==null&&nextup==null&&histfull==null{
Text{text:S.loading;style:small;color:soft}
}else if extraErr&&nextErr&&histErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if euroCurJ!=null&&euroMaxJ!=null{
if euroHero!=null{
LiveGame{g:euroHero;compact:true}
Rule{}
}
Row{
gap:4
align:center
Text{text:S.prev;width:64;padding:8;align:center;fontSize:fz;maxLines:1;color:euroCurJ!=null&&euroMinJ!=null&&euroCurJ>euroMinJ?foreground:muted;onTap:selJ=euroCurJ-1}
Text{text:euroCurJ==null?"…":"${JP}${euroCurJ} → ${JP}${euroUpJ}";weight:1;style:label;align:center;maxLines:1;color:selJ<0?pop:soft;onTap:selJ=-1}
Text{text:S.nextBtn;width:64;padding:8;align:center;fontSize:fz;maxLines:1;color:euroCurJ!=null&&euroMaxJ!=null&&euroCurJ<euroMaxJ?foreground:muted;onTap:selJ=euroCurJ+1}
}
Rule{}
if count(euroUpMatches)==0{
Text{text:euroCurJ!=null&&euroMaxPlayed!=null&&euroCurJ>=euroMaxJ?S.seasonOver:S.noUpcoming;style:small;color:soft;align:center}
}else{
for g in euroUpMatches key g.id{LiveGame{g:g;compact:true}}
}
Rule{}
Text{text:"· ${JP}${euroCurJ} ·";style:label;color:pop;align:center}
if count(euroResMatches)==0{
Text{text:S.noResults;style:small;color:soft;align:center}
}else{
for g in euroResMatches key g.id{LiveGame{g:g;compact:true}}
}
}else if count(euroList)==0&&(extraErr||nextErr||histErr){
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(euroList)==0{
Text{text:S.noRecent;style:small;color:soft}
}else{
for g in euroList key g.id{LiveGame{g:g;compact:true}}
}
}
}else{
Column{
Text{text:(topLg=="ALL"?topLabel:topLabel+" · "+S.tapAll)+liveWarn;style:label;color:topLg=="ALL"?soft:pop;align:center;maxLines:1;onTap:topLg="ALL"}
if extra==null&&nextup==null&&histfull==null{
Text{text:S.loading;style:small;color:soft}
}else if extraErr&&nextErr&&histErr{
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if curLg!=null&&maxJ!=null&&curJ!=null{
if topHero!=null{
LiveGame{g:topHero;compact:true}
Rule{}
}
Row{
gap:4
align:center
Text{text:S.prev;width:64;padding:8;align:center;fontSize:fz;maxLines:1;color:curJ!=null&&minJ!=null&&curJ>minJ?foreground:muted;onTap:selJ=curJ-1}
Text{text:curJ==null?"…":"${JP}${curJ} → ${JP}${topUpJ}";weight:1;style:label;align:center;maxLines:1;color:selJ<0?pop:soft;onTap:selJ=-1}
Text{text:S.nextBtn;width:64;padding:8;align:center;fontSize:fz;maxLines:1;color:curJ!=null&&maxJ!=null&&curJ<maxJ?foreground:muted;onTap:selJ=curJ+1}
}
Rule{}
if count(topUpMatches)==0{
Text{text:curJ!=null&&maxPlayed!=null&&curJ>=maxJ?S.seasonOver:S.noUpcoming;style:small;color:soft;align:center}
}else{
for g in topUpMatches key g.id{LiveGame{g:g;compact:true}}
}
Rule{}
Text{text:"· ${JP}${curJ} ·";style:label;color:pop;align:center}
if count(topResMatches)==0{
Text{text:S.noResults;style:small;color:soft;align:center}
}else{
for g in topResMatches key g.id{LiveGame{g:g;compact:true}}
}
}else if count(topTile)==0&&(extraErr||nextErr){
Text{text:S.sourceErr;style:small;color:"#ef4444";align:center}
}else if count(topTile)==0{
Text{text:S.noRecent;style:small;color:soft}
}else{
for g in topTile key g.id{LiveGame{g:g;compact:true}}
}
}
}
}
}

onTap:{labOpen=false;detailMode="pre";screen()}
MainList{}










state detailMode = ""

state pmTab = "overview"
state anTeam = "h"
state anSel = -1
state pmSelTeam = "h"
state anView = "resume"
state handoff = null
state snapId = ""

source pmNow = clock every 5m
source pmCur = file("~/.cache/espn-odds/current.json") json
source pmSelected = file("~/.cache/prematch-match.json") json
source pmGames = file("~/.cache/espn-games.json") json
source pmExtra = file("~/.cache/espn-extra.json") json
source pmNextup = file("~/.cache/espn-nextup.json") json
source hist = cmd("cat ~/.cache/espn-history.json") every 6h json
source pmTables = file("~/.cache/espn-standings.json") json
source pmColors = file("~/.cache/espn-logos/colors.json") json
source fd = file("~/.cache/espn-fd.json") json
source fa = file("~/.cache/espn-fd-analysis.json") json
source faSync = cmd("sh ~/.config/omalauncher/widgets/fd-analysis.sh") every 12h json timeout 120s
source fmXgSync = cmd("python3 ~/.config/omalauncher/widgets/fotmob_xg.py sync") every 30m json timeout 120s
source histCal = cmd("python3 ~/.config/omalauncher/widgets/prematch-history.py sync") every 24h json timeout 120s
source syn = file("~/.cache/prematch-synthesis.json") json
source teams = file("~/.cache/espn-teams.json") json
source pmCal = cmd("python3 ~/.config/omalauncher/widgets/prematch-preds.py calibrate") every 1h json timeout 30s

let pmAll = flatten([pmGames ?? [], pmExtra ?? []])
let fileMatch = pmSelected != null && pmSelected.id != null ? pmSelected : null
let selMatch = handoff != null && handoff.id != null ? handoff : fileMatch
let hero = selMatch != null ? selMatch : first(pmAll.filter(g => g.id == (pmCur == null ? "" : (pmCur.id ?? "")))) ?? first((pmExtra ?? []).filter(g => g.state == "pre")) ?? first(pmAll)
let synEntry = hero == null ? null : get((syn ?? {}), hero.id ?? "", null)
let synText = synEntry == null ? "" : (synEntry.text ?? "")
let synStatus = synEntry == null ? "idle" : (synEntry.status ?? "")
let synWords = synEntry == null ? 0 : (synEntry.words ?? 0)
let synSource = synEntry == null ? "" : (synEntry.source ?? "")
let synModel = synEntry == null ? "" : (synEntry.model ?? "")
let curMatch = hero != null && pmCur != null && (pmCur.id ?? "") == (hero.id ?? "") ? pmCur : null
let h = hero == null ? {} : (hero.home ?? {})
let a = hero == null ? {} : (hero.away ?? {})
let pmHAbbr = h.abbr ?? ""
let pmAAbbr = a.abbr ?? ""
let hName = h.name ?? pmHAbbr
let aName = a.name ?? pmAAbbr
let hLogo = h.logo ?? ""
let aLogo = a.logo ?? ""
let league = hero == null ? "" : (hero.league ?? "")
let hp = pmColors == null ? null : get(pmColors, hLogo, null)
let ap = pmColors == null ? null : get(pmColors, aLogo, null)
let hHash = hsl(hash(pmHAbbr) * 360, 0.65, 0.55)
let aHash = hsl(hash(pmAAbbr) * 360, 0.65, 0.55)
let fdh = fd == null ? null : get((fd.by_name ?? {}), lower(hName), null)
let fda = fd == null ? null : get((fd.by_name ?? {}), lower(aName), null)
let fdhAbbr = fa == null ? null : get((fa.by_name ?? {}), lower(hName), null)
let fdaAbbr = fa == null ? null : get((fa.by_name ?? {}), lower(aName), null)
let fdhA = get((fa.teams ?? {}), fdhAbbr, null)
let fdaA = get((fa.teams ?? {}), fdaAbbr, null)
let hHue = hp == null ? hash(pmHAbbr) * 360 : hp.h
let aHue = ap == null ? hash(pmAAbbr) * 360 : ap.h
let aPrimary = ap == null ? aHash : ap.c
let aSecondary = ap == null ? "#f59e0b" : (ap.c2 ?? "#f59e0b")
let pmHColor = hp == null ? hHash : hp.c
let pmAColor = abs(aHue - hHue) >= 55 ? aPrimary : (ap != null && abs((ap.h2 ?? aHue) - hHue) >= 55 ? aSecondary : (hHue >= 180 ? "#f59e0b" : "#38bdf8"))
let pmHText = mix(pmHColor, foreground, 0.3)
let pmAText = mix(pmAColor, foreground, 0.3)
let anCur = anTeam == "h" ? fdhA : fdaA
let anCol = anTeam == "h" ? pmHColor : pmAColor
let fdxh = fdhA ?? fdh
let fdxa = fdaA ?? fda
let info = curMatch == null ? {} : (curMatch.info ?? {})
let odds = curMatch != null && curMatch.odds != null ? curMatch.odds : (hero == null ? null : hero.odds)
let leaguePool = values(groupBy(flatten([pmExtra ?? [], get(hist ?? {}, league, [])]), g => g.id)).map(a => first(a))
let pool = leaguePool
let hGames = pool.filter(g => g.state == "post" && ((g.home.abbr ?? "") == pmHAbbr || (g.away.abbr ?? "") == pmHAbbr)).sortBy(g => -g.at).take(10)
let aGames = pool.filter(g => g.state == "post" && ((g.home.abbr ?? "") == pmAAbbr || (g.away.abbr ?? "") == pmAAbbr)).sortBy(g => -g.at).take(10)
let hRes = hGames.map(g => (g.home.abbr ?? "") == pmHAbbr ? (g.home.winner ? "V" : g.away.winner ? "D" : "N") : (g.away.winner ? "V" : g.home.winner ? "D" : "N"))
let aRes = aGames.map(g => (g.home.abbr ?? "") == pmAAbbr ? (g.home.winner ? "V" : g.away.winner ? "D" : "N") : (g.away.winner ? "V" : g.home.winner ? "D" : "N"))
let hForm = join(reverse(hRes.take(5)), " ")
let hFormLabel = count(hGames) >= 5 ? "5 derniers" : count(hGames) + " derniers"
let aForm = join(reverse(aRes.take(5)), " ")
let aFormLabel = count(aGames) >= 5 ? "5 derniers" : count(aGames) + " derniers"
let hPts = sum(hRes.take(5).map(r => r == "V" ? 3 : r == "N" ? 1 : 0))
let aPts = sum(aRes.take(5).map(r => r == "V" ? 3 : r == "N" ? 1 : 0))
let hGF = sum(hGames.map(g => int((g.home.abbr ?? "") == pmHAbbr ? (g.home.score ?? 0) : (g.away.score ?? 0))))
let aGF = sum(aGames.map(g => int((g.home.abbr ?? "") == pmAAbbr ? (g.home.score ?? 0) : (g.away.score ?? 0))))
let hGA = sum(hGames.map(g => int((g.home.abbr ?? "") == pmHAbbr ? (g.away.score ?? 0) : (g.home.score ?? 0))))
let aGA = sum(aGames.map(g => int((g.home.abbr ?? "") == pmAAbbr ? (g.away.score ?? 0) : (g.home.score ?? 0))))
let hHome = hGames.filter(g => (g.home.abbr ?? "") == pmHAbbr)
let hAway = hGames.filter(g => (g.away.abbr ?? "") == pmHAbbr)
let aHome = aGames.filter(g => (g.home.abbr ?? "") == pmAAbbr)
let aAway = aGames.filter(g => (g.away.abbr ?? "") == pmAAbbr)
let hHomePts = count(hHome) == 0 ? 0 : sum(hHome.map(g => g.home.winner ? 3 : g.away.winner ? 0 : 1)) / count(hHome)
let hAwayPts = count(hAway) == 0 ? 0 : sum(hAway.map(g => g.away.winner ? 3 : g.home.winner ? 0 : 1)) / count(hAway)
let aHomePts = count(aHome) == 0 ? 0 : sum(aHome.map(g => g.home.winner ? 3 : g.away.winner ? 0 : 1)) / count(aHome)
let aAwayPts = count(aAway) == 0 ? 0 : sum(aAway.map(g => g.away.winner ? 3 : g.home.winner ? 0 : 1)) / count(aAway)
let hHomeGF = sum(hHome.map(g => int(g.home.score ?? 0)))
let hHomeGA = sum(hHome.map(g => int(g.away.score ?? 0)))
let hAwayGF = sum(hAway.map(g => int(g.away.score ?? 0)))
let hAwayGA = sum(hAway.map(g => int(g.home.score ?? 0)))
let aHomeGF = sum(aHome.map(g => int(g.home.score ?? 0)))
let aHomeGA = sum(aHome.map(g => int(g.away.score ?? 0)))
let aAwayGF = sum(aAway.map(g => int(g.away.score ?? 0)))
let aAwayGA = sum(aAway.map(g => int(g.home.score ?? 0)))
let hClean = count(hGames.filter(g => int((g.home.abbr ?? "") == pmHAbbr ? (g.away.score ?? 0) : (g.home.score ?? 0)) == 0))
let aClean = count(aGames.filter(g => int((g.home.abbr ?? "") == pmAAbbr ? (g.away.score ?? 0) : (g.home.score ?? 0)) == 0))
let hBtts = count(hGames.filter(g => int(g.home.score ?? 0) > 0 && int(g.away.score ?? 0) > 0))
let aBtts = count(aGames.filter(g => int(g.home.score ?? 0) > 0 && int(g.away.score ?? 0) > 0))
let hOver = count(hGames.filter(g => int(g.home.score ?? 0) + int(g.away.score ?? 0) > 2))
let aOver = count(aGames.filter(g => int(g.home.score ?? 0) + int(g.away.score ?? 0) > 2))
let pmTb = first((pmTables ?? []).filter(u => (u.league ?? "") == league))
let pmHRow = pmTb == null ? null : first((pmTb.teams ?? []).filter(t => t.abbr == pmHAbbr))
let pmARow = pmTb == null ? null : first((pmTb.teams ?? []).filter(t => t.abbr == pmAAbbr))
let hPPG = pmHRow == null || (pmHRow.played ?? 0) == 0 ? "—" : fixed((pmHRow.pts ?? 0) / (pmHRow.played ?? 1), 2)
let aPPG = pmARow == null || (pmARow.played ?? 0) == 0 ? "—" : fixed((pmARow.pts ?? 0) / (pmARow.played ?? 1), 2)
let h2h = curMatch == null ? null : (curMatch.h2h ?? null)
let h2hList = h2h == null ? [] : (h2h.list ?? [])
let h2hGoals = sum(h2hList.map(x => int(x.hs ?? 0) + int(x.a ?? 0)))
let h2hAvg = count(h2hList) == 0 ? "—" : fixed(h2hGoals / count(h2hList), 1)
let news = (curMatch == null ? [] : (curMatch.news ?? [])).filter(n => contains(lower((n.h ?? "") + " " + (n.d ?? "")), lower(hName)) || contains(lower((n.h ?? "") + " " + (n.d ?? "")), lower(aName)))
let lineups = (curMatch == null ? [] : (curMatch.lineups ?? [])).filter(l => count(l.p ?? []) > 0)
let leaders = (curMatch == null ? [] : (curMatch.leaders ?? [])).filter(g => count((g.l ?? []).filter(x => (x.n ?? "") != "" && (x.v ?? "") != "")) > 0)
let injuries = curMatch == null ? [] : (curMatch.injuries ?? [])
let pmNoVig = odds == null || odds.h == null || odds.d == null || odds.a == null ? null : { h: round(100 / odds.h / (1 / odds.h + 1 / odds.d + 1 / odds.a)), d: round(100 / odds.d / (1 / odds.h + 1 / odds.d + 1 / odds.a)), a: round(100 / odds.a / (1 / odds.h + 1 / odds.d + 1 / odds.a)) }
let pOver = odds == null || odds.tov == null || odds.tuv == null ? null : (1 / odds.tov) / (1 / odds.tov + 1 / odds.tuv)
let zOver = pOver == null ? 0 : pOver <= 0.30 ? -0.52 : pOver <= 0.35 ? -0.39 : pOver <= 0.40 ? -0.25 : pOver <= 0.45 ? -0.13 : pOver <= 0.50 ? 0 : pOver <= 0.55 ? 0.13 : pOver <= 0.60 ? 0.25 : pOver <= 0.65 ? 0.39 : pOver <= 0.70 ? 0.52 : 0.68
let tMarket = odds == null || odds.tot == null || pOver == null ? null : max(odds.tot + zOver * sqrt(odds.tot), 1.2)
let sMarket = odds == null ? null : (odds.sph != null ? -odds.sph : (pmNoVig != null ? 2.2 * (pmNoVig.h - pmNoVig.a) / 100 : null))
let xgLh = fdxh == null || fdxh.xg5 == null || fdxa == null || fdxa.xga5 == null ? null : (fdxh.xg5 + fdxa.xga5) / 2
let xgLa = fdxa == null || fdxa.xg5 == null || fdxh == null || fdxh.xga5 == null ? null : (fdxa.xg5 + fdxh.xga5) / 2
let baseT = tMarket != null ? tMarket : (xgLh != null && xgLa != null ? xgLh + xgLa : null)
let baseS = sMarket != null ? sMarket : (xgLh != null && xgLa != null ? xgLh - xgLa : null)
let mktLh0 = baseT == null || baseS == null ? null : max((baseT + baseS) / 2, 0.2)
let mktLa0 = baseT == null || baseS == null ? null : max((baseT - baseS) / 2, 0.2)
let ml = pmCal == null ? null : (pmCal.marketLambda ?? null)
let mlU = pmNoVig == null || ml == null ? null : (pmNoVig.h - pmNoVig.a) / 100
let mlV = pmNoVig == null || ml == null ? null : pmNoVig.d / 100 - 0.5 * (pmNoVig.h + pmNoVig.a) / 100
let mlLh = mlU == null ? null : (ml.coefH[0] + ml.coefH[1] * mlU + ml.coefH[2] * mlV + ml.coefH[3] * mlU * mlU + ml.coefH[4] * mlU * mlV + ml.coefH[5] * mlV * mlV)
let mlLa = mlU == null ? null : (ml.coefA[0] + ml.coefA[1] * mlU + ml.coefA[2] * mlV + ml.coefA[3] * mlU * mlU + ml.coefA[4] * mlU * mlV + ml.coefA[5] * mlV * mlV)
let mktLh = mlLh != null ? max(mlLh, 0.2) : mktLh0
let mktLa = mlLa != null ? max(mlLa, 0.2) : mktLa0
let calLh = mktLh == null ? xgLh : mktLh
let calLa = mktLa == null ? xgLa : mktLa
let calSource = mlLh != null ? "cotes (lambda implicite)" : (mktLh != null ? (xgLh != null ? "cotes + xG" : "cotes") : "xG")
let adjH = mlLh != null ? 0 : (pmCal == null || pmCal.adj == null ? 0 : (pmCal.adj.h ?? 0))
let adjA = mlLa != null ? 0 : (pmCal == null || pmCal.adj == null ? 0 : (pmCal.adj.a ?? 0))
let calTemp = mlLh != null ? 1 : (pmCal == null || pmCal.prob == null ? 1 : (pmCal.prob.temp ?? 1))
let future = values(groupBy(flatten([leaguePool, pmNextup ?? []]), g => g.id)).map(a => first(a))
let hNext = future.filter(g => g.state == "pre" && (hero == null ? "" : g.id) != (hero == null ? "" : hero.id) && ((g.home.abbr ?? "") == pmHAbbr || (g.away.abbr ?? "") == pmHAbbr)).sortBy(g => g.at).take(5)
let aNext = future.filter(g => g.state == "pre" && (hero == null ? "" : g.id) != (hero == null ? "" : hero.id) && ((g.home.abbr ?? "") == pmAAbbr || (g.away.abbr ?? "") == pmAAbbr)).sortBy(g => g.at).take(5)
let pmVerdict = hPts > aPts ? hName : aPts > hPts ? aName : ""
let pmVerdictColor = hPts > aPts ? pmHText : aPts > hPts ? pmAText : muted
let ageTxt = curMatch == null || curMatch.ts == null ? "" : (pmNow - curMatch.ts < 60 ? "à l'instant" : fmtAgo(curMatch.ts, pmNow))
let score = (h.score ?? "0") + " – " + (a.score ?? "0")
let stateLine = hero == null ? "" : hero.state == "in" ? "en direct · " + score : hero.state == "post" ? "terminé · " + score : "coup d'envoi dans " + fmtDuration(max(hero.at - pmNow, 60))
let pmMoveH = odds == null || odds.ho == null || odds.h == null ? 0 : odds.h - odds.ho
let pmMoveA = odds == null || odds.ao == null || odds.a == null ? 0 : odds.a - odds.ao
let pmMoveTxt = odds == null || (pmMoveH == 0 && pmMoveA == 0) ? "" : "Mouvement · 1 " + (pmMoveH < 0 ? "▼" : pmMoveH > 0 ? "▲" : "·") + " · 2 " + (pmMoveA < 0 ? "▼" : pmMoveA > 0 ? "▲" : "·")

let pmCCyan = "#22d3ee"
let pmCLime = "#a3e635"
let pmCAmber = "#fbbf24"
let cCoral = "#fb7185"
let pmCViolet = "#c084fc"
let pmCSky = "#38bdf8"
let pmCPink = "#f472b6"
let cTeal = "#2dd4bf"
let pmCGood = "#22c55e"
let pmCWarn = "#f59e0b"
let pmCBad = "#ef4444"

component Section(t, c = accent, sub = "") {
  Column { gap: 3
    Row { gap: 8; align: center; padding: [8, 5]; radius: 12; background: linear(0, 0, 1, 0, [alpha(c, 0.30), alpha(c, 0.07)]); border: 1; borderColor: alpha(c, 0.32)
      Box { width: 4; height: 24; radius: 2; background: linear(0, 0, 0, 1, [c, alpha(c, 0.10)]) }
      Text { text: t; style: title; bold: true; color: mix(c, foreground, 0.22); maxLines: 1; letterSpacing: 0.2 }
    }
    if sub != "" {
      Row { gap: 6; align: center; padding: [0, 7]
        Text { text: "▸"; fontSize: 10; bold: true; color: c; maxLines: 1 }
        Text { text: sub; style: label; color: mix(c, foreground, 0.58); weight: 1; maxLines: 2 }
      }
    }
  }
}
component Reading(pmVerdict, facts = "", t = "LECTURE · EN CHIFFRES", c = accent, conf = "") {
  Column { gap: 4; padding: 10; radius: 9; background: linear(0, 0, 1, 1, [alpha(c, 0.18), alpha(background, 0.25)]); border: 1; borderColor: alpha(c, 0.28)
    Row { gap: 5; align: center
      Box { width: 3; height: 12; radius: 1.5; background: c }
      Text { text: t; style: label; bold: true; color: c; letterSpacing: 0.8; maxLines: 1 }
    }
    Text { text: pmVerdict; style: small; color: foreground; maxLines: 6 }
    if facts != "" {
      Text { text: facts; style: label; color: muted; maxLines: 3 }
    }
    if conf != "" {
      Text { text: "Confiance : " + conf; style: label; color: muted; maxLines: 1 }
    }
  }
}
component KeyRead(key, c = pmCWarn, t = "CLÉ DU MATCH") {
  if key != "" {
    Column { gap: 3; padding: 10; radius: 9; background: linear(0, 0, 1, 1, [alpha(c, 0.16), alpha(c, 0.03)]); border: 1; borderColor: alpha(c, 0.30)
      Row { gap: 5; align: center
        Box { width: 3; height: 12; radius: 1.5; background: c }
        Text { text: t; style: label; bold: true; color: c; letterSpacing: 0.9; maxLines: 1 }
      }
      Text { text: key; style: small; color: foreground; maxLines: 3 }
    }
  }
}
component PmLegend(dot, label, c) {
  Row { gap: 4; align: center
    if dot {
      Box { size: 8; radius: 4; background: c }
    } else {
      Box { width: 15; height: 3; radius: 2; background: c }
    }
    Text { text: label; style: label; fontSize: 9; color: mix(c, foreground, 0.45); maxLines: 1 }
  }
}
component Kpi(label, value, c = accent) {
  Column { gap: 1; weight: 1; padding: [6, 5]; radius: 8; align: center; background: alpha(c, 0.10); border: 1; borderColor: alpha(c, 0.18)
    Text { text: label; style: label; fontSize: 9; color: muted; align: center; maxLines: 1 }
    Text { text: value; style: small; fontSize: 14; bold: true; color: mix(c, foreground, 0.25); align: center; maxLines: 1 }
  }
}
component VenueSplit(name, color, hPts, aPts, hGF, hGA, aGF, aGA, hN, aN) {
  Column { gap: 4; padding: 9; radius: 10; background: linear(0, 0, 1, 1, [alpha(color, 0.22), alpha(background, 0.30)]); border: 1; borderColor: alpha(color, 0.26)
    Row { gap: 5; align: center
      Box { size: 8; radius: 4; background: color }
      Text { text: name; style: label; bold: true; color: mix(color, foreground, 0.30); weight: 1; maxLines: 1 }
    }
    Row { gap: 5
      Column { weight: 1; gap: 1; padding: 6; radius: 7; background: alpha(pmCGood, 0.08); border: 1; borderColor: alpha(pmCGood, 0.18)
        Text { text: "DOMICILE"; style: label; fontSize: 9; bold: true; color: pmCGood; maxLines: 1 }
        Text { text: replace(fixed(hPts, 2), ".", ",") + " pts"; style: small; bold: true; color: foreground; maxLines: 1 }
        Text { text: hGF + "–" + hGA + " buts"; style: label; color: muted; maxLines: 1 }
        Text { text: hN + " matchs"; style: label; color: muted; maxLines: 1 }
      }
      Column { weight: 1; gap: 1; padding: 6; radius: 7; background: alpha(pmCAmber, 0.08); border: 1; borderColor: alpha(pmCAmber, 0.18)
        Text { text: "EXTÉRIEUR"; style: label; fontSize: 9; bold: true; color: pmCAmber; maxLines: 1 }
        Text { text: replace(fixed(aPts, 2), ".", ",") + " pts"; style: small; bold: true; color: foreground; maxLines: 1 }
        Text { text: aGF + "–" + aGA + " buts"; style: label; color: muted; maxLines: 1 }
        Text { text: aN + " matchs"; style: label; color: muted; maxLines: 1 }
      }
    }
    Row { gap: 2; height: 6
      Box { weight: max(hPts, 0.1); height: 6; radius: 3; background: pmCGood }
      Box { weight: max(aPts, 0.1); height: 6; radius: 3; background: pmCAmber }
    }
  }
}

component PmBadge(logo, name, color, textColor) {
  Column { align: center; gap: 5
    Box { size: 72; radius: 36; align: center; background: rgb(0, 0, 0, 0)
      Image { src: logo == "" ? "" : "~/.cache/espn-logos/banner/${logo}"; size: 58; fit: contain; label: name }
    }
    Text { text: name; bold: true; fontSize: 14; color: textColor; align: center; minLines: 2; maxLines: 2 }
  }
}
component AppRow(tm, lg) {
  let tr = first((teams ?? []).filter(t => t.abbr == tm.abbr))
  let crest = (tm.logo ?? "") == "" ? (tr == null ? "" : (tr.logo ?? "")) : (tm.logo ?? "")
  let tc = pmColors == null ? accent : (get(pmColors, crest, null) == null ? accent : get(get(pmColors, crest, {}), "c", accent))
  let fg = leaguePool.filter(g => g.state == "post" && (g.league ?? "") == lg && ((g.home.abbr ?? "") == tm.abbr || (g.away.abbr ?? "") == tm.abbr)).sortBy(g => -g.at).take(5).reverse()
  let form = fg.map(g => (g.home.abbr ?? "") == tm.abbr ? (g.home.winner ? "V" : g.away.winner ? "D" : "N") : (g.away.winner ? "V" : g.home.winner ? "D" : "N"))
  Row { gap: 3; align: center; padding: [3, 2]; radius: 6; background: linear(0, 0, 1, 0, [alpha(tc, tm.ours == null ? 0.12 : 0.24), alpha(background, 0.0)])
    Box { width: 3; height: 18; radius: 1.5; background: tm.zone == "green" ? "#22c55e" : tm.zone == "blue" ? "#3b82f6" : tm.zone == "orange" ? "#f59e0b" : tm.zone == "red" ? "#ef4444" : rgb(0, 0, 0, 0) }
    Text { text: tm.rank; width: 30; style: label; color: muted; align: end; maxLines: 1 }
    Box { size: 16; radius: 4; background: alpha(muted, 0.18) if crest == "" { Text { text: sub(tm.abbr, 0, 2); style: label; color: muted; align: center } } else { Image { src: "~/.cache/espn-logos/soccer/${crest}"; size: 16; fit: contain; label: tm.name } } }
    Text { text: tm.name; weight: 1; style: small; color: tm.ours == null ? mix(tc, foreground, 0.35) : accent; bold: tm.ours != null; maxLines: 1 }
    Text { text: tm.played; width: 17; style: label; color: muted; align: end; maxLines: 1 }
    Text { text: tm.won; width: 14; style: label; color: muted; align: end; maxLines: 1 }
    Text { text: tm.drawn; width: 14; style: label; color: muted; align: end; maxLines: 1 }
    Text { text: tm.lost; width: 14; style: label; color: muted; align: end; maxLines: 1 }
    Text { text: tm.gd > 0 ? "+${tm.gd}" : "${tm.gd}"; width: 23; style: label; color: muted; align: end; maxLines: 1 }
    Text { text: tm.pts; width: 22; style: small; bold: true; color: foreground; align: end; maxLines: 1 }
    Text { spans: form.map(r => ({text: r, color: r == "V" ? "#22c55e" : r == "D" ? "#ef4444" : "#f59e0b"})); style: label; width: 48; align: center; maxLines: 1; letterSpacing: 2 }
  }
}
component Chips(form) {
  let parts = split(form, " ")
  Row { gap: 3
    if form == "" { Text { text: "—"; style: small; color: muted } }
    for i in range(count(parts)) key i {
      let col = parts[i] == "V" ? "#22c55e" : parts[i] == "D" ? "#ef4444" : "#f59e0b"
      Box { size: 26; radius: 9; align: center; background: linear(0, 0, 0, 1, [mix(col, foreground, 0.12), alpha(col, 0.55)]); border: 1.5; borderColor: alpha(col, 0.55)
        Text { text: parts[i]; width: 26; align: center; fontSize: 12; bold: true; color: background; maxLines: 1 }
      }
    }
  }
}
component PmDuel(label, hv, av, hc, ac, hint = "", better = "high") {
  let hn = num(hv ?? 0, 0)
  let an = num(av ?? 0, 0)
  let hw = hv == null || av == null ? false : hn == an ? false : (better == "high" ? hn > an : hn < an)
  let aw = hv == null || av == null ? false : hn == an ? false : !hw
  let hCol = hw ? mix(hc, foreground, 0.18) : mix(muted, foreground, 0.38)
  let aCol = aw ? mix(ac, foreground, 0.18) : mix(muted, foreground, 0.38)
  let hBg = hw ? alpha(hc, 0.12) : alpha(foreground, 0.03)
  let aBg = aw ? alpha(ac, 0.12) : alpha(foreground, 0.03)
  Column { gap: 4
    Row { gap: 6; align: center
      Text { text: (hw ? "▲ " : "") + (hv == null ? "—" : replace(str(hv), ".", ",")); style: small; fontSize: 14; bold: hw; color: hCol; width: 78; align: end; maxLines: 1; padding: [3, 1]; radius: 5; background: hBg }
      Column { weight: 1; gap: 0; align: center
        Text { text: label; style: label; fontSize: 10; color: mix(muted, foreground, 0.55); align: center; maxLines: 1 }
        if hint != "" { Text { text: hint; fontSize: 8; color: better == "high" ? pmCLime : pmCAmber; align: center; maxLines: 1 } }
      }
      Text { text: (av == null ? "—" : replace(str(av), ".", ",")) + (aw ? " ▲" : ""); style: small; fontSize: 14; bold: aw; color: aCol; width: 78; maxLines: 1; padding: [3, 1]; radius: 5; background: aBg }
    }
    Row { gap: 2; height: 8
      Box { weight: max(hn, 0.2); height: 8; radius: 4; background: linear(0, 0, 1, 0, [alpha(hw ? hc : mix(hc, muted, 0.55), hw ? 1 : 0.5), alpha(hc, hw ? 0.42 : 0.14)]) }
      Box { weight: max(an, 0.2); height: 8; radius: 4; background: linear(0, 0, 1, 0, [alpha(aw ? ac : mix(ac, muted, 0.55), aw ? 1 : 0.5), alpha(ac, aw ? 0.42 : 0.14)]) }
    }
  }
}
component PmStack(hv, dv, av, hc, ac) {
  Column { gap: 3
    Row { gap: 2; height: 12
      Box { weight: max(hv, 0.1); height: 12; radius: 6; background: linear(0, 0, 0, 1, [mix(hc, foreground, 0.1), alpha(hc, 0.7)]) }
      Box { weight: max(dv, 0.1); height: 12; radius: 6; background: alpha(muted, 0.55) }
      Box { weight: max(av, 0.1); height: 12; radius: 6; background: linear(0, 0, 0, 1, [mix(ac, foreground, 0.1), alpha(ac, 0.7)]) }
    }
    Row { gap: 2; height: 2
      Box { weight: max(hv, 0.1); height: 2; radius: 1; background: alpha(foreground, 0.35) }
      Box { weight: max(dv, 0.1); height: 2; radius: 1; background: alpha(foreground, 0.18) }
      Box { weight: max(av, 0.1); height: 2; radius: 1; background: alpha(foreground, 0.35) }
    }
  }
}
component SignalPill(t, tone) {
  let c = tone == "bad" ? "#ef4444" : tone == "warn" ? "#f59e0b" : tone == "good" ? "#22c55e" : muted
  Text { text: t; style: label; bold: true; color: c; padding: [6, 1]; radius: 5; background: alpha(c, 0.12); maxLines: 1 }
}

component TrajectoryTeam(an, color, teamKey, t0, t1, span, logo, showDates) {
  Column { gap: 4; padding: 10; radius: 14; background: linear(0, 0, 1, 1, [alpha(color, 0.10), alpha(background, 0.35)]); border: 1; borderColor: alpha(color, 0.15)
    let cExp = "#fbbf24"
    let pmCGood = "#22c55e"
    let pmCBad = "#ef4444"
    let pmCWarn = "#f59e0b"
    let cNeutral = "#94a3b8"
    let cCup = "#c084fc"
    let phases = an.phases ?? []
    let points = (an.rolls ?? []).take(20)
    let n = count(points)
    let sel = pmSelTeam == teamKey ? (anSel == null ? -1 : anSel) : -1
    let selPoint = sel >= 0 && sel < n ? points[sel] : null
    let selPhase = selPoint == null ? null : first(phases.filter(ph => sel >= ph.start && sel <= ph.end))
    Row { gap: 6; align: center
      Box { size: 10; radius: 5; background: color }
      Text { text: an.name; style: small; bold: true; color: color; weight: 1; maxLines: 1 }
      SignalPill { t: an.signal; tone: an.tone }
      PmLegend { dot: false; label: "réel"; c: color }
      PmLegend { dot: false; label: "attendu"; c: cExp }
      Text { text: "↑ mieux"; style: label; fontSize: 8; bold: true; color: pmCLime; maxLines: 1 }
    }
    Box {
      fill: width
      height: 240
      Canvas {
        fill: width
        height: 240
        let s = points
        let n = count(s)
        let padL = 36
        let padR = 22
        let padT = 34
        let padB = 30
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        let spanT = max(t1 - t0, 1)
        let pG = s.map(p => [padL + (parseTime(p.d) - t0) / spanT * cw, padT + (span - p.gd) / (2 * span) * ch])
        let pX = s.map(p => [padL + (parseTime(p.d) - t0) / spanT * cw, padT + (span - p.xd) / (2 * span) * ch])
        if n == 0 { text("Pas de données", width / 2, height / 2, size: 10, align: center, color: muted) }
        else {
          
          for ph in phases key ph.start {
            let x1 = padL + (parseTime(s[ph.start].d) - t0) / spanT * cw
            let x2 = padL + (parseTime(s[ph.end].d) - t0) / spanT * cw
            let xc = (x1 + x2) / 2
            let w0 = x2 - x1
            let x1b = w0 < 6 ? xc - 3 : x1
            let x2b = w0 < 6 ? xc + 3 : x2
            let w = max(x2b - x1b, 6)
            let tone = ph.tone == "bad" ? pmCBad : ph.tone == "warn" ? pmCWarn : ph.tone == "good" ? pmCGood : cNeutral
            let lab = ph.short + " · " + ph.n + "m"
            rect(x1b, padT, w, ch, radius: 3, fill: alpha(tone, 0.10))
            line(x1b, padT, x1b, padT + ch, stroke: alpha(tone, 0.34), width: 1)
            rect(x1b, 4, w, 8, radius: 4, fill: alpha(tone, 0.92))
            if w > len(lab) * 4.6 + 10 { text(lab, x1b + w / 2, 22, size: 9, align: center, bold: true, color: tone) }
          }
          
          let step = span <= 0.9 ? 0.25 : span <= 1.8 ? 0.5 : 1
          let k = max(floor(span / step), 1)
          for i in range(-k, k + 1) {
            let v = i * step
            let yy = padT + (span - v) / (2 * span) * ch
            if v != 0 { line(padL, yy, padL + cw, yy, stroke: alpha(muted, 0.22), width: 1) }
            text((v > 0 ? "+" : "") + replace(fixed(v, step < 0.5 ? 2 : step < 1 ? 1 : 0), ".", ","), padL - 5, yy, size: 10, align: end, color: alpha(foreground, 0.66))
          }
          let zeroY = padT + span / (2 * span) * ch
          line(padL, zeroY, padL + cw, zeroY, stroke: alpha(foreground, 0.55), width: 1.6)
          text("0", padL - 5, zeroY, size: 10, align: end, bold: true, color: foreground)
          
          for i in range(n - 1) {
            let g1 = s[i].gd - s[i].xd
            let g2 = s[i + 1].gd - s[i + 1].xd
            let same = (g1 >= 0 && g2 >= 0) || (g1 <= 0 && g2 <= 0)
            if same { path([pG[i], pG[i + 1], pX[i + 1], pX[i]], closed: true, fill: alpha(g1 >= 0 ? pmCGood : pmCBad, 0.26)) }
          }
          
          if count(pG) > 1 { path(pG, stroke: alpha(color, 0.18), width: 10, cap: round) }
          if count(pG) > 1 { path(pG, stroke: alpha(background, 0.8), width: 4.6, cap: round) }
          if count(pG) > 1 { path(pG, stroke: color, width: 2.8, cap: round) }
          for i in range(n - 1) {
            let x1 = pX[i][0]
            let y1 = pX[i][1]
            let x2 = pX[i + 1][0]
            let y2 = pX[i + 1][1]
            for k2 in range(6) {
              if k2 % 2 == 0 { line(x1 + (x2 - x1) * k2 / 6, y1 + (y2 - y1) * k2 / 6, x1 + (x2 - x1) * (k2 + 1) / 6, y1 + (y2 - y1) * (k2 + 1) / 6, stroke: alpha(background, 0.8), width: 3.6) }
            }
            for k2 in range(6) {
              if k2 % 2 == 0 { line(x1 + (x2 - x1) * k2 / 6, y1 + (y2 - y1) * k2 / 6, x1 + (x2 - x1) * (k2 + 1) / 6, y1 + (y2 - y1) * (k2 + 1) / 6, stroke: cExp, width: 2) }
            }
          }
          for i in range(n) { circle(pX[i][0], pX[i][1], 2.2, fill: alpha(background, 0.85)) }
          for i in range(n) { circle(pX[i][0], pX[i][1], 1.5, fill: cExp) }
          
          for i in range(n) {
            let xx = pG[i][0]
            let yy = pG[i][1]
            let lg = s[i].logo ?? ""
            circle(xx, yy, 8.4, fill: alpha(background, 0.9))
            text(sub(s[i].o ?? "", 0, 3), xx, yy, size: 6, align: center, bold: true, color: foreground)
            if lg != "" { image("~/.cache/espn-logos/soccer/" + lg, xx - 6, yy - 6, 12, 12) }
            else { circle(xx, yy, 5.2, fill: alpha(color, 0.8)) }
            circle(xx, yy, 8.4, stroke: s[i].cup ? cCup : alpha(color, 0.85), width: s[i].cup ? 1.6 : 1.2)
          }
          if n > 0 {
            let lpx = pG[n - 1][0]
            let lpy = pG[n - 1][1]
            circle(lpx, lpy, 14, stroke: alpha(color, 0.35), width: 2)
          }
          
          
          if an.lastCross != null {
            let xx = padL + (parseTime(s[an.lastCross.i].d) - t0) / spanT * cw
            line(xx, padT, xx, padT + ch, stroke: alpha(an.lastCross.dir == "down" ? pmCBad : pmCGood, 0.26), width: 1)
            text(an.lastCross.dir == "down" ? "▾" : "▴", xx, padT + 10, size: 10, align: center, color: an.lastCross.dir == "down" ? pmCBad : pmCGood)
          }
          
          if sel >= 0 && sel < n {
            let sx = pG[sel][0]
            let sy = pG[sel][1]
            line(sx, padT, sx, padT + ch, stroke: alpha(foreground, 0.45), width: 1.2)
            circle(sx, sy, 9.5, stroke: foreground, width: 2)
            circle(pX[sel][0], pX[sel][1], 4, stroke: foreground, width: 1.5)
          }
          
          for i in range(5) {
            let t = t0 + spanT * i / 4
            let xx = padL + (t - t0) / spanT * cw
            line(xx, padT, xx, padT + ch, stroke: alpha(muted, 0.10), width: 1)
            if showDates {
              line(xx, padT + ch, xx, padT + ch + 3, stroke: alpha(muted, 0.25), width: 1)
              let al = i == 0 ? "start" : i == 4 ? "end" : "center"
              text(fmtTime(t, "d MMM"), xx, height - 6, size: 10, align: al, color: muted)
            }
          }
          line(padL, padT + ch, padL + cw, padT + ch, stroke: alpha(muted, 0.2), width: 1)
        }
      }
      Row {
        fill: width
        height: 240
        padding: [34, 22, 30, 36]
        for i in range(n) key i {
          let tprev = i == 0 ? t0 : (parseTime(points[i].d) + parseTime(points[max(i - 1, 0)].d)) / 2
          let tnext = i == n - 1 ? t1 : (parseTime(points[i].d) + parseTime(points[min(i + 1, n - 1)].d)) / 2
          Box { weight: max(tnext - tprev, 1); height: 176; ripple: false; onTap: { haptic(); anSel = i; pmSelTeam = teamKey } }
        }
      }
    }
    if pmSelTeam == teamKey && selPoint != null {
      let sp = selPoint
      let st = selPhase == null ? cNeutral : selPhase.tone == "bad" ? pmCBad : selPhase.tone == "warn" ? pmCWarn : selPhase.tone == "good" ? pmCGood : cNeutral
      Column { gap: 4; padding: 10; radius: 8; background: alpha(st, 0.10)
        Row { gap: 8; align: center
          if sp.logo != "" { Image { src: "~/.cache/espn-logos/soccer/" + sp.logo; size: 30; fit: contain; label: sp.on } }
          else { Box { size: 30; radius: 15; align: center; background: alpha(color, 0.25) Text { text: sub(sp.o ?? "", 0, 3); style: label; bold: true; color: foreground; align: center } } }
          Column { weight: 1; gap: 0
            Text { text: fmtTime(parseTime(sp.d), "EEE d MMM yyyy") + (sp.cup ? " · " + (sp.comp != "" ? sp.comp : "Coupe") : ""); style: label; color: sp.cup ? cCup : muted; maxLines: 1 }
            Text { text: (sp.home ? "à domicile" : "à l'extérieur") + " contre " + (sp.on != "" ? sp.on : sp.o); style: small; bold: true; color: foreground; maxLines: 1 }
          }
          Text { text: "✕"; style: small; color: muted; padding: [8, 4]; onTap: anSel = -1 }
        }
        Row { gap: 8; align: center
          Text { text: "Résultat"; style: label; color: muted }
          Text { text: sp.r; style: small; bold: true; color: sp.r == "V" ? pmCGood : sp.r == "D" ? pmCBad : pmCWarn }
          Text { text: sp.gf + " – " + sp.ga; style: small; bold: true; color: foreground }
          if sp.cup { Text { text: "xG indisponible"; style: label; color: cCup; weight: 1; align: end; maxLines: 1 } } else { Text { text: "xG " + replace(fixed(sp.xgm, 2), ".", ",") + " · xGA " + replace(fixed(sp.xam, 2), ".", ","); style: label; color: muted; weight: 1; align: end; maxLines: 1 } }
        }
        Text { text: "Moyenne 5 matchs · réel " + (sp.gd > 0 ? "+" : "") + replace(fixed(sp.gd, 2), ".", ",") + " · attendu " + (sp.xd > 0 ? "+" : "") + replace(fixed(sp.xd, 2), ".", ",") + " · écart " + (sp.gd - sp.xd > 0 ? "+" : "") + replace(fixed(sp.gd - sp.xd, 2), ".", ","); style: label; color: muted; maxLines: 2 }
        if sp.cup { Text { text: "Attendu = forme xG du championnat"; style: label; color: muted; maxLines: 1 } }
        if selPhase != null { Text { text: selPhase.short + " — " + (selPhase.shortCopy ?? ""); style: label; color: st; maxLines: 1 } }
      }
    }
  }
}
component TrajectoryBoth(anH, anA, hc, ac, hLogo, aLogo) {
  let hs = anH.rolls ?? []
  let as = anA.rolls ?? []
  let pmAll = flatten([hs, as])
  let n = count(pmAll)
  if n == 0 {
    Text { text: "Pas de données de trajectoire."; style: label; color: muted; maxLines: 1 }
  } else {
    let t0 = reduce(pmAll, (m, p) => min(m, parseTime(p.d)), parseTime(first(pmAll).d))
    let t1 = reduce(pmAll, (m, p) => max(m, parseTime(p.d)), parseTime(first(pmAll).d))
    let vals = flatten([hs.map(p => p.gd), hs.map(p => p.xd), as.map(p => p.gd), as.map(p => p.xd)])
    let vmin = reduce(vals, (m, v) => min(m, v), 0)
    let vmax = reduce(vals, (m, v) => max(m, v), 0)
    let span = max(max(abs(vmin), abs(vmax), 0.45), 0.45)
    let hg = anH.gap5 ?? 0
    let ht = anH.trendXgd ?? 0
    let ag = anA.gap5 ?? 0
    let at = anA.trendXgd ?? 0
    let hVerdict = hg >= 0.5 && ht > 0.15 ? anH.name + " surperforme nettement et monte : le réel dépasse l'attendu et l'écart se creuse." : hg >= 0.5 && ht < -0.15 ? anH.name + " surperforme encore, mais la dynamique se tasse : la réussite n'est plus soutenue par la progression du jeu." : hg <= -0.5 && ht < -0.15 ? anH.name + " sous-performe et décroche : le jeu produit moins que les résultats ne le laissent croire." : hg <= -0.5 && ht > 0.15 ? anH.name + " sous-performe mais se redresse : l'écart se réduit, la tendance est meilleure que le niveau affiché." : ht >= 0.3 ? anH.name + " monte : le niveau attendu progresse nettement sur les derniers matchs." : ht <= -0.3 ? anH.name + " décroche : le niveau attendu baisse nettement et les résultats risquent de suivre." : abs(hg) <= 0.15 ? anH.name + " est fidèle à son jeu : les résultats suivent de près les xG." : hg > 0 ? anH.name + " vit sur un léger surplus de réalisme : les résultats sont un peu au-dessus du jeu." : anH.name + " manque légèrement de réalisme : les résultats sont un peu en dessous du jeu."
    let hPhaseTxt = anH.tone == "bad" ? (ht <= 0 ? " La phase en cours est mauvaise et confirme le coup de moins bien." : " La phase en cours est mauvaise, malgré une tendance qui se redresse.") : anH.tone == "good" ? (ht > 0 ? " La phase en cours est bonne et va dans le sens de la progression." : " La phase en cours est bonne, ce qui valide le niveau affiché.") : anH.tone == "warn" ? " La phase en cours est mitigée : la lecture demande confirmation." : ""
    let aVerdict = ag >= 0.5 && at > 0.15 ? anA.name + " surperforme nettement et monte : le réel dépasse l'attendu et l'écart se creuse." : ag >= 0.5 && at < -0.15 ? anA.name + " surperforme encore, mais la dynamique se tasse : la réussite n'est plus soutenue par la progression du jeu." : ag <= -0.5 && at < -0.15 ? anA.name + " sous-performe et décroche : le jeu produit moins que les résultats ne le laissent croire." : ag <= -0.5 && at > 0.15 ? anA.name + " sous-performe mais se redresse : l'écart se réduit, la tendance est meilleure que le niveau affiché." : at >= 0.3 ? anA.name + " monte : le niveau attendu progresse nettement sur les derniers matchs." : at <= -0.3 ? anA.name + " décroche : le niveau attendu baisse nettement et les résultats risquent de suivre." : abs(ag) <= 0.15 ? anA.name + " est fidèle à son jeu : les résultats suivent de près les xG." : ag > 0 ? anA.name + " vit sur un léger surplus de réalisme : les résultats sont un peu au-dessus du jeu." : anA.name + " manque légèrement de réalisme : les résultats sont un peu en dessous du jeu."
    let aPhaseTxt = anA.tone == "bad" ? (at <= 0 ? " La phase en cours est mauvaise et confirme le coup de moins bien." : " La phase en cours est mauvaise, malgré une tendance qui se redresse.") : anA.tone == "good" ? (at > 0 ? " La phase en cours est bonne et va dans le sens de la progression." : " La phase en cours est bonne, ce qui valide le niveau affiché.") : anA.tone == "warn" ? " La phase en cours est mitigée : la lecture demande confirmation." : ""
    let hFacts = "Écart " + (hg > 0 ? "+" : "") + replace(fixed(hg, 2), ".", ",") + " · tendance xGD " + (ht > 0 ? "+" : "") + replace(fixed(ht, 2), ".", ",") + "."
    let aFacts = "Écart " + (ag > 0 ? "+" : "") + replace(fixed(ag, 2), ".", ",") + " · tendance xGD " + (at > 0 ? "+" : "") + replace(fixed(at, 2), ".", ",") + "."
    let dt = ht - at
    let dg = hg - ag
    let key = abs(dt) >= 0.3 ? (dt > 0 ? anH.name + " arrive avec une dynamique nettement meilleure (" + (dt > 0 ? "+" : "") + replace(fixed(dt, 2), ".", ",") + " d'écart de tendance) : si elle impose son rythme, c'est une clé du match." : anA.name + " arrive avec une dynamique nettement meilleure (" + (-dt > 0 ? "+" : "") + replace(fixed(-dt, 2), ".", ",") + " d'écart de tendance) : si elle impose son rythme, c'est une clé du match.") : dg >= 0.5 && hg >= 0.3 && ag <= -0.3 ? anH.name + " surperforme quand " + anA.name + " sous-performe : si la réussite de " + anH.name + " retombe, " + anA.name + " peut renverser la logique." : dg <= -0.5 && ag >= 0.3 && hg <= -0.3 ? anA.name + " surperforme quand " + anH.name + " sous-performe : si la réussite de " + anA.name + " retombe, " + anH.name + " peut renverser la logique." : ht > 0.2 && at > 0.2 ? "Les deux équipes montent : la trajectoire ne départage pas. Le duel se jouera sur la capacité à maintenir ce niveau." : ht < -0.2 && at < -0.2 ? "Les deux équipes décrochent : match à réaction. La première qui stabilise son jeu reprend l'avantage." : ""
    Column { gap: 6
      TrajectoryTeam { an: anH; color: hc; teamKey: "h"; t0: t0; t1: t1; span: span; logo: hLogo; showDates: true }
      TrajectoryTeam { an: anA; color: ac; teamKey: "a"; t0: t0; t1: t1; span: span; logo: aLogo; showDates: true }
      Flow { gap: 10; align: center
        PmLegend { dot: false; label: anH.abbr + " réel"; c: hc }
        PmLegend { dot: false; label: anA.abbr + " réel"; c: ac }
        PmLegend { dot: false; label: "attendu (xG)"; c: pmCAmber }
        PmLegend { dot: true; label: "championnat"; c: alpha(muted, 0.45) }
        PmLegend { dot: true; label: "coupe"; c: pmCViolet }
        PmLegend { dot: true; label: "au-dessus"; c: pmCGood }
        PmLegend { dot: true; label: "en dessous"; c: pmCBad }
      }
      Reading { pmVerdict: hVerdict + hPhaseTxt; facts: hFacts; c: hc; conf: (anH.seriesN >= 8 ? "élevée" : anH.seriesN >= 5 ? "moyenne" : "faible") }
      Reading { pmVerdict: aVerdict + aPhaseTxt; facts: aFacts; c: ac; conf: (anA.seriesN >= 8 ? "élevée" : anA.seriesN >= 5 ? "moyenne" : "faible") }
      KeyRead { key: key; c: pmCPink }
      Text { text: "Touche un point pour le détail du match · même axe de dates pour les deux équipes"; style: label; color: muted; align: center; maxLines: 2 }
    }
  }
}


component MatchMap(an, color) {
  Column { gap: 4; padding: 10; radius: 14; background: linear(0, 0, 1, 1, [alpha(color, 0.10), alpha(background, 0.35)]); border: 1; borderColor: alpha(color, 0.15)
    let allPts = (an.rolls ?? []).filter(p => p.xgm != null && p.xam != null)
    let pts = drop(allPts, max(count(allPts) - 10, 0))
    if count(pts) == 0 {
      Text { text: "Pas de matchs avec xG disponibles."; style: label; color: muted; maxLines: 2 }
    } else {
      let n = count(pts)
      let wins = count(pts.filter(p => p.r == "V"))
      let draws = count(pts.filter(p => p.r == "N"))
      let losses = count(pts.filter(p => p.r == "D"))
      let avgC = avg(pts.map(p => p.xgm))
      let avgA = avg(pts.map(p => p.xam))
      let dom = pts.filter(p => p.xgm >= p.xam + 0.35)
      let suf = pts.filter(p => p.xam >= p.xgm + 0.35)
      let nd = pts.filter(p => p.xgm <= p.xam)
      let low = pts.filter(p => p.xgm < 1.3 && p.xam < 1.3)
      let open = pts.filter(p => p.xgm > 1.6 && p.xam > 1.6)
      let domW = count(dom.filter(p => p.r == "V"))
      let sufL = count(suf.filter(p => p.r == "D"))
      let lowW = count(low.filter(p => p.r == "V"))
      let openW = count(open.filter(p => p.r == "V"))
      let ndPPG = count(nd) == 0 ? 0 : sum(nd.map(p => p.r == "V" ? 3 : p.r == "N" ? 1 : 0)) / count(nd)
      let pmVerdict = count(nd) >= 2 && ndPPG <= 0.8
        ? an.name + " ne sait pas souffrir : dès qu'elle ne domine pas les xG, elle perd ou presque (" + replace(fixed(ndPPG, 1), ".", ",") + " pt/match)."
        : count(low) >= 2 && lowW * 2 >= count(low) && count(suf) >= 2
          ? an.name + " gagne en bloc bas : elle souffre, concède des occasions, mais convertit ses rares temps forts."
          : count(dom) >= 2 && domW * 2 >= count(dom)
            ? an.name + " gagne en maîtrisant : quand elle domine les xG, elle convertit le plus souvent."
            : count(open) >= 2 && openW * 2 >= count(open)
              ? an.name + " vit des matchs ouverts : elle gagne en outscorant, mais concède autant qu'elle crée."
              : count(suf) >= 2 && sufL * 2 >= count(suf)
                ? an.name + " subit : quand l'adversaire crée plus, elle perd la plupart du temps."
                : "Profil équilibré : les résultats suivent à peu près les xG."
      let homePts = pts.filter(p => p.home == true)
      let awayPts = pts.filter(p => p.home != true)
      let homeW = count(homePts.filter(p => p.r == "V"))
      let awayW = count(awayPts.filter(p => p.r == "V"))
      let splitTxt = count(homePts) > 0 || count(awayPts) > 0 ? " · domicile " + homeW + "/" + count(homePts) + " · extérieur " + awayW + "/" + count(awayPts) : ""
      let facts = n + " matchs · " + wins + "V-" + draws + "N-" + losses + "D · " + replace(fixed(avgC, 2), ".", ",") + " xG créé / " + replace(fixed(avgA, 2), ".", ",") + " concédé · " + count(dom) + " dominés / " + count(suf) + " subis" + splitTxt
      Row { gap: 8; align: center
        Box { size: 10; radius: 5; background: color }
        Text { text: an.name; style: small; bold: true; color: color; weight: 1; maxLines: 1 }
        Text { text: "xG créé vs xG concédé"; style: label; color: muted; maxLines: 1 }
      }
      Canvas {
        fill: width
        height: 300
        let padL = 42
        let padR = 12
        let padT = 26
        let padB = 36
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        rect(padL, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCBad, 0.06))
        rect(padL + cw / 2, padT, cw / 2, ch / 2, radius: 2, fill: alpha(pmCAmber, 0.05))
        rect(padL, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(foreground, 0.02))
        rect(padL + cw / 2, padT + ch / 2, cw / 2, ch / 2, radius: 2, fill: alpha(pmCGood, 0.06))
        for v in [0, 1, 2, 3, 4] {
          line(padL + v / 4 * cw, padT, padL + v / 4 * cw, padT + ch, stroke: alpha(muted, 0.20), width: 1)
          text("${v}", padL + v / 4 * cw, padT + ch + 14, size: 10, align: center, color: muted)
          line(padL, padT + (4 - v) / 4 * ch, padL + cw, padT + (4 - v) / 4 * ch, stroke: alpha(muted, 0.20), width: 1)
          text("${v}", padL - 6, padT + (4 - v) / 4 * ch, size: 10, align: end, color: muted)
        }
        line(padL, padT + ch, padL + cw, padT, stroke: alpha(pmCCyan, 0.55), width: 1.6)
        text("équilibre", padL + cw / 2, padT + ch / 2 + 2, size: 8, align: center, bold: true, color: alpha(pmCCyan, 0.85))
        text("SUBI", padL + 8, padT + 14, size: 8, align: start, bold: true, color: pmCBad)
        text("MATCH OUVERT", padL + cw - 8, padT + 14, size: 8, align: end, bold: true, color: pmCAmber)
        text("BLOC BAS", padL + 8, padT + ch - 6, size: 8, align: start, bold: true, color: alpha(foreground, 0.55))
        text("DOMINATION", padL + cw - 8, padT + ch - 6, size: 8, align: end, bold: true, color: pmCGood)
        for p in pts {
          let xx = padL + clamp(p.xgm, 0, 4) / 4 * cw
          let yy = padT + (4 - clamp(p.xam, 0, 4)) / 4 * ch
          let col = p.r == "V" ? pmCGood : p.r == "D" ? pmCBad : pmCWarn
          let rr = 5 + min(abs(p.gf - p.ga), 3) * 1.2
          circle(xx, yy, rr + 6, fill: alpha(col, 0.10))
          circle(xx, yy, rr + 2, fill: alpha(background, 0.92), stroke: col, width: 1.6)
          if p.logo != "" { image("~/.cache/espn-logos/soccer/" + p.logo, xx - 7, yy - 7, 14, 14) }
          else { circle(xx, yy, rr, fill: alpha(col, 0.85)) }
          if p.d == last(pts).d { circle(xx, yy, rr + 4, stroke: foreground, width: 1.5) }
        }
        let last3 = reverse(pts).take(3)
        for p in last3 {
          let xx = padL + clamp(p.xgm, 0, 4) / 4 * cw
          let yy = padT + (4 - clamp(p.xam, 0, 4)) / 4 * ch
          text(sub(p.o ?? "", 0, 3), xx + 8, yy - 8, size: 9, align: start, bold: true, color: muted)
        }
        text("xG créé →", padL + cw / 2, height - 5, size: 10, align: center, bold: true, color: pmCCyan)
        text("↑ xGA concédé", padL, padT - 10, size: 9, align: start, bold: true, color: pmCBad)
      }
      Text { text: "Chaque point = un match · vert = victoire · jaune = nul · rouge = défaite · taille = |buts| · diagonale = match équilibré"; style: label; color: muted; align: center; maxLines: 2 }
      Reading { pmVerdict: pmVerdict; facts: facts; c: color; conf: (n >= 8 ? "élevée" : n >= 5 ? "moyenne" : "faible") }
    }
  }
}




component Fixture(g, team) {
  let fhc = pmColors == null ? accent : (get(pmColors, (g.home.logo ?? ""), null) == null ? accent : get(get(pmColors, (g.home.logo ?? ""), {}), "c", accent))
  let fac = pmColors == null ? accent : (get(pmColors, (g.away.logo ?? ""), null) == null ? accent : get(get(pmColors, (g.away.logo ?? ""), {}), "c", accent))
  let picked = handoff != null && (handoff.id ?? "") == (g.id ?? "")
  Box {
    fill: width
    padding: [5, 7]
    radius: 9
    background: linear(0, 0, 1, 0, [alpha(fhc, picked ? 0.34 : 0.20), alpha(background, 0.30), alpha(fac, picked ? 0.34 : 0.20)])
    border: picked ? 2 : 1
    borderColor: picked ? pmCCyan : alpha(mix(fhc, fac, 0.5), 0.20)
    onTap: { haptic(); run("printf '%s' "+sh(toJson(g))+" > ~/.cache/prematch-match.json"); handoff = g; pmTab = "overview"; anView = "resume"; anSel = -1; anTeam = "h"; pmSelTeam = "h" }
    Row { gap: 5; align: center
      Box { width: 3; height: 20; radius: 1.5; background: (g.home.abbr ?? "") == team ? pmCGood : pmCAmber }
      Column { weight: 1; gap: 1
        Text { text: fmtTime(g.at, "EEE d MMM HH:mm") + " · " + (g.tag ?? ""); style: label; color: picked ? pmCCyan : muted; maxLines: 1 }
        Text { text: ((g.home.abbr ?? "") == team ? (g.away.name ?? g.away.abbr ?? "") : (g.home.name ?? g.home.abbr ?? "")); style: small; color: foreground; maxLines: 1 }
      }
      Text { text: (g.home.abbr ?? "") == team ? "DOM" : "EXT"; style: label; fontSize: 8; bold: true; color: (g.home.abbr ?? "") == team ? pmCGood : pmCAmber; padding: [2, 4]; radius: 4; background: alpha((g.home.abbr ?? "") == team ? pmCGood : pmCAmber, 0.12); maxLines: 1 }
      Text { text: "›"; style: label; fontSize: 15; bold: true; color: picked ? pmCCyan : mix(muted, foreground, 0.35); maxLines: 1 }
    }
  }
}

when pmSelected != null && pmSelected.id != null && pmSelected.state == "pre" && (pmSelected.id ?? "") != snapId && fdhA != null && fdaA != null {
  let snap = {
    id: pmSelected.id,
    league: pmSelected.league,
    at: pmSelected.at,
    ts: pmNow,
    home: pmSelected.home,
    away: pmSelected.away,
    lh: max((calLh == null ? (fdhA.xg5 + fdaA.xga5) / 2 : calLh) + adjH, 0.2),
    la: max((calLa == null ? (fdaA.xg5 + fdhA.xga5) / 2 : calLa) + adjA, 0.2),
    temp: calTemp,
    blend: 1,
    market: pmNoVig,
    raw: {
      h: { xg5: fdhA.xg5, xga5: fdhA.xga5, gd5: fdhA.gd5, xgd5: fdhA.xgd5, shots: fdhA.shots, xps: fdhA.xps, fin: fdhA.fin, ppda5: fdhA.style == null ? null : fdhA.style.ppda5, share5: fdhA.style == null ? null : fdhA.style.share5, gap5: fdhA.deserved == null ? null : fdhA.deserved.ppm - fdhA.deserved.xppm },
      a: { xg5: fdaA.xg5, xga5: fdaA.xga5, gd5: fdaA.gd5, xgd5: fdaA.xgd5, shots: fdaA.shots, xps: fdaA.xps, fin: fdaA.fin, ppda5: fdaA.style == null ? null : fdaA.style.ppda5, share5: fdaA.style == null ? null : fdaA.style.share5, gap5: fdaA.deserved == null ? null : fdaA.deserved.ppm - fdaA.deserved.xppm }
    }
  }
  run("printf '%s' " + sh(toJson(snap)) + " | python3 ~/.config/omalauncher/widgets/prematch-preds.py save " + sh(pmSelected.id))
  run("python3 ~/.config/omalauncher/widgets/prematch-synthesis.py ensure " + sh(pmSelected.id) + " >/dev/null 2>&1")
  if (pmSelected.league ?? "") == "uefa.nations" || (pmSelected.league ?? "") == "fifa.worldq.uefa" || (pmSelected.league ?? "") == "fifa.friendly" {
    run("sh ~/.config/omalauncher/widgets/fd-analysis.sh >/dev/null 2>&1 &")
  }
  snapId = pmSelected.id
}

every 10m {
  if hero != null && synText == "" && synStatus != "running" {
    run("python3 ~/.config/omalauncher/widgets/prematch-synthesis.py ensure " + sh(hero.id ?? "") + " >/dev/null 2>&1")
  }
}

source amNow = clock every 1m
source preds = cmd("python3 ~/.config/omalauncher/widgets/prematch-preds.py list") every 5m json timeout 30s
source amCal = cmd("python3 ~/.config/omalauncher/widgets/prematch-preds.py calibrate") every 10m json timeout 30s
source amSelected = file("~/.cache/prematch-match.json") json
source request = file("~/.cache/apres-match-request.json") json

state sel = ""
state amTab = "resume"
let tabKnown = amTab == "resume" || amTab == "stats"
let tabShown = tabKnown ? amTab : "resume"

let amCCyan = "#5eead4"
let amCPink = "#f472b6"
let amCAmber = "#f59e0b"
let amCViolet = "#b79cff"
let amCLime = "#a3e635"
let amCGood = "#22c55e"
let amCBad = "#ef4444"
let amCWarn = "#f59e0b"
let amCSky = "#38bdf8"
let amHColor = amCCyan
let amAColor = amCPink
let amHText = mix(amHColor, foreground, 0.3)
let amAText = mix(amAColor, foreground, 0.3)

let list = preds ?? []
let finished = list.filter(p => (p.actual ?? {}).found == true).sortBy(p => -(p.at ?? 0))
let pending = list.filter(p => (p.actual ?? {}).found != true).sortBy(p => p.at ?? 0)
let ordered = flatten([finished, pending])
let fallback = amSelected != null && amSelected.id != null ? amSelected.id : ""
let req = request != null && request.id != null ? request.id : ""
let explicit = sel != "" || req != ""
let requested = sel != "" ? sel : (req != "" ? req : (ordered.any(p => p.id == fallback) ? fallback : ""))
let amCur = requested == "" ? (count(ordered) > 0 ? first(ordered) : null) : (ordered.find(p => p.id == requested) ?? (explicit ? null : (count(ordered) > 0 ? first(ordered) : null)))
let curId = amCur == null ? "" : amCur.id
let amHAbbr = amCur == null ? "" : (amCur.home.abbr ?? "")
let amAAbbr = amCur == null ? "" : (amCur.away.abbr ?? "")
let hasActual = amCur != null && (amCur.actual ?? {}).found == true
let hasPrediction = amCur != null && amCur.noPrediction != true && amCur.lh != null
let ev = amCur == null ? null : (amCur.eval ?? null)
let predFav = amCur == null ? "" : (amCur.h >= amCur.d && amCur.h >= amCur.a ? "1" : amCur.a >= amCur.d ? "2" : "N")
let resLabel = hasActual ? ((amCur.actual.result ?? "") == "H" ? "1" : (amCur.actual.result ?? "") == "A" ? "2" : "N") : "—"
let hit = ev != null && ev.hit == true
let xgDone = ev != null && ev.xErrH != null && ev.xErrA != null
let predFavShort = predFav == "1" ? "1 (dom.)" : predFav == "2" ? "2 (ext.)" : "N (nul)"
let predFavTxt = predFav == "1" ? "1 (domicile)" : predFav == "2" ? "2 (extérieur)" : "N (nul)"
let resFavTxt = resLabel == "1" ? "1 (domicile)" : resLabel == "2" ? "2 (extérieur)" : "N (nul)"
let scorePred = amCur == null ? "" : (amCur.best ?? "—")
let scoreReal = hasActual ? ((amCur.actual.gf ?? 0) + "-" + (amCur.actual.ga ?? 0)) : "—"
let scoreHit = hasActual && scorePred == scoreReal
let brierTxt = ev == null || ev.marketBrier == null ? "" : " Brier modèle " + replace(fixed(ev.brier, 3), ".", ",") + " vs marché " + replace(fixed(ev.marketBrier, 3), ".", ",") + (ev.brier < ev.marketBrier ? " : le modèle fait mieux." : ev.brier > ev.marketBrier ? " : le marché fait mieux." : " : égalité.")
let overTxt = hasActual && ev != null && ev.overHit == false && abs((amCur.over ?? 0) - 0.5) > 0.08 ? " Le scénario +2,5 a été manqué." : ""
let bttsTxt = hasActual && ev != null && ev.bttsHit == false && abs((amCur.btts ?? 0) - 0.5) > 0.08 ? " Le « les deux marquent » a été manqué." : ""
let amVerdict = amCur == null ? "" : !hasActual ? "Résultat en attente : la prédiction est enregistrée, le bilan arrivera après le coup de sifflet." : "Score prédit " + scorePred + ", réel " + scoreReal + " : " + (scoreHit ? "score exact réussi." : "score exact manqué.") + " " + (hit ? "L'issue la plus probable du modèle " + predFavShort + " s'est produite." : "L'issue la plus probable du modèle " + predFavShort + " ne s'est pas produite.") + brierTxt + overTxt + bttsTxt
let simpleVerdict = amCur == null ? "" : !hasActual ? "Le bilan arrivera après le coup de sifflet." : "Score " + (scoreHit ? "réussi" : "manqué") + " · " + scorePred + " annoncé, " + scoreReal + " réel. Pronostic " + (hit ? "juste" : "manqué") + " · " + predFavShort + " annoncé. " + (ev == null || ev.marketBrier == null ? "" : (ev.brier < ev.marketBrier ? "Le modèle a mieux lu les probabilités que les cotes." : ev.brier > ev.marketBrier ? "Les cotes ont mieux lu les probabilités que le modèle." : "Modèle et cotes à égalité sur les probabilités."))
let heroTone = scoreHit && hit ? amCGood : (scoreHit || hit) ? amCWarn : amCBad
let heroHead = scoreHit && hit ? "Lecture parfaite" : scoreHit ? "Score exact, pronostic manqué" : hit ? "Pronostic juste, score manqué" : "Lecture manquée"
let heroText = amCur == null || !hasActual ? "En attente du résultat." : "Le modèle annonçait " + scorePred + " · issue " + predFavShort + ". Le match a fini " + scoreReal + " · " + resFavTxt + ". " + (ev == null || ev.marketBrier == null ? "" : (ev.brier < ev.marketBrier ? "Côté probabilités, il fait mieux que les cotes." : ev.brier > ev.marketBrier ? "Côté probabilités, les cotes font mieux." : "Côté probabilités, égalité avec les cotes."))
let calN = amCal == null ? 0 : (amCal.n ?? 0)

let amHStats = amCur == null ? {} : get((amCur.stats ?? {}), amHAbbr, {})
let amHName = amCur == null ? "" : (amCur.home.name ?? amCur.home.abbr ?? "")
let amAName = amCur == null ? "" : (amCur.away.name ?? amCur.away.abbr ?? "")
let amAStats = amCur == null ? {} : get((amCur.stats ?? {}), amAAbbr, {})
let amPossH = num(amHStats.possessionPct, 0)
let amPossA = num(amAStats.possessionPct, 0)
let amShotsH = num(amHStats.totalShots, 0)
let amShotsA = num(amAStats.totalShots, 0)
let amSotH = num(amHStats.shotsOnTarget, 0)
let amSotA = num(amAStats.shotsOnTarget, 0)
let amSotPctH = amShotsH > 0 ? amSotH / amShotsH * 100 : 0
let amSotPctA = amShotsA > 0 ? amSotA / amShotsA * 100 : 0
let amPassH = num(amHStats.totalPasses, 0)
let amPassA = num(amAStats.totalPasses, 0)
let amPassPctH = num(amHStats.passPct, 0) * 100
let amPassPctA = num(amAStats.passPct, 0) * 100
let amCrossH = num(amHStats.totalCrosses, 0)
let amCrossA = num(amAStats.totalCrosses, 0)
let amCornersH = num(amHStats.wonCorners, 0)
let amCornersA = num(amAStats.wonCorners, 0)
let amSavesH = num(amHStats.saves, 0)
let amSavesA = num(amAStats.saves, 0)
let amTacklesH = num(amHStats.totalTackles, 0)
let amTacklesA = num(amAStats.totalTackles, 0)
let amInterH = num(amHStats.interceptions, 0)
let amInterA = num(amAStats.interceptions, 0)
let amClearH = num(amHStats.totalClearance, 0)
let amClearA = num(amAStats.totalClearance, 0)
let amBlockedH = num(amHStats.blockedShots, 0)
let amBlockedA = num(amAStats.blockedShots, 0)
let amFoulsH = num(amHStats.foulsCommitted, 0)
let amFoulsA = num(amAStats.foulsCommitted, 0)
let amYellowH = num(amHStats.yellowCards, 0)
let amYellowA = num(amAStats.yellowCards, 0)
let amRedH = num(amHStats.redCards, 0)
let amRedA = num(amAStats.redCards, 0)
let amOffH = num(amHStats.offsides, 0)
let amOffA = num(amAStats.offsides, 0)
let amGF = amCur == null ? 0 : num(amCur.actual.gf, 0)
let amGA = amCur == null ? 0 : num(amCur.actual.ga, 0)
let amXgH = amCur == null ? null : amCur.actual.xgH
let amXgA = amCur == null ? null : amCur.actual.xgA
let amHasXg = amXgH != null && amXgA != null
let amXgCalcH = amHasXg ? amXgH : 1.2
let amXgCalcA = amHasXg ? amXgA : 1.2
let amFinH = amHasXg ? amGF - amXgH : null
let amFinA = amHasXg ? amGA - amXgA : null
let amConvH = amShotsH > 0 ? amGF / amShotsH * 100 : 0
let amConvA = amShotsA > 0 ? amGA / amShotsA * 100 : 0
let amPtsH = amGF > amGA ? 3 : amGF == amGA ? 1 : 0
let amPtsA = amGA > amGF ? 3 : amGA == amGF ? 1 : 0
let amFact = [1, 1, 2, 6, 24]
let amHp = range(5).map(k => pow(2.718281828, -max(amXgCalcH, 0.2)) * pow(max(amXgCalcH, 0.2), k) / amFact[k])
let amAp = range(5).map(k => pow(2.718281828, -max(amXgCalcA, 0.2)) * pow(max(amXgCalcA, 0.2), k) / amFact[k])
let amCells = flatten(range(5).map(i => range(5).map(j => { h: i, a: j, p: amHp[i] * amAp[j] })))
let amTot = sum(amCells.map(c => c.p))
let amHw = sum(amCells.filter(c => c.h > c.a).map(c => c.p)) / amTot
let amDr = sum(amCells.filter(c => c.h == c.a).map(c => c.p)) / amTot
let amAw = sum(amCells.filter(c => c.h < c.a).map(c => c.p)) / amTot
let amXptsH = amHasXg ? 3 * amHw + amDr : null
let amXptsA = amHasXg ? 3 * amAw + amDr : null
let amGoals = (amCur == null ? [] : (amCur.events ?? [])).filter(e => contains(lower(e.type ?? ""), "goal"))
let amRedEvents = (amCur == null ? [] : (amCur.events ?? [])).filter(e => contains(lower(e.type ?? ""), "red"))
let amFirstGoal = first(amGoals)
let amFirstRed = first(amRedEvents)
let amTurning = amFirstRed ?? amFirstGoal
let amTurningText = amTurning == null ? "Aucun tournant décisif enregistré." : amTurning.t + " · " + (amTurning.short ?? amTurning.text ?? "")
let amFdH = fdxh ?? null
let amFdA = fdxa ?? null
let amXgSource = amHasXg ? ((amCur.actual.xgSource ?? "") == "fotmob" ? "FotMob" : (amCur.actual.xgSource ?? "") == "football-data" ? "Football-Data" : "modèle du match") : "xG indisponible"

let labModel = (amCal ?? {}).model ?? {}
let labMarket = (amCal ?? {}).market ?? {}
let labProb = (amCal ?? {}).prob ?? {}
let labAdj = (amCal ?? {}).adj ?? {}
let labHist = (amCal ?? {}).history ?? []
let labHistCal = (amCal ?? {}).hist ?? null
let labModelH = labHistCal == null ? labModel : (labHistCal.model ?? labModel)
let labRel = (amCal ?? {}).reliability ?? []
let labTeams = (amCal ?? {}).teams ?? []
let labN = num(((amCal ?? {}).nTotal ?? (amCal ?? {}).n), 0)
let labXgN = num(((amCal ?? {}).xgNTotal ?? (amCal ?? {}).xgN), 0)
let labNFollowed = num((amCal ?? {}).n, 0)
let labMktN = num((amCal ?? {}).marketN, 0)
let labBrier = num(labModelH.brier, 0.667)
let labBrierRaw = num(labModelH.brierRaw, 0.667)
let labHit = num(labModelH.hit, 0)
let labMaeH = num(labModelH.maeH, 1)
let labMaeA = num(labModelH.maeA, 1)
let labBiasH = num(labModelH.biasH, 0)
let labBiasA = num(labModelH.biasA, 0)
let labMktBrier = labHistCal != null && labHistCal.model != null && labHistCal.model.brierMarket != null ? num(labHistCal.model.brierMarket, 0) : num(labMarket.brier, 0)
let labSkill = labProb.skill
let labTemp = num(labProb.temp, 1)
let labAdjH = num(labAdj.h, 0)
let labAdjA = num(labAdj.a, 0)
let labBrierS = labN == 0 ? 0 : clamp((0.667 - labBrier) / 0.217 * 100, 0, 100)
let labHitS = labN == 0 ? 0 : clamp((labHit - 0.33) / 0.27 * 100, 0, 100)
let labXgS = labXgN == 0 ? 0 : clamp((0.9 - max(labMaeH, labMaeA)) / 0.6 * 100, 0, 100) * clamp(labXgN / 6, 0.15, 1)
let labCovS = clamp(labN / 30 * 100, 0, 100)
let labMktS = labMktN == 0 ? 0 : clamp(50 + (labMktBrier - labBrier) * 500, 0, 100)
let labScore = round(labBrierS * 0.28 + labHitS * 0.20 + labXgS * 0.20 + labCovS * 0.17 + labMktS * 0.15)
let labTint = labScore >= 70 ? green : labScore >= 50 ? accent : labScore >= 30 ? yellow : orange
let labStatus = labN == 0 ? "En attente de mesure" : labScore >= 70 ? "Modèle solide" : labScore >= 50 ? "En progression continue" : labScore >= 30 ? "En consolidation" : "À consolider"
let labMood = labScore >= 70 ? "solide" : labScore >= 50 ? "en progression" : labScore >= 30 ? "en consolidation" : "fragile"
let labAlerts = (labN < 3 ? 1 : 0) + (labMktN > 0 && labBrier > labMktBrier ? 1 : 0) + (labXgN == 0 ? 1 : 0) + (labMaeH > 0.7 || labMaeA > 0.7 ? 1 : 0) + (labN == 0 ? 1 : 0)
let labBrierSeries0 = labHist.filter(h => h.brier != null).map(h => clamp(num(h.brier, 0) * 100, 0, 100))
let labHitSeries0 = labHist.filter(h => h.actH != null && h.actA != null && h.predH != null && h.predA != null).map(h => num(h.predH, 0) >= num(h.predA, 0) ? (num(h.actH, 0) > num(h.actA, 0) ? 100 : num(h.actH, 0) == num(h.actA, 0) ? 50 : 0) : (num(h.actA, 0) > num(h.actH, 0) ? 100 : num(h.actA, 0) == num(h.actH, 0) ? 50 : 0))
let labErrSeries0 = labHist.filter(h => h.actH != null && h.actA != null && h.predH != null && h.predA != null).map(h => clamp((abs(num(h.actH, 0) - num(h.predH, 0)) + abs(num(h.actA, 0) - num(h.predA, 0))) / 2 * 100, 0, 100))
let labBrierSeries = len(labBrierSeries0) >= 2 ? labBrierSeries0 : [0, 0]
let labHitSeries = len(labHitSeries0) >= 2 ? labHitSeries0 : [0, 0]
let labErrSeries = len(labErrSeries0) >= 2 ? labErrSeries0 : [0, 0]
let labFactP = { score: labBrierS, target: labBrierS < 40 ? 40 : labBrierS < 55 ? 55 : labBrierS < 70 ? 70 : labBrierS < 85 ? 85 : 100 }
let labHitP = { score: labHitS, target: labHitS < 40 ? 40 : labHitS < 55 ? 55 : labHitS < 70 ? 70 : labHitS < 85 ? 85 : 100 }
let labXgP = { score: labXgS, target: labXgS < 40 ? 40 : labXgS < 55 ? 55 : labXgS < 70 ? 70 : labXgS < 85 ? 85 : 100 }
let labCovP = { score: labCovS, target: labCovS < 40 ? 40 : labCovS < 55 ? 55 : labCovS < 70 ? 70 : labCovS < 85 ? 85 : 100 }
let labMktP = { score: labMktS, target: labMktS < 40 ? 40 : labMktS < 55 ? 55 : labMktS < 70 ? 70 : labMktS < 85 ? 85 : 100 }

component AmSectionTitle(t, c, sub) {
  Column { gap: 2
    Row { gap: 7; align: center; padding: [6, 4]; radius: 10; background: linear(0, 0, 1, 0, [alpha(c, 0.28), alpha(c, 0.04)]); border: 1; borderColor: alpha(c, 0.28)
      Box { width: 3; height: 20; radius: 1.5; background: c }
      Text { text: t; style: title; bold: true; color: mix(c, foreground, 0.25); maxLines: 1 }
    }
    if sub != "" { Text { text: "▸ " + sub; style: label; color: muted; maxLines: 2 } }
  }
}

component AmMetric(label, value, sub, c) {
  Column { weight: 1; gap: 1; padding: [7, 6]; radius: 8; align: center; background: alpha(c, 0.10); border: 1; borderColor: alpha(c, 0.20)
    Text { text: label; style: label; fontSize: 9; color: muted; align: center; maxLines: 1 }
    Text { text: value; style: small; bold: true; color: mix(c, foreground, 0.20); align: center; maxLines: 1 }
    if sub != "" { Text { text: sub; style: label; fontSize: 8; color: muted; align: center; maxLines: 1 } }
  }
}

component Compare(label, pv, rv, good, c) {
  Row { gap: 5; align: center; padding: [5, 7]; radius: 7; background: alpha(c, 0.06); border: 1; borderColor: alpha(c, 0.16)
    Text { text: label; style: label; color: muted; weight: 1; maxLines: 1 }
    Text { text: pv; style: label; color: muted; width: 78; align: end; maxLines: 1 }
    Text { text: "→"; style: label; color: muted; maxLines: 1 }
    Text { text: rv; style: label; bold: true; color: good == null ? foreground : good ? amCGood : amCBad; width: 78; align: end; maxLines: 1 }
  }
}


component AmBadge(label, ok, c) {
  Row { gap: 4; align: center; padding: [4, 7]; radius: 8; background: alpha(c, 0.12); border: 1; borderColor: alpha(c, 0.28)
    Text { text: ok == null ? "•" : ok ? "✓" : "✗"; style: label; bold: true; color: ok == null ? muted : ok ? amCGood : amCBad; maxLines: 1 }
    Text { text: label; style: label; color: muted; maxLines: 1 }
  }
}

component ProbBar(h, d, a, hc, ac) {
  Row { gap: 1; height: 8
    Box { weight: max(h * 100, 1); height: 8; radius: 3; background: alpha(hc, 0.85) }
    Box { weight: max(d * 100, 1); height: 8; radius: 3; background: alpha(amCViolet, 0.85) }
    Box { weight: max(a * 100, 1); height: 8; radius: 3; background: alpha(ac, 0.85) }
  }
}

component BrierDuel(model, market, cModel, cMarket) {
  let maxV = max(max(model, market), 0.01)
  Column { gap: 4
    Row { gap: 5; align: center
      Text { text: "Modèle"; style: label; width: 48; color: muted; maxLines: 1 }
      Row { weight: 1; height: 8
        Box { weight: max(model / maxV * 100, 1); height: 8; radius: 4; background: cModel }
        Box { weight: max(100 - model / maxV * 100, 1); height: 8; background: alpha(foreground, 0.04) }
      }
      Text { text: replace(fixed(model, 3), ".", ","); style: label; color: cModel; width: 44; align: end; maxLines: 1 }
    }
    Row { gap: 5; align: center
      Text { text: "Cotes"; style: label; width: 48; color: muted; maxLines: 1 }
      Row { weight: 1; height: 8
        Box { weight: max(market / maxV * 100, 1); height: 8; radius: 4; background: cMarket }
        Box { weight: max(100 - market / maxV * 100, 1); height: 8; background: alpha(foreground, 0.04) }
      }
      Text { text: replace(fixed(market, 3), ".", ","); style: label; color: cMarket; width: 44; align: end; maxLines: 1 }
    }
    Text { text: "Plus bas = mieux. Le Brier mesure la justesse des probabilités, pas le score exact."; style: label; color: muted; maxLines: 2 }
  }
}

component AmLegend(dot, label, c) {
  Row { gap: 4; align: center
    if dot { Box { size: 8; radius: 4; background: c } } else { Box { width: 15; height: 3; radius: 2; background: c } }
    Text { text: label; style: label; fontSize: 9; color: mix(c, foreground, 0.45); maxLines: 1 }
  }
}



component RollingChart(roll) {
  let pts = roll.filter(r => r.brier != null)
  if count(pts) == 0 {
    Text { text: "Pas encore de courbe : il faut des matchs terminés."; style: label; color: muted; maxLines: 2 }
  } else {
    let n = count(pts)
    let maxV = max(0.4, reduce(flatten(pts.map(r => [r.brier ?? 0, r.marketBrier ?? 0])), (m, v) => max(m, v), 0))
    Column { gap: 4; padding: 10; radius: 12; background: alpha(foreground, 0.03); border: 1; borderColor: alpha(foreground, 0.08)
      Row { gap: 6; align: center
        Text { text: "Brier roulant (fenêtre 5)"; style: label; bold: true; color: amCAmber; weight: 1; maxLines: 1 }
        AmLegend { dot: false; label: "modèle"; c: amCCyan }
        AmLegend { dot: false; label: "marché"; c: amCPink }
      }
      Canvas {
        fill: width
        height: 180
        let padL = 30
        let padR = 10
        let padT = 10
        let padB = 22
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        for g in range(4) {
          let v = maxV * g / 3
          let yy = padT + ch - v / maxV * ch
          line(padL, yy, padL + cw, yy, stroke: alpha(muted, 0.16), width: 1)
          text(replace(fixed(v, 2), ".", ","), padL - 4, yy, size: 9, align: end, color: muted)
        }
        let hpts = pts.map((r, i) => [padL + i / max(n - 1, 1) * cw, padT + ch - clamp(r.brier ?? 0, 0, maxV) / maxV * ch])
        let mpts = pts.map((r, i) => [padL + i / max(n - 1, 1) * cw, r.marketBrier == null ? padT + ch : padT + ch - clamp(r.marketBrier ?? 0, 0, maxV) / maxV * ch])
        if count(hpts) > 1 { path(hpts, stroke: amCCyan, width: 2.6, cap: round) }
        if count(mpts) > 1 { path(mpts, stroke: amCPink, width: 1.8, cap: round) }
        for i in range(count(hpts)) { circle(hpts[i][0], hpts[i][1], 2.6, fill: amCCyan) }
        text("matchs →", padL + cw / 2, height - 4, size: 9, align: center, bold: true, color: amCAmber)
      }
      Text { text: "Plus bas = mieux. Le marché est la référence ; le modèle doit s'en approcher puis le battre."; style: label; color: muted; align: center; maxLines: 2 }
    }
  }
}

component ReliabilityChart(rel) {
  let n = count(rel)
  if n == 0 {
    Text { text: "Pas encore assez de probabilités pour la fiabilité."; style: label; color: muted; maxLines: 2 }
  } else {
    Column { gap: 4; padding: 10; radius: 12; background: alpha(foreground, 0.03); border: 1; borderColor: alpha(foreground, 0.08)
      Row { gap: 6; align: center
        Text { text: "Fiabilité des probabilités"; style: label; bold: true; color: amCViolet; weight: 1; maxLines: 1 }
        AmLegend { dot: true; label: "prédit"; c: amCViolet }
        AmLegend { dot: true; label: "observé"; c: amCGood }
      }
      Canvas {
        fill: width
        height: 170
        let padL = 30
        let padR = 10
        let padT = 10
        let padB = 30
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        for g in range(4) {
          let v = g / 3
          let yy = padT + ch - v * ch
          line(padL, yy, padL + cw, yy, stroke: alpha(muted, 0.16), width: 1)
          text(replace(fixed(v, 1), ".", ","), padL - 4, yy, size: 9, align: end, color: muted)
        }
        let bw = cw / (n * 2 + 1)
        for i in range(n) {
          let r = rel[i]
          let x1 = padL + (i * 2 + 1) * bw
          let x2 = x1 + bw
          let hp = clamp(r.pred ?? 0, 0, 1) * ch
          let ho = clamp(r.obs ?? 0, 0, 1) * ch
          rect(x1, padT + ch - hp, bw * 0.75, hp, radius: 2, fill: alpha(amCViolet, 0.55))
          rect(x2, padT + ch - ho, bw * 0.75, ho, radius: 2, fill: alpha(amCGood, 0.55))
          text(r.bin, x1 + bw * 0.4, padT + ch + 14, size: 8, align: center, color: muted)
        }
      }
      Text { text: "Barre violette = probabilité annoncée · verte = fréquence réelle. Elles doivent se superposer."; style: label; color: muted; align: center; maxLines: 2 }
    }
  }
}


component ErrorBars(hist) {
  let pts = hist.filter(h => h.xErrH != null || h.xErrA != null)
  let n = count(pts)
  if n == 0 {
    Text { text: "Pas encore d'erreur xG mesurable."; style: label; color: muted; maxLines: 2 }
  } else {
    let maxAbs = max(0.5, reduce(flatten(pts.map(h => [abs(h.xErrH ?? 0), abs(h.xErrA ?? 0)])), (m, v) => max(m, v), 0))
    Column { gap: 4; padding: 10; radius: 12; background: alpha(foreground, 0.03); border: 1; borderColor: alpha(foreground, 0.08)
      Row { gap: 6; align: center
        Text { text: "Erreur xG par match"; style: label; bold: true; color: amCAmber; weight: 1; maxLines: 1 }
        AmLegend { dot: true; label: "domicile"; c: amCCyan }
        AmLegend { dot: true; label: "extérieur"; c: amCPink }
      }
      Canvas {
        fill: width
        height: 180
        let padL = 30
        let padR = 10
        let padT = 12
        let padB = 26
        let cw = max(width - padL - padR, 20)
        let ch = max(height - padT - padB, 20)
        let zero = padT + ch / 2
        line(padL, zero, padL + cw, zero, stroke: alpha(foreground, 0.35), width: 1)
        for g in range(3) {
          let v = maxAbs * g / 2
          let y1 = zero - v / maxAbs * (ch / 2)
          let y2 = zero + v / maxAbs * (ch / 2)
          if g > 0 { line(padL, y1, padL + cw, y1, stroke: alpha(muted, 0.12), width: 1) }
          text((v > 0 ? "+" : "") + replace(fixed(v, 1), ".", ","), padL - 4, y1, size: 8, align: end, color: muted)
          text((v > 0 ? "−" : "") + replace(fixed(v, 1), ".", ","), padL - 4, y2, size: 8, align: end, color: muted)
        }
        let bw = cw / (n * 2 + 1)
        for i in range(n) {
          let h = pts[i]
          let x1 = padL + (i * 2 + 1) * bw
          let x2 = x1 + bw
          if h.xErrH != null {
            let v = h.xErrH
            let hh = abs(v) / maxAbs * (ch / 2)
            rect(x1, v >= 0 ? zero - hh : zero, bw * 0.75, hh, radius: 2, fill: alpha(amCCyan, 0.55))
          }
          if h.xErrA != null {
            let v = h.xErrA
            let hh = abs(v) / maxAbs * (ch / 2)
            rect(x2, v >= 0 ? zero - hh : zero, bw * 0.75, hh, radius: 2, fill: alpha(amCPink, 0.55))
          }
          text(h.label ?? "", x1 + bw * 0.4, padT + ch + 14, size: 8, align: center, color: muted)
        }
        text("au-dessus = réel > prédit", padL + cw / 2, height - 4, size: 8, align: center, color: amCAmber)
      }
      Text { text: "Barre au-dessus de zéro = le modèle a sous-estimé ; en dessous = il a surestimé."; style: label; color: muted; align: center; maxLines: 2 }
    }
  }
}




component StatDuel(label, hv, av, unit = "", dec = -1, cH = amCCyan, cA = amCPink) {
  let nh = num(hv, 0)
  let na = num(av, 0)
  let fh = dec < 0 ? str(round(nh)) : replace(fixed(nh, dec), ".", ",")
  let fa = dec < 0 ? str(round(na)) : replace(fixed(na, dec), ".", ",")
  Column { gap: 2; padding: [4, 0]
    Row { gap: 4; align: center
      Text { text: fh + unit; style: label; bold: true; color: cH; width: 52; align: end; maxLines: 1 }
      Text { text: label; style: label; color: muted; weight: 1; align: center; maxLines: 1 }
      Text { text: fa + unit; style: label; bold: true; color: cA; width: 52; maxLines: 1 }
    }
    Row { gap: 2; height: 7
      Box { weight: max(nh, 0.01); height: 7; radius: 3; background: alpha(cH, 0.75) }
      Box { weight: max(na, 0.01); height: 7; radius: 3; background: alpha(cA, 0.75) }
    }
  }
}

component MatchRadar(amCur) {
  let amHAbbr = amCur.home.abbr ?? ""
  let amAAbbr = amCur.away.abbr ?? ""
  let hs = get(amCur.stats ?? {}, amHAbbr, {})
  let as = get(amCur.stats ?? {}, amAAbbr, {})
  let axes = [
    { k: "Possession", h: num(hs.possessionPct, 0), a: num(as.possessionPct, 0) },
    { k: "Tirs", h: num(hs.totalShots, 0), a: num(as.totalShots, 0) },
    { k: "Cadrés", h: num(hs.shotsOnTarget, 0), a: num(as.shotsOnTarget, 0) },
    { k: "Corners", h: num(hs.wonCorners, 0), a: num(as.wonCorners, 0) },
    { k: "Passes %", h: num(hs.passPct, 0) * 100, a: num(as.passPct, 0) * 100 },
    { k: "Arrêts", h: num(hs.saves, 0), a: num(as.saves, 0) }
  ]
  if amCur.stats == null || count(keys(amCur.stats)) == 0 {
    Text { text: "Radar indisponible : pas de stats de match."; style: label; color: muted; maxLines: 2 }
  } else {
    let n = count(axes)
    let mx = axes.map(ax => max(ax.h, ax.a, 0.01))
    let hv = axes.map((ax, k) => ax.h / mx[k] * 100)
    let av = axes.map((ax, k) => ax.a / mx[k] * 100)
    Column { gap: 4; padding: 10; radius: 12; background: linear(0, 0, 1, 1, [alpha(amCCyan, 0.08), alpha(background, 0.30), alpha(amCPink, 0.08)]); border: 1; borderColor: alpha(foreground, 0.08)
      Row { gap: 6; align: center
        Text { text: "Radar du match"; style: label; bold: true; color: amCCyan; weight: 1; maxLines: 1 }
        AmLegend { dot: true; label: amHAbbr; c: amCCyan }
        AmLegend { dot: true; label: amAAbbr; c: amCPink }
      }
      Canvas {
        fill: width
        height: 280
        let cx = width / 2
        let cy = height / 2 + 5
        let r = min(width, height) / 2 - 48
        let hp = hv.map((v, k) => [cx + cos(rad(-90 + k * 360 / n)) * r * clamp(v, 0, 100) / 100, cy + sin(rad(-90 + k * 360 / n)) * r * clamp(v, 0, 100) / 100])
        let ap = av.map((v, k) => [cx + cos(rad(-90 + k * 360 / n)) * r * clamp(v, 0, 100) / 100, cy + sin(rad(-90 + k * 360 / n)) * r * clamp(v, 0, 100) / 100])
        for l in [0.25, 0.5, 0.75, 1] {
          let gp = range(n).map(k => [cx + cos(rad(-90 + k * 360 / n)) * r * l, cy + sin(rad(-90 + k * 360 / n)) * r * l])
          path(gp, closed: true, stroke: alpha(muted, l == 1 ? 0.28 : 0.16), width: 1)
        }
        for k in range(n) {
          let a = rad(-90 + k * 360 / n)
          line(cx, cy, cx + cos(a) * r, cy + sin(a) * r, stroke: alpha(muted, 0.22), width: 1)
          text(axes[k].k, cx + cos(a) * (r + 20), cy + sin(a) * (r + 20), size: 9, align: center, bold: true, color: mix(foreground, amCCyan, 0.35))
          text(round(axes[k].h) + " · " + round(axes[k].a), cx + cos(a) * (r + 33), cy + sin(a) * (r + 33), size: 8, align: center, color: muted)
        }
        path(hp, closed: true, fill: alpha(amCCyan, 0.16), stroke: amCCyan, width: 2.2)
        path(ap, closed: true, fill: alpha(amCPink, 0.14), stroke: amCPink, width: 2.2)
        for i in range(n) { circle(hp[i][0], hp[i][1], 3, fill: amCCyan) }
        for i in range(n) { circle(ap[i][0], ap[i][1], 3, fill: amCPink) }
      }
      Text { text: "Chaque axe est normalisé sur le maximum des deux équipes. 100 = le plus fort sur ce critère."; style: label; color: muted; align: center; maxLines: 2 }
    }
  }
}



component EventTimeline(events) {
  let evs = (events ?? []).filter(e => contains(e.type ?? "", "goal") || e.type == "own-goal" || e.type == "penalty-goal" || e.type == "yellow-card" || e.type == "red-card" || e.type == "substitution")
  if count(evs) == 0 {
    Text { text: "Pas d'événements détaillés pour ce match."; style: label; color: muted; maxLines: 2 }
  } else {
    Column { gap: 3
      for e in evs key (e.t ?? "") + (e.type ?? "") + (e.text ?? "") {
        let col = contains(e.type ?? "", "goal") ? amCGood : e.type == "red-card" ? amCBad : e.type == "yellow-card" ? amCAmber : amCCyan
        let lab = contains(e.type ?? "", "goal") ? "BUT" : e.type == "red-card" ? "ROUGE" : e.type == "yellow-card" ? "JAUNE" : "SUB"
        Row { gap: 5; align: center; padding: [4, 6]; radius: 6; background: alpha(col, 0.06); border: 1; borderColor: alpha(col, 0.14)
          Text { text: e.t ?? ""; style: label; width: 38; color: muted; maxLines: 1 }
          Box { width: 4; height: 16; radius: 2; background: col }
          Column { weight: 1; gap: 0
            Text { text: lab; style: label; bold: true; color: col; maxLines: 1 }
            Text { text: (e.short ?? "") == "" ? (e.text ?? "") : (e.short ?? ""); style: label; color: muted; maxLines: 2 }
          }
        }
      }
    }
  }
}

component PlayerImpact(leaders) {
  let ls = leaders ?? []
  if count(ls) == 0 {
    Text { text: "Pas de leaders ESPN pour ce match."; style: label; color: muted; maxLines: 2 }
  } else {
    Column { gap: 5
      for l in ls key (l.t ?? "") + (l.name ?? "") {
        Column { gap: 2; padding: 7; radius: 8; background: alpha(foreground, 0.03); border: 1; borderColor: alpha(foreground, 0.07)
          Row { gap: 5; align: center
            Text { text: l.t ?? ""; style: label; bold: true; color: amCCyan; width: 36; maxLines: 1 }
            Text { text: l.name ?? ""; style: label; color: muted; weight: 1; maxLines: 1 }
          }
          for x in (l.items ?? []) key (x.n ?? "") + (x.v ?? "") {
            Row { gap: 5
              Text { text: x.n ?? ""; style: label; color: foreground; weight: 1; maxLines: 1 }
              Text { text: x.v ?? ""; style: label; color: muted; align: end; maxLines: 1 }
            }
          }
        }
      }
    }
  }
}

component Chapter(id, n, t, sub, c) {
  let open = indexOf(openChapters, id) >= 0
  Row {
    gap: 8
    align: center
    padding: [8, 5]
    radius: 12
    background: linear(0, 0, 1, 0, [alpha(c, open ? 0.34 : 0.22), alpha(c, 0.05)])
    border: 1
    borderColor: alpha(c, open ? 0.46 : 0.26)
    onTap: openChapters = open ? openChapters.filter(x => x != id) : openChapters + [id]
    Box { width: 4; height: 24; radius: 2; background: linear(0, 0, 0, 1, [c, alpha(c, 0.10)]) }
    Column {
      gap: 2
      weight: 1
      Text { text: n + " · " + t; style: title; bold: true; color: mix(c, foreground, 0.22); maxLines: 1; letterSpacing: 0.2 }
      if sub != "" { Text { text: sub; style: label; color: muted; maxLines: 2 } }
    }
    Text { text: open ? "−" : "+"; fontSize: 18; bold: true; color: c }
  }
}

screen{
title:settingsOpen ? "réglages" : labOpen ? "laboratoire des modèles" : setupNeeded ? "mes équipes" : detailMode=="post"?(lang=="fr"?"Après-match":"Post-match") : detailMode=="pre"?(lang=="fr"?"Avant-match":"Pre-match") : (lang=="fr"?"mes matchs":"my matches")
Column{
gap:10
background:linear(0,0,0,1,[alpha(uiPop,0.12),alpha(background,0.0),alpha(uiPop,0.08)])
if settingsOpen{
  Column {
    scroll: true
    gap: 12
    padding: [4, 10]
    Row {
      gap: 10
      align: center
      padding: [8, 10]
      Text { text: "←"; fontSize: 22; color: accent; width: 44; height: 44; align: center; onTap: { settingsOpen = false } }
      Text { text: "réglages"; fontSize: 16; fontWeight: 650; weight: 1; maxLines: 1 }
    }
    Section { c: accent; t: "Mes équipes"; sub: "1 à 5 clubs ou sélections" }
    Text { text: count(myTeams) == 0 ? "aucune équipe" : join(myTeams.map(t => t.name ?? t.short ?? t.abbr), " · "); style: small; color: foreground; maxLines: 3 }
    Button { height: 44; text: "modifier mes équipes"; color: accent; onTap: { draft = myTeams; query = ""; showTeams = true; settingsOpen = false; screen() } }

    Section { c: cyan; t: "Taille de l’interface"; sub: "texte et densité" }
    Row {
      gap: 8
      for o in [{l: "S", v: "S"}, {l: "M", v: "M"}, {l: "L", v: "L"}, {l: "XL", v: "XL"}] key o.v {
        Box {
          weight: 1
          height: 44
          radius: 12
          align: center
          background: uiSize == o.v ? alpha(cyan, 0.22) : alpha(foreground, 0.04)
          border: 1
          borderColor: uiSize == o.v ? alpha(cyan, 0.50) : alpha(foreground, 0.10)
          onTap: uiSize = o.v
          Text { text: o.l; fontSize: 16; bold: uiSize == o.v; color: uiSize == o.v ? foreground : muted; align: center }
        }
      }
    }

    Button { height: 44; text: "fermer les réglages"; color: muted; onTap: { settingsOpen = false } }
    Spacer { height: 20 }
  }
}else if labOpen{
  Column {
    scroll: true
    gap: 10
    padding: [4, 8]
    Row {
      gap: 10
      align: center
      padding: [8, 10]
      Text { text: "←"; fontSize: 22; color: accent; width: 44; height: 44; align: center; onTap: { labOpen = false } }
      Text { text: "laboratoire des modèles"; fontSize: 16; fontWeight: 650; weight: 1; maxLines: 1 }
    }

    Box {
      fill: width
      radius: 18 * corners
      border: 1
      borderColor: alpha(accent, 0.28)
      background: radial(0.86, 0.02, 1.05, [alpha(accent, 0.24), alpha(mix(surface, accent, 0.08), 0.97), alpha(background, 1)])
      padding: [14, 14]
      Column {
        gap: 9
        Row {
          gap: 12
          align: center
          Canvas {
            width: 88
            height: 88
            let cc = 44
            let rr = 37
            let vv = clamp(labScore, 0, 100)
            arc(cc, cc, rr, 0, 360, stroke: alpha(surface, 0.95), width: 7, cap: round)
            arc(cc, cc, rr, 0, vv * 3.6, stroke: alpha(labTint, 0.20), width: 16, cap: round)
            arc(cc, cc, rr, 0, vv * 3.6, stroke: labTint, width: 7, cap: round)
            text("${round(vv)}", cc, cc - 3, size: 24, align: center, color: foreground, bold: true)
            text("SANTÉ", cc, cc + 16, size: 7, align: center, color: muted)
          }
          Column {
            gap: 3
            weight: 1
            Text { text: "SANTÉ DU MODÈLE"; fontSize: 9; fontWeight: 800; letterSpacing: 1.7; color: alpha(foreground, 0.62) }
            Text { text: labStatus; fontSize: 19; fontWeight: 800; color: labTint; maxLines: 1 }
            Text { text: amCal == null ? "Le laboratoire attend sa première mesure." : "Le modèle est ${labMood} : tout est automatique, cette page rassemble les analyses."; style: small; color: muted; maxLines: 3 }
          }
        }
        Flow {
          gap: 6
          Text { text: amCal == null ? "aucune donnée" : (labAlerts == 0 ? "aucune alerte" : "${labAlerts} alerte(s)"); fontSize: 9; fontWeight: 700; color: labTint; padding: [4, 8]; radius: 999; background: alpha(labTint, 0.12); border: 1; borderColor: alpha(labTint, 0.28) }
          Text { text: amCal == null ? "—" : "${labN} match(s)"; fontSize: 9; color: muted; padding: [4, 8]; radius: 999; background: alpha(surface, 0.60); border: 1; borderColor: border }
          Text { text: amCal == null ? "—" : "Brier ${replace(fixed(labBrier, 3), ".", ",")}"; fontSize: 9; color: muted; padding: [4, 8]; radius: 999; background: alpha(surface, 0.60); border: 1; borderColor: border }
          Text { text: labSkill == null ? "skill —" : "skill ${labSkill > 0 ? "+" : ""}${replace(fixed(labSkill, 3), ".", ",")}"; fontSize: 9; color: labSkill != null && labSkill > 0 ? green : muted; padding: [4, 8]; radius: 999; background: alpha(surface, 0.60); border: 1; borderColor: border }
        }
      }
    }

    if amCal == null {
      Column {
        gap: 6
        padding: [18, 14]
        radius: 14 * corners
        background: alpha(surface, 0.45)
        border: 1
        borderColor: border
        Text { text: "Aucune calibration enregistrée."; style: small; bold: true; color: foreground }
        Text { text: "Ouvre l'avant-match d'un match à venir : la prédiction est enregistrée automatiquement. La mesure se construit match après match."; style: label; color: muted; maxLines: 4 }
        Button { height: 44; text: "relancer la mesure"; color: accent; onTap: run("python3 ~/.config/omalauncher/widgets/prematch-preds.py calibrate >/dev/null 2>&1") }
      }
    } else {
      Section { c: accent; t: "Constellation du modèle"; sub: "5 dimensions · indice de preuve" }
      Box {
        fill: width
        radius: 16 * corners
        border: 1
        borderColor: alpha(accent, 0.22)
        background: alpha(surface, 0.35)
        padding: [10, 10]
        Canvas {
          fill: width
          height: 190
          let cx = width / 2
          let cy = height / 2 + 2
          let r = min(width, height) / 2 - 28
          let vals = [clamp(labBrierS, 0, 100), clamp(labHitS, 0, 100), clamp(labXgS, 0, 100), clamp(labCovS, 0, 100), clamp(labMktS, 0, 100)]
          let names = ["Brier", "1/N/2", "xG", "Volume", "Marché"]
          let tints = [orange, accent, magenta, green, yellow]
          for g in [0.25, 0.5, 0.75, 1] {
            path(range(5).map(i => [cx + r * g * sin(rad(i * 72)), cy - r * g * cos(rad(i * 72))]), closed: true, stroke: alpha(foreground, 0.10), width: 1)
          }
          for i in range(5) {
            let aa = rad(i * 72)
            line(cx, cy, cx + r * sin(aa), cy - r * cos(aa), stroke: alpha(foreground, 0.10), width: 1)
          }
          let dpts = range(5).map(i => [cx + r * vals[i] / 100 * sin(rad(i * 72)), cy - r * vals[i] / 100 * cos(rad(i * 72))])
          path(dpts, closed: true, stroke: alpha(accent, 0.18), width: 7)
          path(dpts, closed: true, fill: radial(0.5, 0.5, 0.62, [alpha(accent, 0.40), alpha(cyan, 0.08)]), stroke: alpha(accent, 0.85), width: 1.6)
          for i in range(5) {
            let ang = i * 72
            let v = vals[i] / 100
            let sx = cx + r * v * sin(rad(ang))
            let sy = cy - r * v * cos(rad(ang))
            let lx = cx + (r + 16) * sin(rad(ang))
            let ly = cy - (r + 16) * cos(rad(ang))
            circle(sx, sy, 6, fill: alpha(tints[i], 0.16))
            circle(sx, sy, 3, fill: tints[i])
            text(names[i], lx, ly - 3, size: 8, align: center, color: muted)
            text("${round(vals[i])}", lx, ly + 7, size: 8, align: center, color: tints[i], bold: true)
          }
        }
      }

      Section { c: cyan; t: "L’essentiel"; sub: "paliers d’amélioration continue" }
      Row {
        gap: 6
        AmMetric { label: "Brier"; value: fixed(labBrierS, 1); sub: "palier ${fixed(labFactP.target, 0)}"; c: orange }
        AmMetric { label: "1/N/2"; value: fixed(labHitS, 1); sub: "palier ${fixed(labHitP.target, 0)}"; c: accent }
        AmMetric { label: "xG"; value: fixed(labXgS, 1); sub: "palier ${fixed(labXgP.target, 0)}"; c: magenta }
      }
      Row {
        gap: 6
        AmMetric { label: "Volume"; value: fixed(labCovS, 1); sub: "${labN} match(s)"; c: green }
        AmMetric { label: "Marché"; value: fixed(labMktS, 1); sub: labMktN == 0 ? "sans cotes" : "Brier ${replace(fixed(labMktBrier, 3), ".", ",")}"; c: yellow }
        AmMetric { label: "Alertes"; value: str(labAlerts); sub: "à traiter"; c: orange }
      }

      Section { c: magenta; t: "Tous les modèles"; sub: "un seul endroit pour tout analyser" }
      Row {
        gap: 6
        AmMetric { label: "Prédiction"; value: replace(fixed(labBrier, 3), ".", ","); sub: "Brier"; c: orange }
        AmMetric { label: "Score exact"; value: amCur == null || !hasPrediction ? "—" : (amCur.best ?? "—"); sub: "Poisson 5×5"; c: accent }
        AmMetric { label: "+2,5 / BTTS"; value: amCur == null ? "—" : "${round((amCur.over ?? 0) * 100)}/${round((amCur.btts ?? 0) * 100)}%"; sub: "Poisson brut"; c: cyan }
      }
      Row {
        gap: 6
        AmMetric { label: "xG"; value: "${replace(fixed(labMaeH, 2), ".", ",")}/${replace(fixed(labMaeA, 2), ".", ",")}"; sub: "MAE H/A"; c: magenta }
        AmMetric { label: "Synthèse"; value: synStatus == "running" ? "…" : synWords > 0 ? "${synWords} mots" : "—"; sub: synText != "" ? "prête" : "en attente"; c: green }
        AmMetric { label: "Cotes"; value: labMktN == 0 ? "—" : replace(fixed(labMktBrier, 3), ".", ","); sub: "${labMktN} match(s)"; c: yellow }
      }
      Row {
        gap: 6
        AmMetric { label: "Calibration"; value: replace(fixed(labTemp, 2), ".", ","); sub: labN >= 3 ? "active" : "en attente"; c: green }
        AmMetric { label: "Biais xG H"; value: (labBiasH > 0 ? "+" : "") + replace(fixed(labBiasH, 2), ".", ","); sub: "réel − prédit"; c: orange }
        AmMetric { label: "Biais xG A"; value: (labBiasA > 0 ? "+" : "") + replace(fixed(labBiasA, 2), ".", ","); sub: "réel − prédit"; c: orange }
      }

      if labAlerts > 0 {
        Section { c: orange; t: "Lacunes à combler"; sub: "à traiter" }
        if labN < 3 { Reading { pmVerdict: "Échantillon trop petit : ${labN} match(s), 3 nécessaires pour calibrer."; facts: "Ouvre l’avant-match des matchs à venir : chaque prédiction enregistrée nourrit le modèle."; c: orange } }
        if labMktN > 0 && labBrier > labMktBrier { Reading { pmVerdict: "Le modèle ne bat pas encore les cotes."; facts: "Brier ${replace(fixed(labBrier, 3), ".", ",")} vs ${replace(fixed(labMktBrier, 3), ".", ",")} · la température et le biais xG restent prudents."; c: orange } }
        if labXgN == 0 { Reading { pmVerdict: "Pas encore de xG réel sur les matchs terminés."; facts: "La correction xG s’activera dès que 3 matchs avec xG seront disponibles."; c: orange } }
        if labMaeH > 0.7 || labMaeA > 0.7 { Reading { pmVerdict: "Erreur xG élevée : ${replace(fixed(labMaeH, 2), ".", ",")} / ${replace(fixed(labMaeA, 2), ".", ",")} but."; facts: "Le modèle apprend le biais par équipe ; continue d’enregistrer les avant-matchs."; c: orange } }
      }

      Section { c: green; t: "Progression"; sub: "${labN} cycle(s)" }
      if len(labHist) >= 2 {
        Column {
          gap: 8
          padding: [10, 10]
          radius: 12 * corners
          background: alpha(surface, 0.35)
          border: 1
          borderColor: alpha(border, 0.70)
          Row { gap: 6; align: center
            Text { text: "Brier"; style: label; bold: true; color: orange; weight: 1 }
            Text { text: replace(fixed(labBrier, 3), ".", ","); style: label; bold: true; color: orange }
          }
          Sparkline { values: labBrierSeries; min: 0; max: 100; height: 26; fill: width; color: orange; area: alpha(orange, 0.12); thickness: 2 }
          Row { gap: 6; align: center
            Text { text: "Favori juste"; style: label; bold: true; color: accent; weight: 1 }
            Text { text: "${round(labHit * 100)}%"; style: label; bold: true; color: accent }
          }
          Sparkline { values: labHitSeries; min: 0; max: 100; height: 26; fill: width; color: accent; area: alpha(accent, 0.12); thickness: 2 }
          Row { gap: 6; align: center
            Text { text: "Erreur xG"; style: label; bold: true; color: magenta; weight: 1 }
            Text { text: replace(fixed((labMaeH + labMaeA) / 2, 2), ".", ","); style: label; bold: true; color: magenta }
          }
        }
      } else {
        Text { text: "Pas encore assez de mesures pour tracer la progression : il faut au moins 2 matchs terminés."; style: small; color: muted; padding: [2, 4] }
      }

      Row {
        fill: width
        gap: 8
        align: center
        padding: [10, 12]
        radius: 12 * corners
        background: alpha(surface, 0.40)
        border: 1
        borderColor: border
        onTap: labAdvanced = labAdvanced == 1 ? 0 : 1
        Text { text: "détails techniques"; fontSize: 11; fontWeight: 650; color: foreground; weight: 1 }
        Text { text: labAdvanced == 1 ? "−" : "+"; fontSize: 18; fontWeight: 700; color: accent }
      }
      if labAdvanced == 1 {
        Column {
          gap: 5
          padding: [10, 12]
          radius: 12 * corners
          background: alpha(background, 0.92)
          border: 1
          borderColor: alpha(border, 0.70)
          Text { text: "Calibration : ${labN} matchs · xG=${labXgN} · marché=${labMktN} · dont ${labNFollowed} suivis"; fontSize: 10; font: mono; color: muted }
          Text { text: "Modèle : Brier ${replace(fixed(labBrier, 3), ".", ",")} · brut ${replace(fixed(labBrierRaw, 3), ".", ",")} · skill ${labSkill == null ? "—" : replace(fixed(labSkill, 3), ".", ",")}"; fontSize: 10; font: mono; color: muted }
          Text { text: "xG : biais ${labBiasH > 0 ? "+" : ""}${replace(fixed(labBiasH, 2), ".", ",")} / ${labBiasA > 0 ? "+" : ""}${replace(fixed(labBiasA, 2), ".", ",")} · MAE ${replace(fixed(labMaeH, 2), ".", ",")} / ${replace(fixed(labMaeA, 2), ".", ",")}"; fontSize: 10; font: mono; color: muted }
          Text { text: "Correction : température ${replace(fixed(labTemp, 2), ".", ",")} · xG ${labAdjH > 0 ? "+" : ""}${replace(fixed(labAdjH, 2), ".", ",")} / ${labAdjA > 0 ? "+" : ""}${replace(fixed(labAdjA, 2), ".", ",")} but"; fontSize: 10; font: mono; color: muted }
          Text { text: "Échantillon : ${count(labHist)} historique(s) · ${count(labRel)} fiabilité(s) · ${count(labTeams)} équipe(s)"; fontSize: 10; font: mono; color: muted }
        }
      }

      Row {
        gap: 8
        padding: [8, 0]
        Box {
          weight: 1
          height: 46
          radius: 14 * corners
          align: center
          background: linear(0, 0, 1, 1, [accent, mix(accent, cyan, 0.55)])
          onTap: run("python3 ~/.config/omalauncher/widgets/prematch-preds.py calibrate >/dev/null 2>&1")
          Text { text: "relancer la mesure"; fontSize: 12; fontWeight: 800; color: background; align: center }
        }
        Box {
          width: 112
          height: 46
          radius: 14 * corners
          align: center
          background: alpha(surface, 0.60)
          border: 1
          borderColor: border
          onTap: share(toJson(labHist))
          Text { text: "partager"; fontSize: 12; fontWeight: 650; color: foreground; align: center }
        }
      }
    }

    Spacer { height: 20 }
  }
}else if setupNeeded{
let _inl85716_q=lower(trim(query))
let _inl85716_db=teamsDb.out??[]
let _inl85716_res=_inl85716_q==""?_inl85716_db.take(12):_inl85716_db.filter(t=>contains(lower(t.name),_inl85716_q)||contains(lower(t.short),_inl85716_q)||contains(lower(t.abbr),_inl85716_q)).take(12)
Column{
gap:8
Text{text:count(myTeams)==0?S.welcome:S.myTeamsT;style:title;align:center}
Text{text:S.trust;style:label;color:soft;align:center;maxLines:2}
Text{text:"${count(draft)}/5 — ${S.range}";style:small;color:soft;align:center}
Input{placeholder:S.searchClub;text:query;onChange:query=value}
if count(draft)>0{
Flow{
gap:6
for d in draft key d.key{
Text{text:"✕ ${d.short}";style:small;color:pop;onTap:draft=draft.filter(x=>x.key!=d.key)}
}
}
}
if count(draft)>=5{
Text{text:S.maxFiveHint;style:label;color:soft;align:center}
}
if teamsDb==null{
Text{text:S.loadingTeams;style:small;color:soft}
}else if !(teamsDb.ok??true){
Text{text:S.sourceErr+" "+(teamsDb.code??"");style:small;color:"#ef4444";align:center}
Button{text:S.retry;color:soft;onTap:refresh()}
}else if count(_inl85716_res)==0{
Text{text:S.noTeams+(_inl85716_q==""?"":" · "+S.searchHint);style:small;color:soft;align:center;maxLines:2}
if _inl85716_q!=""{Button{text:S.clearFilter;color:soft;onTap:query=""}}
}else{
for r in _inl85716_res key r.key{
let _inl85716_inD=draft.any(x=>x.key==r.key)
let _inl85716_full=count(draft)>=5&&!_inl85716_inD
Row{
gap:8
align:center
Crest{logo:r.logo;px:24;name:r.name??r.short??r.abbr}
Column{
weight:1;gap:0
Text{text:r.name;style:small;maxLines:1}
Text{text:r.tag;style:label;color:soft;maxLines:1}
}
Text{text:_inl85716_inD?"✓":"+";width:40;align:center;fontSize:18;color:_inl85716_inD?pop:_inl85716_full?muted:foreground;onTap:draft=_inl85716_inD?draft.filter(x=>x.key!=r.key):_inl85716_full?draft:(draft+[r]).take(5)}
}
}
}
Row{
gap:8
if count(myTeams)>0{
Button{text:S.cancel;weight:1;color:soft;onTap:showTeams=false}
}
if count(draft)>=1&&count(draft)<=5{
Button{text:"${S.validate} (${count(draft)}/5)";weight:1;color:pop;onTap:{myTeams=draft;showTeams=false;team="ALL";selJ=-1;refresh()}}
}else{
Button{text:count(draft)==0?S.pickOne:S.maxBtn;weight:1;color:muted;onTap:notify(S.notifT,S.notifX)}
}
}
}
}
else if detailMode=="post"{
Column {
  scroll: true
  padding: [14, 10]
  gap: 12
  background: linear(0, 0, 0, 1, [alpha(amCCyan, 0.10), alpha(background, 0.0), alpha(amCPink, 0.08)])

  Row { gap: 8; align: center
    Column { weight: 1; gap: 1
      Text { text: "Après-match"; style: title; bold: true; maxLines: 1 }
      Text { text: "lecture statistique du match"; style: label; color: muted; maxLines: 1 }
    }
    Button { text: "actualiser"; color: muted; padding: 6; onTap: refresh() }
    Text { text: "⚙"; fontSize: 16; color: amCCyan; padding: [8, 6]; onTap: { settingsOpen = true; screen() } }
  }

  if preds == null {
    Text { text: "Chargement des prédictions…"; style: small; color: muted }
  } else if count(list) == 0 {
    Column { gap: 6; padding: 14; radius: 10; background: alpha(foreground, 0.04); border: 1; borderColor: alpha(foreground, 0.10)
      Text { text: "Aucune prédiction enregistrée."; style: small; bold: true; color: foreground }
      Text { text: "Ouvre l'avant-match d'un match à venir : la prédiction est enregistrée automatiquement."; style: label; color: muted; maxLines: 3 }
    }
  } else {
    if amCur == null {
      Text { text: "Aucune donnée pour ce match."; style: small; color: muted }
    } else {
      Row { gap: 6; align: center
        Column { weight: 1; gap: 1; align: center
          if (amCur.home.logo ?? "") != "" { Image { src: "~/.cache/espn-logos/banner/" + amCur.home.logo; size: 42; fit: contain; label: amCur.home.name } }
          else { Box { size: 30; radius: 15; background: alpha(amCCyan, 0.25) } }
          Text { text: amCur.home.name ?? amCur.home.abbr ?? ""; style: label; bold: true; color: amHText; align: center; maxLines: 1 }
        }
        Column { width: 130; gap: 1; align: center
          Text { text: hasActual ? (amGF + " – " + amGA) : "à venir"; style: title; bold: true; align: center; maxLines: 1 }
          Text { text: hasActual ? "terminé" : fmtTime(amCur.at, "EEE d MMM HH:mm"); style: label; color: muted; align: center; maxLines: 1 }
          Text { text: amCur.league ?? ""; style: label; color: muted; align: center; maxLines: 1 }
        }
        Column { weight: 1; gap: 1; align: center
          if (amCur.away.logo ?? "") != "" { Image { src: "~/.cache/espn-logos/banner/" + amCur.away.logo; size: 42; fit: contain; label: amCur.away.name } }
          else { Box { size: 30; radius: 15; background: alpha(amCPink, 0.25) } }
          Text { text: amCur.away.name ?? amCur.away.abbr ?? ""; style: label; bold: true; color: amAText; align: center; maxLines: 1 }
        }
      }
      Text { text: fmtTime(amCur.at, "EEE d MMM HH:mm") + (get(amCur.info ?? {}, "venue", null) == null ? "" : " · " + get(amCur.info ?? {}, "venue", "")) + (get(amCur.info ?? {}, "attendance", null) == null ? "" : " · " + get(amCur.info ?? {}, "attendance", "") + " spect.") + (get(amCur.info ?? {}, "referee", null) == null ? "" : " · " + get(amCur.info ?? {}, "referee", "")); style: label; color: muted; align: center; maxLines: 1 }

      Box { fill: width; radius: 14 * corners; border: 1; borderColor: alpha(amCCyan, 0.28); background: linear(0, 0, 1, 0, [alpha(amCCyan, 0.12), alpha(surface, 0.45)]); padding: [10, 12]
        Column { gap: 5
          Row { gap: 6; align: center
            Box { width: 3; height: 14; radius: 2; background: amCCyan }
            Text { text: "À RETENIR"; style: label; fontWeight: 800; letterSpacing: 1.2; color: amCCyan; weight: 1; maxLines: 1 }
            Text { text: "4 points clés"; style: label; color: muted; maxLines: 1 }
          }
          Row { gap: 6; align: top
            Box { width: 5; height: 5; radius: 3; background: amCCyan }
            Text { text: "Contrôle : " + amPossH + "% de possession, " + amShotsH + " tirs pour " + amHName + " · " + amPossA + "% et " + amShotsA + " tirs pour " + amAName + "."; style: small; color: foreground; weight: 1; maxLines: 2 }
          }
          Row { gap: 6; align: top
            Box { width: 5; height: 5; radius: 3; background: amCGood }
            Text { text: "Efficacité : " + amGF + " buts / " + amSotH + " cadrés pour " + amHName + " · " + amGA + " / " + amSotA + " pour " + amAName + " · conversion " + round(amConvH) + "% / " + round(amConvA) + "%."; style: small; color: foreground; weight: 1; maxLines: 2 }
          }
          Row { gap: 6; align: top
            Box { width: 5; height: 5; radius: 3; background: amCAmber }
            Text { text: amHasXg ? "xG (" + amXgSource + ") : " + amHName + " " + replace(fixed(amXgH, 2), ".", ",") + " · " + amAName + " " + replace(fixed(amXgA, 2), ".", ",") + " · finition " + (amFinH > 0 ? "+" : "") + replace(fixed(amFinH, 2), ".", ",") + " / " + (amFinA > 0 ? "+" : "") + replace(fixed(amFinA, 2), ".", ",") + "." : "xG indisponible pour ce match : lecture sur le volume et le cadrage."; style: small; color: foreground; weight: 1; maxLines: 2 }
          }
          Row { gap: 6; align: top
            Box { width: 5; height: 5; radius: 3; background: amCPink }
            Text { text: "Discipline : " + amFoulsH + " fautes et " + amYellowH + " jaune(s) pour " + amHName + " · " + amFoulsA + " fautes et " + amYellowA + " jaune(s) pour " + amAName + "."; style: small; color: foreground; weight: 1; maxLines: 2 }
          }
        }
      }

      Chapter { id: "post-match"; n: "1"; t: "Le film du match"; sub: "buts, cartons et tournant"; c: amCAmber }
      if indexOf(openChapters, "post-match") >= 0 {
        Column { gap: 8
          Reading { pmVerdict: amTurningText; facts: "Tournant du match"; c: amCAmber }
          EventTimeline { events: amCur.events ?? [] }
        }
      }

      Chapter { id: "post-merite"; n: "2"; t: "Mérite & efficacité"; sub: "xG, finition, volume et cadrage"; c: amCCyan }
      if indexOf(openChapters, "post-merite") >= 0 {
        Column { gap: 8
          if amHasXg {
            StatDuel { label: "xG"; hv: amXgH; av: amXgA; dec: 2; cH: amHColor; cA: amAColor }
            StatDuel { label: "xPts"; hv: amXptsH; av: amXptsA; dec: 2; cH: amHColor; cA: amAColor }
            Reading { pmVerdict: "Finition : " + amHName + " " + (amFinH > 0 ? "+" : "") + replace(fixed(amFinH, 2), ".", ",") + " but vs xG · " + amAName + " " + (amFinA > 0 ? "+" : "") + replace(fixed(amFinA, 2), ".", ",") + "."; facts: "Buts réels " + amGF + "–" + amGA + " · xG " + replace(fixed(amXgH, 2), ".", ",") + "–" + replace(fixed(amXgA, 2), ".", ",") + " · points réels " + amPtsH + "–" + amPtsA; c: amCCyan }
          } else {
            Text { text: "xG indisponible pour ce match : la lecture reste sur le volume, le cadrage et la conversion."; style: small; color: muted; maxLines: 2 }
          }
          StatDuel { label: "Tirs"; hv: amShotsH; av: amShotsA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Tirs cadrés"; hv: amSotH; av: amSotA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Cadrage"; hv: amSotPctH; av: amSotPctA; unit: "%"; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Conversion"; hv: amConvH; av: amConvA; unit: "%"; dec: 0; cH: amHColor; cA: amAColor }
          if amFdH != null && amFdA != null {
            let amProxy = (amFdH.proxy ?? false) || (amFdA.proxy ?? false)
            AmSectionTitle { t: "Contexte saison"; c: amCCyan; sub: amProxy ? "5 derniers matchs · ESPN " + (((amFdH.shots ?? 0) > 0 || (amFdA.shots ?? 0) > 0) ? "(buts et tirs)" : "(buts)") : "5 derniers matchs · Football-Data" }
            PmDuel { label: amProxy ? "Buts (5)" : "xG (5)"; hv: amFdH.xg5; av: amFdA.xg5; hc: amHColor; ac: amAColor; hint: amProxy ? "plus = marque plus" : "plus = crée plus"; better: "high" }
            PmDuel { label: amProxy ? "Encaissés (5)" : "xGA (5)"; hv: amFdH.xga5; av: amFdA.xga5; hc: amHColor; ac: amAColor; hint: amProxy ? "plus = encaisse plus" : "plus = concède plus"; better: "low" }
            if amProxy && ((amFdH.shots ?? 0) > 0 || (amFdA.shots ?? 0) > 0) {
              PmDuel { label: "Tirs / match"; hv: amFdH.shots; av: amFdA.shots; hc: amHColor; ac: amAColor; hint: "plus = volume"; better: "high" }
              PmDuel { label: "Cadrage %"; hv: amFdH.sotPct; av: amFdA.sotPct; hc: amHColor; ac: amAColor; hint: "plus = précis"; better: "high" }
            }
            if !amProxy { PmDuel { label: "xPts (5)"; hv: amFdH.xpts5; av: amFdA.xpts5; hc: amHColor; ac: amAColor; hint: "plus = mérite plus"; better: "high" } }
          }
        }
      }

      Chapter { id: "post-controle"; n: "3"; t: "Contrôle & territoire"; sub: "possession, passes, centres et corners"; c: amCViolet }
      if indexOf(openChapters, "post-controle") >= 0 {
        Column { gap: 8
          StatDuel { label: "Possession"; hv: amPossH; av: amPossA; unit: "%"; dec: 1; cH: amHColor; cA: amAColor }
          StatDuel { label: "Passes"; hv: amPassH; av: amPassA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Précision passes"; hv: amPassPctH; av: amPassPctA; unit: "%"; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Centres"; hv: amCrossH; av: amCrossA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Corners"; hv: amCornersH; av: amCornersA; dec: 0; cH: amHColor; cA: amAColor }
          Reading { pmVerdict: "Contrôle : " + (amPossH > amPossA ? amHName : amPossA > amPossH ? amAName : "les deux équipes") + " a le ballon (" + amPossH + "% / " + amPossA + "%) · " + (amPassH > amPassA ? amHName : amAName) + " fait plus de passes (" + amPassH + " / " + amPassA + ")."; facts: "Possession et volume de passes · source ESPN"; c: amCViolet }
        }
      }

      Chapter { id: "post-duel"; n: "4"; t: "Duel & discipline"; sub: "tacles, interceptions, arrêts, fautes et cartons"; c: amCAmber }
      if indexOf(openChapters, "post-duel") >= 0 {
        Column { gap: 8
          StatDuel { label: "Tacles"; hv: amTacklesH; av: amTacklesA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Interceptions"; hv: amInterH; av: amInterA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Dégagements"; hv: amClearH; av: amClearA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Arrêts"; hv: amSavesH; av: amSavesA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Tirs bloqués"; hv: amBlockedH; av: amBlockedA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Fautes"; hv: amFoulsH; av: amFoulsA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Jaunes"; hv: amYellowH; av: amYellowA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Rouges"; hv: amRedH; av: amRedA; dec: 0; cH: amHColor; cA: amAColor }
          StatDuel { label: "Hors-jeu"; hv: amOffH; av: amOffA; dec: 0; cH: amHColor; cA: amAColor }
          Reading { pmVerdict: "Discipline : " + (amRedH + amRedA > 0 ? "carton rouge dans ce match · " : "") + amFoulsH + " fautes / " + amFoulsA + " · " + amYellowH + " / " + amYellowA + " jaunes."; facts: "Duels et discipline · source ESPN"; c: amCAmber }
        }
      }

      Chapter { id: "post-joueurs"; n: "5"; t: "Joueurs"; sub: "buteurs, leaders et compositions"; c: amCPink }
      if indexOf(openChapters, "post-joueurs") >= 0 {
        Column { gap: 8
          if count(amGoals) > 0 {
            AmSectionTitle { t: "Buteurs"; c: amCPink; sub: "chronologie des buts" }
            for e in amGoals.take(8) key e.t + (e.text ?? "") {
              Row { gap: 6; align: center
                Text { text: e.t ?? ""; style: label; bold: true; color: amCPink; width: 38; maxLines: 1 }
                Text { text: e.short ?? e.text ?? ""; style: label; color: foreground; weight: 1; maxLines: 1 }
              }
            }
          }
          PlayerImpact { leaders: amCur.leaders ?? [] }
          if count(amCur.lineups ?? []) > 0 {
            AmSectionTitle { t: "Compositions"; c: amCSky; sub: "formations et titulaires" }
            for l in (amCur.lineups ?? []) key l.t {
              Row { gap: 5; align: center; padding: [5, 7]; radius: 7; background: alpha(foreground, 0.03); border: 1; borderColor: alpha(foreground, 0.07)
                Text { text: l.t ?? ""; style: label; bold: true; color: amCCyan; width: 36; maxLines: 1 }
                Text { text: (l.formation ?? "") == "" ? "formation ?" : (l.formation ?? ""); style: label; color: muted; weight: 1; maxLines: 1 }
                Text { text: count(l.starters ?? []) + " titulaires"; style: label; color: muted; maxLines: 1 }
              }
            }
          }
        }
      }

      Chapter { id: "post-contexte"; n: "6"; t: "Contexte & confiance"; sub: "sources, fraîcheur et échantillon"; c: amCLime }
      if indexOf(openChapters, "post-contexte") >= 0 {
        Column { gap: 6
          AmSectionTitle { t: "Sources"; c: amCLime; sub: "ce qui alimente cette lecture" }
          Text { text: "ESPN : score, événements, possession, tirs, passes, duels et discipline."; style: small; color: muted; maxLines: 2 }
          Text { text: "Football-Data : xG, xGA, xPts et forme sur 5 matchs pour la saison."; style: small; color: muted; maxLines: 2 }
          Text { text: amHasXg ? "xG du match : disponible (" + amXgSource + ")." : "xG du match : indisponible ; les tirs et le cadrage restent la base."; style: small; color: amHasXg ? amCGood : amCAmber; maxLines: 2 }
          Text { text: "Échantillon : un match · les tendances de saison viennent des 5 derniers matchs de chaque équipe."; style: small; color: muted; maxLines: 2 }
          if amCur.eval != null {
            Compare { label: "Score probable"; pv: amCur.best ?? "—"; rv: amGF + "–" + amGA; good: (amCur.best ?? "") == (amGF + "-" + amGA); c: amCViolet }
            Compare { label: "Issue"; pv: amCur.h >= amCur.d && amCur.h >= amCur.a ? "1" : amCur.a >= amCur.d ? "2" : "N"; rv: amGF > amGA ? "1" : amGA > amGF ? "2" : "N"; good: amCur.eval.hit; c: amCCyan }
            Text { text: "Prédiction : Brier " + replace(fixed(amCur.eval.brier, 3), ".", ",") + (amCur.eval.marketBrier == null ? "" : " · marché " + replace(fixed(amCur.eval.marketBrier, 3), ".", ",")) + " · " + (amCur.eval.hit ? "issue juste" : "issue manquée") + "."; style: label; color: muted; maxLines: 2 }
          }
        }
      }
      Spacer { height: 12 }
    }
  }
}
}else if detailMode=="pre"{
Column {
  scroll: true
  padding: [12, 0]
  gap: 12
  background: linear(0, 0, 0.55, 1, [alpha(pmHColor, 0.24), "#070b12", "#060a11", alpha(pmAColor, 0.18), "#04070c"])
  if hero == null { Text { text: "Aucun match à préparer."; style: muted } }
  else {
    Row { gap: 6; align: center
      Row { gap: 5; align: center; weight: 1; padding: [5, 3]; radius: 8; background: alpha(foreground, 0.035); border: 1; borderColor: alpha(foreground, 0.06)
        Box { size: 6; radius: 3; background: ageTxt == "" ? muted : pmCGood }
        Text { text: handoff != null ? "calendrier · " + (handoff.tag ?? "") : curMatch != null && curMatch.ts != null ? "données " + ageTxt : "aucune donnée live"; style: label; color: muted; maxLines: 1 }
      }
      Text { text: "← retour"; style: label; bold: true; color: pmCAmber; padding: [6, 3]; radius: 8; background: alpha(pmCAmber, 0.12); border: 1; borderColor: alpha(pmCAmber, 0.22); onTap: { handoff = null; detailMode = "" } }
      Text { text: "actualiser"; style: label; bold: true; color: pmCCyan; padding: [6, 3]; radius: 8; background: alpha(pmCCyan, 0.12); border: 1; borderColor: alpha(pmCCyan, 0.22); onTap: run("owl-send 20-my-matches.owl refresh") }
      Text { text: "copier"; style: label; bold: true; color: pmCViolet; padding: [6, 3]; radius: 8; background: alpha(pmCViolet, 0.12); border: 1; borderColor: alpha(pmCViolet, 0.22); onTap: copy(hName + " – " + aName + " · " + fmtTime(hero.at, "EEE d/MM HH:mm") + " · " + league) }
      Text { text: "⚙"; fontSize: 16; color: pmCCyan; padding: [6, 3]; radius: 8; background: alpha(pmCCyan, 0.12); border: 1; borderColor: alpha(pmCCyan, 0.22); onTap: { settingsOpen = true; screen() } }
    }
    Box { fill: width; padding: 8; radius: 18; background: linear(0, 0, 1, 1, [alpha(pmHColor, 0.34), alpha(background, 0.30), alpha(pmAColor, 0.34)]); border: 1; borderColor: alpha(mix(pmHColor, pmAColor, 0.5), 0.30)
      Column { gap: 4
        Row { gap: 6; align: center
          Text { text: upper(hero.tag ?? "match"); style: label; fontSize: 9; bold: true; color: pmCCyan; padding: [3, 5]; radius: 6; background: alpha(pmCCyan, 0.12); maxLines: 1 }
          Text { text: "AVANT-MATCH"; style: label; fontSize: 9; bold: true; color: muted; letterSpacing: 1.6; weight: 1; maxLines: 1 }
          Text { text: "#" + (pmHRow == null ? "—" : pmHRow.rank) + " · #" + (pmARow == null ? "—" : pmARow.rank); style: label; fontSize: 9; color: muted; maxLines: 1 }
        }
        Row { gap: 0; align: center
          Box { weight: 1; padding: 10; radius: 12; background: radial(0.5, 0.4, 0.9, [alpha(pmHColor, 0.26), alpha(pmHColor, 0.04)]); border: 1; borderColor: alpha(pmHColor, 0.28) PmBadge { logo: hLogo; name: hName; color: pmHColor; textColor: pmHText } }
          Column { width: 145; align: center; gap: 3
            Box { padding: [3, 10]; radius: 9; background: linear(0, 0, 1, 0, [alpha(pmCCyan, 0.20), alpha(pmCViolet, 0.20)]); border: 1; borderColor: alpha(pmCCyan, 0.28) Text { text: "VS"; style: label; bold: true; color: pmCCyan; align: center; letterSpacing: 2 } }
            Text { text: fmtTime(hero.at, "HH:mm"); style: title; color: foreground; align: center; fontSize: 26; bold: true }
            Text { text: fmtTime(hero.at, "d MMM"); style: small; color: pmCAmber; align: center }
            Text { text: stateLine; style: label; color: hero != null && hero.state == "in" ? pmCGood : muted; align: center; maxLines: 2 }
          }
          Box { weight: 1; padding: 10; radius: 12; background: radial(0.5, 0.4, 0.9, [alpha(pmAColor, 0.26), alpha(pmAColor, 0.04)]); border: 1; borderColor: alpha(pmAColor, 0.28) PmBadge { logo: aLogo; name: aName; color: pmAColor; textColor: pmAText } }
        }
      }
    }
    Row { gap: 8
      Column { weight: 1; gap: 3 Text { text: hFormLabel; style: label; color: mix(pmHColor, foreground, 0.4); bold: true; maxLines: 1 } Chips { form: hForm } }
      Column { weight: 1; gap: 3; align: end Text { text: aFormLabel; style: label; color: mix(pmAColor, foreground, 0.4); bold: true; maxLines: 1 } Chips { form: aForm } }
    }
    if pmVerdict != "" {
      Row { gap: 7; align: center; padding: [6, 8]; radius: 10; background: linear(0, 0, 1, 0, [alpha(pmVerdictColor, 0.22), alpha(pmVerdictColor, 0.04)]); border: 1; borderColor: alpha(pmVerdictColor, 0.32)
        Box { size: 7; radius: 3.5; background: pmVerdictColor }
        Text { text: "Forme à l'avantage de " + pmVerdict; style: small; bold: true; color: mix(pmVerdictColor, foreground, 0.20); weight: 1; maxLines: 1 }
        Text { text: "5 derniers"; style: label; fontSize: 9; color: muted; maxLines: 1 }
      }
    }
    Row { gap: 8; align: center; padding: [0, 2]
      Text { text: "V"; style: label; bold: true; color: pmCGood; padding: [1, 4]; radius: 4; background: alpha(pmCGood, 0.14) }
      Text { text: "gagné"; style: label; color: muted; maxLines: 1 }
      Text { text: "N"; style: label; bold: true; color: pmCWarn; padding: [1, 4]; radius: 4; background: alpha(pmCWarn, 0.14) }
      Text { text: "nul"; style: label; color: muted; maxLines: 1 }
      Text { text: "D"; style: label; bold: true; color: pmCBad; padding: [1, 4]; radius: 4; background: alpha(pmCBad, 0.14) }
      Text { text: "perdu"; style: label; color: muted; maxLines: 1 }
    }
    Box {
      fill: width
      radius: 14 * corners
      border: 1
      borderColor: alpha(accent, 0.28)
      background: linear(0, 0, 1, 0, [alpha(accent, 0.12), alpha(surface, 0.45)])
      padding: [10, 12]
      Column {
        gap: 5
        Row { gap: 6; align: center
          Box { width: 3; height: 14; radius: 2; background: accent }
          Text { text: "À RETENIR"; style: label; fontWeight: 800; letterSpacing: 1.2; color: accent; weight: 1; maxLines: 1 }
          Text { text: "4 points clés"; style: label; color: muted; maxLines: 1 }
        }
        Row { gap: 6; align: top
          Box { width: 5; height: 5; radius: 3; background: pmCLime }
          Text { text: "Forme : " + (hPts > aPts ? hName : aPts > hPts ? aName : "les deux équipes") + " mène aux points sur 5 matchs · " + (hGF + aGF) + " buts cumulés."; style: small; color: foreground; weight: 1; maxLines: 2 }
        }
        Row { gap: 6; align: top
          Box { width: 5; height: 5; radius: 3; background: pmCViolet }
          Text { text: fdxh == null || fdxa == null ? "xG : données en cours de synchronisation." : ((fdxh.proxy ?? false) || (fdxa.proxy ?? false) ? "Buts : " : "xG : ") + hName + " " + replace(fixed(fdxh.xg5, 2), ".", ",") + " · " + aName + " " + replace(fixed(fdxa.xg5, 2), ".", ",") + "."; style: small; color: foreground; weight: 1; maxLines: 2 }
        }
        Row { gap: 6; align: top
          Box { width: 5; height: 5; radius: 3; background: pmCAmber }
          Text { text: "Classement : " + hName + " #" + (pmHRow == null ? "—" : pmHRow.rank) + " (" + hPPG + " pts/match) · " + aName + " #" + (pmARow == null ? "—" : pmARow.rank) + " (" + aPPG + ")."; style: small; color: foreground; weight: 1; maxLines: 2 }
        }
        Row { gap: 6; align: top
          Box { width: 5; height: 5; radius: 3; background: pmCSky }
          Text { text: pmNoVig == null ? "Marché : pas de cotes disponibles." : "Marché : " + (pmNoVig.h >= pmNoVig.d && pmNoVig.h >= pmNoVig.a ? hName : pmNoVig.a >= pmNoVig.d ? aName : "match nul") + " favori à " + max(pmNoVig.h, pmNoVig.d, pmNoVig.a) + "%."; style: small; color: foreground; weight: 1; maxLines: 2 }
        }
      }
    }

    Section { c: pmCViolet; t: "Lecture du match"; sub: "synthèse automatique du rapport de force" }
              Column { gap: 5; padding: 10; radius: 9; background: linear(0, 0, 1, 0, [alpha(pmCViolet, 0.18), alpha(pmCViolet, 0.04)]); border: 1; borderColor: alpha(pmCViolet, 0.30)
                Row { gap: 5; align: center
                  Box { width: 3; height: 12; radius: 1.5; background: pmCViolet }
                  Text { text: "SYNTHÈSE · LE FILM DU MATCH"; style: label; bold: true; color: pmCViolet; letterSpacing: 0.8; weight: 1; maxLines: 1 }
                  if synWords > 0 { Text { text: synWords + " mots"; style: label; color: muted; maxLines: 1 } }
                }
                if synStatus == "running" {
                  Row { gap: 6; align: center
                    Canvas { width: 18; height: 18; arc(9, 9, 7, time * 300, 260, stroke: pmCViolet, width: 3, cap: round) }
                    Text { text: "Génération en cours…"; style: label; bold: true; color: pmCViolet; weight: 1; maxLines: 1 }
                    if synWords > 0 { Text { text: synWords + " mots"; style: label; color: muted; maxLines: 1 } }
                  }
                  if synText != "" {
                    Text { text: synText + " ▌"; style: small; color: foreground; maxLines: 80 }
                  } else {
                    Text { text: "Connexion au modèle local…"; style: small; color: muted; maxLines: 2 }
                  }
                } else if synText != "" {
                  let synParas = split(synText, "\n\n")
                  if synOpen {
                    for i in range(count(synParas)) {
                      Text { text: synParas[i]; style: small; color: foreground; maxLines: 20 }
                    }
                  } else {
                    Text { text: first(synParas) ?? synText; style: small; color: foreground; maxLines: 6 }
                  }
                  Row { gap: 6; align: center
                    Text { text: synOpen ? "réduire" : "lire la suite"; style: label; bold: true; color: pmCViolet; padding: [4, 2]; radius: 6; background: alpha(pmCViolet, 0.10); border: 1; borderColor: alpha(pmCViolet, 0.22); onTap: synOpen = synOpen ? false : true }
                    Text { text: (synSource == "draft" || synSource == "draft-only" ? "brouillon factuel" : synSource == "ai+draft" ? "qwen local + brouillon" : "qwen local"); style: label; color: muted; weight: 1; maxLines: 1 }
                    Text { text: "relancer"; style: label; color: pmCViolet; padding: [4, 2]; radius: 6; background: alpha(pmCViolet, 0.10); border: 1; borderColor: alpha(pmCViolet, 0.22); onTap: run("python3 ~/.config/omalauncher/widgets/prematch-synthesis.py ensure " + sh(hero.id ?? "") + " --force >/dev/null 2>&1") }
                  }
                } else {
                  Text { text: "La synthèse se prépare. Elle croise toutes les analyses de graphiques et sera écrite par le modèle local."; style: small; color: muted; maxLines: 4 }
                  Text { text: "Générer maintenant"; style: label; bold: true; color: pmCViolet; padding: [6, 3]; radius: 8; background: alpha(pmCViolet, 0.14); border: 1; borderColor: alpha(pmCViolet, 0.28); onTap: run("python3 ~/.config/omalauncher/widgets/prematch-synthesis.py ensure " + sh(hero.id ?? "") + " >/dev/null 2>&1") }
                }
              }
    Chapter { id: "overview"; n: "1"; t: "Vue d’ensemble"; sub: "forme récente, contexte et calendrier"; c: accent }
    if indexOf(openChapters, "overview") >= 0 {
      Column { gap: 10
        AmSectionTitle { t: "Tendances"; c: pmCCyan; sub: "5 derniers matchs · ▲ = l'équipe devant sur le critère" }
        PmDuel { label: "Points (5)"; hv: hPts; av: aPts; hc: pmHColor; ac: pmAColor; hint: "plus = mieux"; better: "high" }
        PmDuel { label: "Buts"; hv: hGF; av: aGF; hc: pmHColor; ac: pmAColor; hint: "plus = mieux"; better: "high" }
        PmDuel { label: "Sans encaisser"; hv: hClean; av: aClean; hc: pmHColor; ac: pmAColor; hint: "plus = mieux"; better: "high" }
        PmDuel { label: "Les 2 marquent"; hv: hBtts; av: aBtts; hc: pmHColor; ac: pmAColor; hint: "plus = match ouvert"; better: "high" }
        PmDuel { label: "Plus de 2,5 buts"; hv: hOver; av: aOver; hc: pmHColor; ac: pmAColor; hint: "plus = spectaculaire"; better: "high" }
        Row { gap: 4; padding: [7, 8]; radius: 9; background: alpha(pmCLime, 0.08); border: 1; borderColor: alpha(pmCLime, 0.18)
          Text { text: "LECTURE"; style: label; fontSize: 9; bold: true; color: pmCLime; letterSpacing: 1; maxLines: 1 }
          Text { text: (hPts > aPts ? hName : aPts > hPts ? aName : "les deux équipes") + " mène aux points · " + (hGF + aGF) + " buts cumulés sur la période."; style: label; color: mix(foreground, pmCLime, 0.18); weight: 1; maxLines: 2 }
        }
        if fdxh != null && fdxa != null {
          let fdProxy = (fdxh.proxy ?? false) || (fdxa.proxy ?? false)
          AmSectionTitle { t: fdProxy ? "Buts et tirs" : "Qualité des chances"; c: pmCViolet; sub: fdProxy ? ((fdxh.shots ?? 0) > 0 || (fdxa.shots ?? 0) > 0 ? "xG indisponible · lecture sur les buts et les tirs" : "xG indisponible pour cette sélection · lecture sur les buts") : "xG = occasions créées · xGA = occasions concédées · xPts = points mérités" }
          PmDuel { label: fdProxy ? "Buts (5)" : "xG (5)"; hv: fdxh.xg5; av: fdxa.xg5; hc: pmHColor; ac: pmAColor; hint: fdProxy ? "plus = marque plus" : "plus = crée plus"; better: "high" }
          PmDuel { label: fdProxy ? "Encaissés (5)" : "xGA (5)"; hv: fdxh.xga5; av: fdxa.xga5; hc: pmHColor; ac: pmAColor; hint: fdProxy ? "plus = encaisse plus" : "plus = concède plus"; better: "low" }
          if fdProxy && ((fdxh.shots ?? 0) > 0 || (fdxa.shots ?? 0) > 0) {
            PmDuel { label: "Tirs / match"; hv: fdxh.shots; av: fdxa.shots; hc: pmHColor; ac: pmAColor; hint: "plus = volume"; better: "high" }
            PmDuel { label: "Cadrage %"; hv: fdxh.sotPct; av: fdxa.sotPct; hc: pmHColor; ac: pmAColor; hint: "plus = précis"; better: "high" }
          }
          if !fdProxy {
            PmDuel { label: "xPts (5)"; hv: fdxh.xpts5; av: fdxa.xpts5; hc: pmHColor; ac: pmAColor; hint: "plus = mérite plus"; better: "high" }
            Row { gap: 6; align: center
              Text { text: "Finition"; style: label; bold: true; color: pmCAmber; padding: [3, 5]; radius: 5; background: alpha(pmCAmber, 0.12); maxLines: 1 }
              Text { text: hName + " " + (fdxh.fin5 > 0 ? "+" : "") + replace(fixed(fdxh.fin5, 2), ".", ",") + " · " + aName + " " + (fdxa.fin5 > 0 ? "+" : "") + replace(fixed(fdxa.fin5, 2), ".", ",") + " buts vs xG"; style: label; color: muted; weight: 1; maxLines: 2 }
            }
          }
          Text { text: (fdProxy ? (((fdxh.shots ?? 0) > 0 || (fdxa.shots ?? 0) > 0) ? "Buts et tirs · " : "Buts · ") : "xG · ") + (fdxh.src ?? (fdhA == null ? "Football-Data.co.uk" : "Understat")) + " · " + min(fdxh.n, 5) + " matchs · " + (fdProxy ? "xG indisponible, aucune donnée inventée" : "au-dessus de 0 = finition au-dessus de l'attendu"); style: label; color: muted; align: center; maxLines: 2 }
        }
        AmSectionTitle { t: "Contexte"; c: pmCAmber; sub: "classement et rythme de points dans le championnat" }
        Row { gap: 6
          Column { weight: 1; gap: 2; padding: 9; radius: 10; background: linear(0, 0, 1, 1, [alpha(pmHColor, 0.24), alpha(background, 0.30)]); border: 1; borderColor: alpha(pmHColor, 0.30)
            Row { gap: 5; align: center
              if hLogo != "" { Image { src: "~/.cache/espn-logos/banner/" + hLogo; size: 20; fit: contain; label: hName } }
              Text { text: hName; style: small; color: pmHText; bold: true; weight: 1; maxLines: 1 }
              Text { text: "#" + (pmHRow == null ? "—" : pmHRow.rank); style: label; bold: true; color: pmHColor; padding: [2, 5]; radius: 5; background: alpha(pmHColor, 0.16); maxLines: 1 }
            }
            Text { text: hPPG + " pts/match"; style: small; bold: true; color: mix(pmHColor, foreground, 0.25); maxLines: 1 }
            Text { text: hGF + " buts marqués · " + hGA + " encaissés"; style: label; color: muted; maxLines: 1 }
          }
          Column { weight: 1; gap: 2; padding: 9; radius: 10; background: linear(0, 0, 1, 1, [alpha(pmAColor, 0.24), alpha(background, 0.30)]); border: 1; borderColor: alpha(pmAColor, 0.30)
            Row { gap: 5; align: center
              if aLogo != "" { Image { src: "~/.cache/espn-logos/banner/" + aLogo; size: 20; fit: contain; label: aName } }
              Text { text: aName; style: small; color: pmAText; bold: true; weight: 1; maxLines: 1 }
              Text { text: "#" + (pmARow == null ? "—" : pmARow.rank); style: label; bold: true; color: pmAColor; padding: [2, 5]; radius: 5; background: alpha(pmAColor, 0.16); maxLines: 1 }
            }
            Text { text: aPPG + " pts/match"; style: small; bold: true; color: mix(pmAColor, foreground, 0.25); maxLines: 1 }
            Text { text: aGF + " buts marqués · " + aGA + " encaissés"; style: label; color: muted; maxLines: 1 }
          }
        }
        AmSectionTitle { t: "5 prochains"; c: cTeal; sub: "touche un match pour ouvrir son avant-match · du plus proche au plus lointain" }
        Row { gap: 8
          Column { weight: 1; gap: 2
            Row { gap: 4; align: center
              Box { width: 3; height: 11; radius: 1.5; background: pmHColor }
              Text { text: hName; style: label; bold: true; color: pmHText; maxLines: 1 }
            }
            if count(hNext) == 0 { Text { text: "aucun prochain match"; style: label; color: muted } } else { for g in hNext key g.id { Fixture { g: g; team: pmHAbbr } } }
          }
          Column { weight: 1; gap: 2
            Row { gap: 4; align: center
              Box { width: 3; height: 11; radius: 1.5; background: pmAColor }
              Text { text: aName; style: label; bold: true; color: pmAText; maxLines: 1 }
            }
            if count(aNext) == 0 { Text { text: "aucun prochain match"; style: label; color: muted } } else { for g in aNext key g.id { Fixture { g: g; team: pmAAbbr } } }
          }
        }
      }
    }
    Chapter { id: "stats"; n: "2"; t: "Chiffres et repères"; sub: "statistiques agrégées des deux équipes"; c: cyan }
    if indexOf(openChapters, "stats") >= 0 {
      Column { gap: 10
        AmSectionTitle { t: "Domicile / extérieur"; c: pmCSky; sub: "le rythme et les buts de chaque équipe selon le lieu" }
        Row { gap: 6
          VenueSplit { weight: 1; name: hName; color: pmHColor; hPts: hHomePts; aPts: hAwayPts; hGF: hHomeGF; hGA: hHomeGA; aGF: hAwayGF; aGA: hAwayGA; hN: count(hHome); aN: count(hAway) }
          VenueSplit { weight: 1; name: aName; color: pmAColor; hPts: aHomePts; aPts: aAwayPts; hGF: aHomeGF; hGA: aHomeGA; aGF: aAwayGF; aGA: aAwayGA; hN: count(aHome); aN: count(aAway) }
        }
        AmSectionTitle { t: "Confrontations"; c: pmCViolet; sub: "bilans des face-à-face : chaque segment porte la couleur de son équipe" }
        if h2h == null { Text { text: "Pas de confrontations disponibles."; style: small; color: muted } }
        else {
          Column { gap: 4
            PmStack { hv: h2h.w; dv: h2h.d; av: h2h.l; hc: pmHColor; ac: pmAColor }
            Row { gap: 8; align: center
              Text { text: pmHAbbr + " " + h2h.w; style: label; bold: true; color: pmHText; maxLines: 1 }
              Text { text: "nuls " + h2h.d; style: label; color: pmCWarn; weight: 1; align: center; maxLines: 1 }
              Text { text: h2h.l + " " + pmAAbbr; style: label; bold: true; color: pmAText; maxLines: 1 }
            }
            Text { text: h2hGoals + " buts · " + replace(h2hAvg, ".", ",") + " / match"; style: small; color: muted; maxLines: 1 }
            for x in h2hList key x.d + x.hs {
              Row { gap: 6; align: center
                Text { text: x.d; style: label; color: muted; width: 70; maxLines: 1 }
                Text { text: x.hs + "–" + x.a; style: label; bold: true; color: x.w ? pmCGood : pmCWarn; maxLines: 1 }
                Text { text: x.w ? "victoire" : "non gagné"; style: label; color: x.w ? pmCGood : muted; weight: 1; align: end; maxLines: 1 }
              }
            }
          }
        }
      }
    }
    Chapter { id: "analysis"; n: "3"; t: "Analyses détaillées"; sub: "probabilités, trajectoire, style, chances et plan de jeu"; c: magenta }
    if indexOf(openChapters, "analysis") >= 0 {
      Column { gap: 10
        if fdhA == null || fdaA == null {
          Section { c: pmCCyan; t: "Analyse avancée" }
          Text { text: "Les séries xG arrivent avec la prochaine synchronisation."; style: small; color: muted; maxLines: 2 }
          Text { text: "Lance actualiser dans quelques secondes."; style: label; color: muted; maxLines: 1 }
        } else {
          Row { gap: 4
            Box { weight: 1; padding: [8, 3]; radius: 14; align: center; background: anView == "resume" ? alpha(pmCViolet, 0.24) : alpha(foreground, 0.04); border: 1; borderColor: anView == "resume" ? alpha(pmCViolet, 0.50) : alpha(foreground, 0.08); onTap: anView = "resume"
              Text { text: "Proba"; style: label; fontSize: 11; bold: anView == "resume"; color: anView == "resume" ? foreground : muted; align: center; maxLines: 1 }
            }
            Box { weight: 1; padding: [8, 3]; radius: 14; align: center; background: anView == "forme" ? alpha(pmCSky, 0.24) : alpha(foreground, 0.04); border: 1; borderColor: anView == "forme" ? alpha(pmCSky, 0.50) : alpha(foreground, 0.08); onTap: anView = "forme"
              Text { text: "Forme"; style: label; fontSize: 11; bold: anView == "forme"; color: anView == "forme" ? foreground : muted; align: center; maxLines: 1 }
            }
            Box { weight: 1; padding: [8, 3]; radius: 14; align: center; background: anView == "style" ? alpha(cTeal, 0.24) : alpha(foreground, 0.04); border: 1; borderColor: anView == "style" ? alpha(cTeal, 0.50) : alpha(foreground, 0.08); onTap: anView = "style"
              Text { text: "Style"; style: label; fontSize: 11; bold: anView == "style"; color: anView == "style" ? foreground : muted; align: center; maxLines: 1 }
            }
            Box { weight: 1; padding: [8, 3]; radius: 14; align: center; background: anView == "chances" ? alpha(pmCViolet, 0.24) : alpha(foreground, 0.04); border: 1; borderColor: anView == "chances" ? alpha(pmCViolet, 0.50) : alpha(foreground, 0.08); onTap: anView = "chances"
              Text { text: "Chances"; style: label; fontSize: 11; bold: anView == "chances"; color: anView == "chances" ? foreground : muted; align: center; maxLines: 1 }
            }
            Box { weight: 1; padding: [8, 3]; radius: 14; align: center; background: anView == "plus" ? alpha(pmCPink, 0.24) : alpha(foreground, 0.04); border: 1; borderColor: anView == "plus" ? alpha(pmCPink, 0.50) : alpha(foreground, 0.08); onTap: anView = "plus"
              Text { text: "Plan"; style: label; fontSize: 11; bold: anView == "plus"; color: anView == "plus" ? foreground : muted; align: center; maxLines: 1 }
            }
          }
          if anView == "resume" {
            Column { gap: 8
              AmSectionTitle { t: "Synthèse et probabilités"; c: pmCViolet; sub: "le film du match, les issues et les scénarios" }
              Row { gap: 6
                Column { weight: 1; gap: 2; padding: 8; radius: 8; background: linear(0, 0, 1, 1, [alpha(pmHColor, 0.24), alpha(background, 0.30)]); border: 1; borderColor: alpha(pmHColor, 0.24)
                  Row { gap: 5; align: center
                    if hLogo != "" { Image { src: "~/.cache/espn-logos/banner/" + hLogo; size: 24; fit: contain; label: hName } }
