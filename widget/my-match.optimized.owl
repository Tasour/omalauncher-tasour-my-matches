let agoP=lang=="fr"?"il y a ":""
let agoS=lang=="fr"?"":" ago"
let cW=lang=="fr"?"V":"W"
let cL=lang=="fr"?"D":"L"
let cN=lang=="fr"?"N":"D"
let ENZ={"prelim. C1":"UCL prelim.","C1":"UCL","8es":"R16","CONF":"UECL","C3":"UEL","quarts":"QF","barr. montee":"promotion PO","montee":"promotion","barr. CDM":"WC playoff","CDM":"World Cup","barrages":"playoffs","barr. releg.":"relegation PO","relegation":"relegation","elimine":"eliminated"}
state team="ALL"persist
state myTeams=[]persist
state draft=[]
state query=""
state showTeams=false
state secClosed=[]persist
state spinning=false
state spinUntil=0
state spinAt=0
state elapsed=0
state lastDur=-1 persist
state lastOk=null
state lastAt=0 persist
state uiSize="M"persist
state showSettings=false
state spoiler=false persist
state hcMode=false persist
state pauseUntil=0 persist
state rivalsCsv="" persist
state muteTeams=[] persist
state teamColors=true persist
state lowData=false persist
state importRaw=""
state importOk=false
state leadH=12 persist
state quietOn=false persist
state digestOn=false persist
state digestAt=0 persist
state weeklyOn=false persist
state matchdayMode=false
state compactMode=false
state todayOnly=false
state daySel=""
state showOdds=true persist
state showForm=true persist
state cbMode=false persist
state revealed=[]persist
state prewarmOn=false persist
state prewarmAt=0 persist
state showDetail=false
state previewTab="overview"
state uiSchema=0 persist
state clearAsk=false
state diagDone=false
state h12Id=""persist
state h12At=0 persist
state kickId=""persist
state kickAt=0 persist
state nextDone=[]persist
state kickDone=[]persist
state view="MINE"persist
state topLg="ALL"persist
state euroLg="uefa.europa"persist
state selJ=-1
