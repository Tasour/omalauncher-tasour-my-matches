      | map(select((($wlid | length) > 0 and ([(.tids // [])[] | IN($wlid[])] | any)) or (($wln | length) > 0 and ([(.squads // [])[] | IN($wln[])] | any)) or ((($wlid | length) == 0 and ($wln | length) == 0) and ([(.squads // [])[] | IN($wl[])] | any))))
